@code {
    private List<Payroll> Payrolls = new();
    private List<Employee> Employees = new();
    private List<PayrollAdjustmentRule> AllAdjustmentRules = new();
    private List<SelectableRule> SelectedBonusRules = new();
    private List<SelectableRule> SelectedDeductionRules = new();
    private Payroll CurrentPayroll = new();
    public int WorkDays { get; set; } = 22;

    private DateTime? SelectedStartDate { get; set; }
    private DateTime? SelectedEndDate { get; set; }

    private bool UseManualAbsences = false;

    private async Task PrintPreview()
    {
        var payload = new
        {
            Payroll = CurrentPayroll,
            Employee = CurrentPayroll.Employee,
            Bonuses = SelectedBonusRules,
            Deductions = SelectedDeductionRules,
            Absences = EmployeeAbsences
        };

        var json = JsonSerializer.Serialize(payload);
        await JS.InvokeVoidAsync("sessionStorage.setItem", "payroll-print-data", json);
        await JS.InvokeVoidAsync("open", "/print-payroll", "_blank");
    }

    private void OnBaseSalaryChanged(decimal value, int workDays)
    {
        if (CurrentPayroll == null) return;

        CurrentPayroll.BaseSalary = value;

        // Calculate deduction per absence day based on working days in the payroll period
        var actualWorkDays = CurrentPayroll.PayrollStartDate.HasValue && CurrentPayroll.PayrollEndDate.HasValue
            ? CalculateWorkingDays(CurrentPayroll.PayrollStartDate.Value, CurrentPayroll.PayrollEndDate.Value)
            : workDays;

        CurrentPayroll.DeductionPerAbsenceDay = Math.Round(value / actualWorkDays, 2);
    }

    private Task OnManualAbsenceDaysChanged(int value)
    {
        CurrentPayroll.ManualAbsenceDays = value;
        RecalculateBonusesAndDeductions();
        return Task.CompletedTask;
    }

    // New method to handle payroll period changes
    private async Task OnPayrollPeriodChanged()
    {
        if (CurrentPayroll.PayrollStartDate.HasValue && CurrentPayroll.PayrollEndDate.HasValue)
        {
            // Recalculate deduction per absence day based on new period
            if (CurrentPayroll.BaseSalary > 0)
            {
                var workingDays = CalculateWorkingDays(CurrentPayroll.PayrollStartDate.Value, CurrentPayroll.PayrollEndDate.Value);
                CurrentPayroll.DeductionPerAbsenceDay = Math.Round(CurrentPayroll.BaseSalary / workingDays, 2);
            }

            // Refresh absences for the new period
            if (CurrentPayroll.EmployeeId > 0)
            {
                await RefreshAbsencesForPeriod();
            }
        }

        StateHasChanged();
    }

    // New method to handle predefined period selection
    private async Task OnPredefinedPeriodChanged(ChangeEventArgs e)
    {
        var selectedPeriod = e.Value?.ToString();
        var today = DateTime.Today;

        switch (selectedPeriod)
        {
            case "current_month":
                CurrentPayroll.PayrollStartDate = new DateTime(today.Year, today.Month, 1);
                CurrentPayroll.PayrollEndDate = CurrentPayroll.PayrollStartDate.Value.AddMonths(1).AddDays(-1);
                break;

            case "previous_month":
                var firstDayPrevMonth = new DateTime(today.Year, today.Month, 1).AddMonths(-1);
                CurrentPayroll.PayrollStartDate = firstDayPrevMonth;
                CurrentPayroll.PayrollEndDate = firstDayPrevMonth.AddMonths(1).AddDays(-1);
                break;

            case "last_30_days":
                CurrentPayroll.PayrollEndDate = today;
                CurrentPayroll.PayrollStartDate = today.AddDays(-29);
                break;

            case "current_quarter":
                var quarter = (today.Month - 1) / 3 + 1;
                CurrentPayroll.PayrollStartDate = new DateTime(today.Year, (quarter - 1) * 3 + 1, 1);
                CurrentPayroll.PayrollEndDate = CurrentPayroll.PayrollStartDate.Value.AddMonths(3).AddDays(-1);
                break;

            case "custom":
                // Keep current values or reset to null for custom selection
                break;

            default:
                return;
        }

        if (selectedPeriod != "custom")
        {
            await OnPayrollPeriodChanged();
        }
    }

    // New method to refresh absences for the selected period
    private async Task RefreshAbsencesForPeriod()
    {
        if (CurrentPayroll.PayrollStartDate.HasValue &&
            CurrentPayroll.PayrollEndDate.HasValue &&
            CurrentPayroll.EmployeeId > 0)
        {
            await LoadAbsenceDates(CurrentPayroll.EmployeeId,
                                 CurrentPayroll.PayrollStartDate.Value,
                                 CurrentPayroll.PayrollEndDate.Value);
            RecalculateBonusesAndDeductions();
            StateHasChanged();
        }
    }

    // New method to calculate working days (excluding weekends)
    private int CalculateWorkingDays(DateTime startDate, DateTime endDate)
    {
        int workingDays = 0;
        for (var date = startDate; date <= endDate; date = date.AddDays(1))
        {
            if (date.DayOfWeek != DayOfWeek.Friday && date.DayOfWeek != DayOfWeek.Saturday)
            {
                workingDays++;
            }
        }
        return workingDays;
    }

    private void OnBonusRuleChanged(SelectableRule rule, bool isApplied)
    {
        Console.WriteLine($"OnBonusRuleChanged: Rule '{rule.Name}', IsApplied changed from {rule.IsApplied} to {isApplied}");
        rule.IsApplied = isApplied;

        if (isApplied && rule.IsCountable)
        {
            OnCountableQuantityChanged(rule, rule.Quantity > 0 ? rule.Quantity : 1);
        }
        else
        {
            RecalculateBonusesAndDeductions();
        }
        Console.WriteLine($"After update: Rule '{rule.Name}', IsApplied: {rule.IsApplied}");
    }

    private void OnDeductionRuleChanged(SelectableRule rule, bool isApplied)
    {
        Console.WriteLine($"OnDeductionRuleChanged: Rule '{rule.Name}', IsApplied changed from {rule.IsApplied} to {isApplied}");
        rule.IsApplied = isApplied;

        if (isApplied && rule.IsCountable)
        {
            OnCountableQuantityChanged(rule, rule.Quantity > 0 ? rule.Quantity : 1);
        }
        else
        {
            RecalculateBonusesAndDeductions();
        }
        Console.WriteLine($"After update: Rule '{rule.Name}', IsApplied: {rule.IsApplied}");
    }

    private void OnCountedChanged(AbsenceRecord record, bool val)
    {
        record.Counted = val;
        RecalculateBonusesAndDeductions();
    }

    private async Task LoadAbsenceDates(int employeeId, DateTime startDate, DateTime endDate)
    {
        EmployeeAbsences = await AbsenceService.GetUncountedAbsencesAsync(employeeId, startDate, endDate);
    }

    private async Task LoadPayrollAbsences(int Id)
    {
        EmployeeAbsences = await AbsenceService.GetcountedAbsences(Id);
    }

    private EventCallback<bool> GetCountedChangedCallback(AbsenceRecord record)
    {
        return EventCallback.Factory.Create<bool>(this, val => OnCountedChanged(record, val));
    }

    private Task OnDeductionChanged(decimal val)
    {
        CurrentPayroll.DeductionPerAbsenceDay = val;
        RecalculateBonusesAndDeductions();
        return Task.CompletedTask;
    }

    private async Task ReloadAbsences()
    {
        if (SelectedStartDate != null && SelectedEndDate != null && CurrentPayroll?.EmployeeId != 0)
        {
            await LoadAbsenceDates(CurrentPayroll.EmployeeId, SelectedStartDate.Value, SelectedEndDate.Value);
            StateHasChanged();
        }
    }

    private void RecalculateBonusesAndDeductions()
    {
        Console.WriteLine("--- Recalculating Bonuses and Deductions ---");

        // Calculate Bonuses
        CurrentPayroll.Bonus = SelectedBonusRules
            .Where(r => r.IsApplied)
            .Sum(r =>
            {
                decimal calculatedValue;
                if (r.IsCountable && r.Quantity > 0)
                {
                    calculatedValue = r.CalculatedAmount;
                }
                else if (r.IsPercentage)
                {
                    calculatedValue = CurrentPayroll.BaseSalary * r.Amount / 100;
                }
                else
                {
                    calculatedValue = r.Amount;
                }
                Console.WriteLine($"  Bonus Rule: {r.Name}, Applied: {r.IsApplied}, Amount: {r.Amount}, IsPercentage: {r.IsPercentage}, IsCountable: {r.IsCountable}, Quantity: {r.Quantity}, CalculatedValue: {calculatedValue}");
                return calculatedValue;
            });
        Console.WriteLine($"Total Bonus: {CurrentPayroll.Bonus}");

        // Calculate Absences Deduction
        var absenceDays = UseManualAbsences ? CurrentPayroll.ManualAbsenceDays : EmployeeAbsences.Count(a => a.Counted);
        var absenceDeduction = absenceDays * CurrentPayroll.DeductionPerAbsenceDay;
        Console.WriteLine($"Absence Days: {absenceDays}, Deduction Per Day: {CurrentPayroll.DeductionPerAbsenceDay}, Absence Deduction: {absenceDeduction}");

        // Calculate Rule-Based Deductions
        var ruleBasedDeductions = SelectedDeductionRules
            .Where(r => r.IsApplied)
            .Sum(r =>
            {
                decimal calculatedValue;
                if (r.IsCountable && r.Quantity > 0)
                {
                    calculatedValue = r.CalculatedAmount;
                }
                else if (r.IsPercentage)
                {
                    calculatedValue = CurrentPayroll.BaseSalary * r.Amount / 100;
                }
                else
                {
                    calculatedValue = r.Amount;
                }
                Console.WriteLine($"  Deduction Rule: {r.Name}, Applied: {r.IsApplied}, Amount: {r.Amount}, IsPercentage: {r.IsPercentage}, IsCountable: {r.IsCountable}, Quantity: {r.Quantity}, CalculatedValue: {calculatedValue}");
                return calculatedValue;
            });
        Console.WriteLine($"Total Rule-Based Deductions: {ruleBasedDeductions}");

        CurrentPayroll.Deductions = ruleBasedDeductions + absenceDeduction;
        Console.WriteLine($"Total Deductions (Rules + Absences): {CurrentPayroll.Deductions}");

        var netPay = CurrentPayroll.BaseSalary + CurrentPayroll.Bonus - CurrentPayroll.Deductions;
        Console.WriteLine($"Calculated Net Pay: {netPay}");

        StateHasChanged();
        Console.WriteLine("--- Recalculation Complete, StateHasChanged called ---");
    }

    private int CurrentEmployeeId
    {
        get => CurrentPayroll.EmployeeId;
        set
        {
            if (CurrentPayroll.EmployeeId != value)
            {
                CurrentPayroll.EmployeeId = value;
                InvokeAsync(async () => await OnEmployeeChanged(value));
            }
        }
    }

    private List<AbsenceRecord> EmployeeAbsences = new();

