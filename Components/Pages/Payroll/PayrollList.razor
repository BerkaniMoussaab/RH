@page "/payrolls"
@inject CompanyInfoService CompanyService
@using Microsoft.AspNetCore.Authorization
@using RH.Models
@using RH.Services
@using System.Text.Json
@using static PayrollService

@inject IPayrollService PayrollService
@inject IEmployeeService EmployeeService
@inject PayrollAdjustmentRuleService AdjustmentService
@inject AbsenceService AbsenceService
@inject WorkedDaysOffService WorkedDaysOffService
@inject IAdvanceService AdvanceService
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>Fiches de paie</PageTitle>
<div class="bg-light p-3 mb-4 rounded shadow-sm">
    <div class="bg-light p-3 mb-4 rounded shadow-sm">
        <div class="row g-3 align-items-end">
            <!-- Existing Date Filters -->
            <div class="col-md-2">
                <label for="startDate" class="form-label fw-semibold">Date début</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-calendar-date"></i></span>
                    <input id="startDate" class="form-control" type="date" @bind="FilterStartDate" />
                </div>
            </div>

            <div class="col-md-2">
                <label for="endDate" class="form-label fw-semibold">Date fin</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-calendar-check"></i></span>
                    <input id="endDate" class="form-control" type="date" @bind="FilterEndDate" />
                </div>
            </div>

            <!-- New Employee Filter -->
            <div class="col-md-3">
                <label for="employeeFilter" class="form-label fw-semibold">Employé</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <select id="employeeFilter" class="form-select" @bind="SelectedEmployeeId">
                        <option value="0">Tous les employés</option>
                        @foreach (var employee in Employees.OrderBy(e => e.FullName))
                        {
                            <option value="@employee.Id">@employee.FullName</option>
                        }
                    </select>
                </div>
            </div>

            <div class="col-md-2 d-grid">
                <button class="btn btn-primary" @onclick="ApplyFilter">
                    <i class="bi bi-funnel-fill me-1"></i> Appliquer
                </button>
            </div>

            <div class="col-md-2 d-grid">
                <button class="btn btn-outline-secondary" @onclick="ClearFilter">
                    <i class="bi bi-x-circle me-1"></i> Réinitialiser
                </button>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white rounded shadow-sm">
    <h2 class="text-primary fw-bold mb-0">
        <i class="bi bi-cash-coin me-2"></i> Fiches de paie
    </h2>
    <button class="btn btn-success px-4" @onclick="async () => await AddPayroll()">
        <i class="bi bi-plus-circle me-2"></i> Nouvelle fiche
    </button>
</div>

@if (Payrolls is null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">Chargement...</span>
        </div>
        <p class="mt-3 text-muted">Chargement des fiches de paie...</p>
    </div>
}
else if (!Payrolls.Any())
{
    <div class="alert alert-info text-center">
        <i class="bi bi-info-circle me-2"></i> Aucune fiche de paie disponible.
    </div>
}
else
{
    <div class="table-responsive shadow-sm">
        <table class="table table-striped table-hover align-middle bg-white rounded">
            <thead class="table-light text-center">
                <tr>
                    <th>Code</th>
                    <th>Employé</th>
                    <th>Période de paie</th>
                    <th>Date de paiement</th>
                    <th>Salaire de base</th>
                    <th>Primes</th>
                    <th>Retenues</th>
                    <th>Avances</th>
                    <th>Net à payer</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payroll in Payrolls)
                {
                    <tr>
                        <td class="text-center fw-semibold">#@payroll.Id</td>
                        <td>@payroll.Employee?.FullName</td>
                        <td class="text-center">
                            @if (payroll.PayrollStartDate.HasValue && payroll.PayrollEndDate.HasValue)
                            {
                                <span class="badge bg-info">
                                    @payroll.PayrollStartDate.Value.ToString("dd/MM") - @payroll.PayrollEndDate.Value.ToString("dd/MM/yyyy")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Non définie</span>
                            }
                        </td>
                        <td class="text-center">@payroll.PayDate.ToString("dd/MM/yyyy")</td>
                        <!-- Changed from Employee.BaseSalary to payroll.BaseSalary -->
                        <td class="text-end">@payroll.BaseSalary.ToString("N2") DA</td>
                        <td class="text-end text-success">
                            <span class="fw-semibold">+@payroll.Bonus.ToString("N2") DA</span>
                        </td>
                        <td class="text-end text-danger">
                            <span class="fw-semibold">-@payroll.Deductions.ToString("N2") DA</span>
                        </td>
                        <td class="text-end text-warning">
                            <span class="fw-semibold">-@payroll.AdvanceDeductionsAmounts.ToString("N2") DA</span>
                        </td>
                        <td class="text-end fw-bold text-primary">@payroll.NetPay.ToString("N2") DA</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-secondary me-1" title="Modifier"
                                    @onclick="() => EditPayroll(payroll)">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <div class="position-relative d-inline-block">
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        @onclick="() => ToggleDropdown(payroll.Id)">
                                    <i class="bi bi-trash3"></i>
                                </button>

                                @if (openedDropdownId == payroll.Id)
                                {
                                    <ul class="dropdown-menu show end-0 mt-1 shadow"
                                        style="position: absolute; min-width: 220px; z-index: 1055;">
                                        <li>
                                            <button class="dropdown-item text-danger fw-semibold"
                                                    @onclick="() => ConfirmDelete(payroll.Id, true)">
                                                Supprimer avec règles appliquées
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item"
                                                    @onclick="() => ConfirmDelete(payroll.Id, false)">
                                                Supprimer sans règles appliquées
                                            </button>
                                        </li>
                                    </ul>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (IsModalOpen)
{
    <EditForm Model="CurrentPayroll" OnValidSubmit="SavePayroll">
        <DataAnnotationsValidator />
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content rounded-4 shadow border-primary enhanced-modal">

                    <!-- Enhanced Header -->
                    <div class="modal-header bg-primary text-white enhanced-header">
                        <div class="d-flex align-items-center">
                            <div>
                                <h5 class="modal-title mb-1 fw-bold">
                                    <i class="bi bi-cash-coin me-2"></i>
                                    @((CurrentPayroll.Id == 0)
                                                                    ? "Ajouter une fiche de paie"
                                                                    : $"Modifier la fiche de paie (ID: {CurrentPayroll.Id})")
                            </h5>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white enhanced-close-btn" @onclick="CloseModal"></button>
                </div>

                    <div class="modal-body enhanced-body">
                        <div class="row g-3">
                            <!-- Section Informations Employé et Période -->
                            <div class="col-12">
                                <div class="info-section">
                                    <div class="section-title">
                                        <i class="bi bi-person-badge text-primary me-2"></i>
                                        <span>Informations de l'employé et période de paie</span>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <div class="enhanced-form-group">
                                                <label class="form-label fw-semibold">
                                                    <i class="bi bi-person me-1"></i>Employé
                                                </label>
                                                <InputSelect class="form-select enhanced-select" @bind-Value="CurrentEmployeeId">
                                                    <option value="">-- Sélectionner un employé --</option>
                                                @foreach (var emp in Employees)
                                                    {
                                                        <option value="@emp.Id">@emp.FullName</option>
                                                    }
                                                </InputSelect>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="enhanced-form-group">
                                                <label class="form-label fw-semibold">
                                                    <i class="bi bi-calendar-event me-1"></i>Date de paiement
                                                </label>
                                                <InputDate class="form-control enhanced-input" @bind-Value="CurrentPayroll.PayDate" />
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Enhanced Date Interval Selection Section -->
                                    <div class="row g-3 mt-2">
                                        <div class="col-12">
                                            <div class="payroll-period-section">
                                                <div class="section-subtitle">
                                                    <i class="bi bi-calendar-range text-info me-2"></i>
                                                    <span>Période de paie</span>
                                                    <small class="text-muted ms-2">(Définit la période pour le calcul des absences et primes)</small>
                                                </div>

                                                <div class="row g-3 mt-2">
                                                    <div class="col-md-3">
                                                        <div class="enhanced-form-group">
                                                            <label class="form-label fw-semibold">
                                                                <i class="bi bi-calendar-check me-1"></i>Date de début
                                                            </label>
                                                            <InputDate class="form-control enhanced-input"
                                                                       @bind-Value="CurrentPayroll.PayrollStartDate"
                                                                       @onchange="OnPayrollPeriodChanged" />
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <div class="enhanced-form-group">
                                                            <label class="form-label fw-semibold">
                                                                <i class="bi bi-calendar-x me-1"></i>Date de fin
                                                            </label>
                                                            <InputDate class="form-control enhanced-input"
                                                                       @bind-Value="CurrentPayroll.PayrollEndDate"
                                                                       @onchange="OnPayrollPeriodChanged" />
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <div class="enhanced-form-group">
                                                            <label class="form-label fw-semibold">Période prédéfinie</label>
                                                            <select class="form-select enhanced-select" @onchange="OnPredefinedPeriodChanged">
                                                                <option value="">-- Sélectionner --</option>
                                                                <option value="current_month">Mois en cours</option>
                                                                <option value="previous_month">Mois précédent</option>
                                                                <option value="last_30_days">30 derniers jours</option>
                                                                <option value="current_quarter">Trimestre en cours</option>
                                                                <option value="custom">Personnalisé</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3 ">
                                                        <label class="form-label fw-semibold"> </label>
                                                        <button type="button" class="btn btn-outline-info w-100"
                                                                @onclick="RefreshAbsencesForPeriod"
                                                                disabled="@(!CurrentPayroll.PayrollStartDate.HasValue || !CurrentPayroll.PayrollEndDate.HasValue || CurrentPayroll.EmployeeId == 0)">
                                                            <i class="bi bi-arrow-clockwise me-1"></i>
                                                            Actualiser les absences
                                                        </button>
                                                    </div>
                                                </div>

                                                @if (CurrentPayroll.PayrollStartDate.HasValue && CurrentPayroll.PayrollEndDate.HasValue)
                                                {
                                                    <div class="period-summary mt-3 p-3 bg-light rounded">
                                                        <div class="row">
                                                            <div class="col-md-4">
                                                                <strong>Période sélectionnée:</strong><br>
                                                                <span class="text-primary">
                                                                    @CurrentPayroll.PayrollStartDate.Value.ToString("dd/MM/yyyy")
                                                                    au
                                                                    @CurrentPayroll.PayrollEndDate.Value.ToString("dd/MM/yyyy")
                                                                </span>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <strong>Durée:</strong><br>
                                                                <span class="text-info">
                                                                    @((CurrentPayroll.PayrollEndDate.Value - CurrentPayroll.PayrollStartDate.Value).Days + 1) jours
                                                                </span>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <strong>Jours ouvrables:</strong><br>
                                                                <span class="text-success">
                                                                    @CalculateWorkingDays(CurrentPayroll.PayrollStartDate.Value, CurrentPayroll.PayrollEndDate.Value) jours
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 💰 Salaire & Retenue Section -->
                            <div class="col-md-6">
                                <div class="card shadow-sm border-0 mb-3">
                                    <div class="card-body py-2">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h6 class="mb-0 text-primary"><i class="bi bi-cash-coin me-2"></i>Salaire & Retenue</h6>
                                            @if (CurrentPayroll.Id > 0 && CurrentPayroll.BaseSalary != CurrentPayroll.Employee?.BaseSalary)
                                            {
                                                <span class="badge bg-info" title="Salaire historique - ne modifie pas le salaire actuel de l'employé">
                                                    <i class="bi bi-clock-history me-1"></i>Historique
                                                </span>
                                            }
                                        </div>

                                        <div class="row g-2">
                                            <div class="col-6">
                                                <label class="form-label mb-1">
                                                    Salaire de base
                                                    @if (CurrentPayroll.Id > 0 && CurrentPayroll.BaseSalary != CurrentPayroll.Employee?.BaseSalary)
                                                    {
                                                        <span class="text-muted small ms-1">
                                                            (vs. actuel: @CurrentPayroll.Employee?.BaseSalary.ToString("N2") DA)
                                                        </span>
                                                    }
                                                </label>
                                                <InputNumber TValue="decimal" class="form-control form-control-sm"
                                                             Value="CurrentPayroll.BaseSalary"
                                                             ValueChanged="@(value => OnBaseSalaryChanged(value, workDaysPerMonth))"
                                                             ValueExpression="@(() => CurrentPayroll.BaseSalary)" />

                                                @if (CurrentPayroll.Id > 0 && CurrentPayroll.BaseSalary != CurrentPayroll.Employee?.BaseSalary)
                                                {
                                                    <small class="text-info">
                                                        <i class="bi bi-info-circle me-1"></i>
                                                        Ceci est le salaire historique payé à l'époque
                                                    </small>
                                                }
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label mb-1 d-flex align-items-center">
                                                    Retenue / jour
                                                    <i class="bi bi-info-circle ms-1 text-muted"
                                                       title="Calculé automatiquement à partir du salaire de base et du nombre de jours ouvrables."></i>
                                                </label>
                                                <InputNumber TValue="decimal" class="form-control form-control-sm"
                                                             Value="CurrentPayroll.DeductionPerAbsenceDay"
                                                             ValueExpression="@(() => CurrentPayroll.DeductionPerAbsenceDay)"
                                                             Disabled />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 📅 Absence Section -->
                            <div class="col-md-6">
                                <div class="card shadow-sm border-0 mb-3">
                                    <div class="card-body py-2">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h6 class="mb-0 text-danger"><i class="bi bi-calendar-x me-2"></i>Absences</h6>

                                            <!-- Switch mode -->
                                            <div class="form-check form-switch d-flex align-items-center">
                                                <input class="form-check-input" type="checkbox"
                                                       @onchange="OnAbsenceModeChanged"
                                                       checked="@UseManualAbsences" />
                                                <label class="form-check-label ms-2 small text-muted">
                                                    @if (UseManualAbsences)
                                                    {
                                                        <text>Manuel</text>
                                                    }
                                                    else
                                                    {
                                                        <text>Automatique</text>
                                                    }
                                                </label>
                                            </div>
                                        </div>

                                        @if (UseManualAbsences || CurrentPayroll.ManualAbsenceDays != 0)
                                        {
                                            <div class="mb-2">
                                                <label class="form-label small">Jours d'absence (manuel)</label>
                                                <InputNumber TValue="int" class="form-control form-control-sm"
                                                             Value="CurrentPayroll.ManualAbsenceDays"
                                                             ValueChanged="OnManualAbsenceDaysChanged"
                                                             ValueExpression="@(() => CurrentPayroll.ManualAbsenceDays)" />
                                            </div>
                                        }

                                        <!-- 🧾 Absence List -->
                                        @if (EmployeeAbsences.Any())
                                        {
                                            <div class="table-responsive" style="max-height: 160px;">
                                                <table class="table table-sm table-bordered align-middle mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th style="width: 25%;">Date</th>
                                                            <th>Motif</th>
                                                            <th style="width: 90px;" class="text-center">Comptée</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var a in EmployeeAbsences)
                                                        {
                                                            <tr class="@(a.Counted ? "table-warning" : "")">
                                                                <td>@a.Date.ToString("dd/MM/yyyy")</td>
                                                                <td>
                                                                    <InputText class="form-control form-control-sm border-0"
                                                                               @bind-Value="a.Reason"
                                                                               Disabled />
                                                                </td>
                                                                <td class="text-center">
                                                                    <InputCheckbox class="form-check-input"
                                                                                   Value="a.Counted"
                                                                                   ValueChanged="GetCountedChangedCallback(a)"
                                                                                   ValueExpression="@(() => a.Counted)" />
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-muted small mt-2">
                                                <i class="bi bi-calendar-check me-1"></i>
                                                @if (CurrentPayroll.PayrollStartDate.HasValue && CurrentPayroll.PayrollEndDate.HasValue)
                                                {
                                                    <text>Aucune absence enregistrée pour cette période.</text>
                                                }
                                                else
                                                {
                                                    <text>Définissez une période de paie pour voir les absences.</text>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- UPDATED SECTION: Advance Payments with correct property name -->
                            <div class="col-12">
                                <div class="advance-section">
                                    <div class="section-title">
                                        <i class="bi bi-credit-card-2-front text-warning me-2"></i>
                                        <span>Avances sur salaire</span>
                                        <span class="badge bg-warning ms-auto">-@CurrentAdvanceDeductionSummary.ProposedDeduction.ToString("N2") DA</span>
                                    </div>

                                    @if (CurrentAdvanceDeductionSummary.HasActiveAdvances)
                                    {
                                        <div class="advance-summary-card mb-3 p-3 bg-light rounded">
                                            <div class="row">
                                                <div class="col-md-3">
                                                    <strong>Avances actives:</strong><br>
                                                    <span class="text-info">@CurrentAdvanceDeductionSummary.ActiveAdvances.Count</span>
                                                </div>
                                                <div class="col-md-3">
                                                    <strong>Montant total:</strong><br>
                                                    <span class="text-warning">@CurrentAdvanceDeductionSummary.TotalActiveAmount.ToString("N2") DA</span>
                                                </div>
                                                <div class="col-md-3">
                                                    <strong>Déduction max autorisée:</strong><br>
                                                    <span class="text-success">@CurrentAdvanceDeductionSummary.MaximumDeductionAllowed.ToString("N2") DA</span>
                                                </div>
                                                <div class="col-md-3">
                                                    <strong>Déduction proposée:</strong><br>
                                                    <span class="text-primary fw-bold">@CurrentAdvanceDeductionSummary.ProposedDeduction.ToString("N2") DA</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="advance-details-wrapper">
                                            <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                                                <table class="table table-bordered table-sm enhanced-table">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Date</th>
                                                            <th>Montant initial</th>
                                                            <th>Montant restant</th>
                                                            <th>Motif</th>
                                                            <th>Statut</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var advance in CurrentAdvanceDeductionSummary.ActiveAdvances.OrderBy(a => a.Date))
                                                        {
                                                            <tr>
                                                                <td class="fw-medium">@advance.Date.ToString("dd/MM/yyyy")</td>
                                                                <td class="text-end">@advance.Amount.ToString("N2") DA</td>
                                                                <td class="text-end text-warning fw-semibold">@advance.RemainingAmount.ToString("N2") DA</td>
                                                                <td>@(advance.Reason ?? "Non spécifié")</td>
                                                                <td>
                                                                    <span class="badge bg-success">@advance.Status</span>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>

                                        @if (!CurrentAdvanceDeductionSummary.CanDeductFully)
                                        {
                                            <div class="alert alert-warning mt-3">
                                                <i class="bi bi-exclamation-triangle me-2"></i>
                                                <strong>Attention:</strong> Le montant total des avances (@CurrentAdvanceDeductionSummary.TotalActiveAmount.ToString("N2") DA)
                                                dépasse la déduction maximale autorisée (@CurrentAdvanceDeductionSummary.MaximumDeductionAllowed.ToString("N2") DA).
                                                Seuls @CurrentAdvanceDeductionSummary.ProposedDeduction.ToString("N2") DA seront déduits ce mois-ci.
                                            </div>
                                        }

                                        <div class="enhanced-form-group mt-3">
                                            <label class="form-label fw-semibold">
                                                <i class="bi bi-cash-stack me-1"></i>Montant de déduction des avances
                                            </label>
                                            <InputNumber @bind-Value="CurrentPayroll.AdvanceDeductionsAmounts"
                                                         class="form-control"
                                                         step="0.01"
                                                         Min="0"
                                                         max="@CurrentAdvanceDeductionSummary.ActiveAdvances.Sum(a => a.RemainingAmount)"
                                                         @oninput="MarkAdvanceAsManuallySet" />

                                            <small class="text-muted">
                                                Maximum autorisé: @CurrentAdvanceDeductionSummary.MaximumDeductionAllowed.ToString("N2") DA
                                            </small>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="empty-state">
                                            <i class="bi bi-credit-card-2-front text-muted"></i>
                                            <span class="text-muted">Aucune avance active pour cet employé.</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            @if (PreappliedBonusRules.Any() || PreappliedDeductionRules.Any())
                            {
                                <div class="col-12">
                                    <div class="preapplied-rules-section">
                                        <div class="section-title">
                                            <i class="bi bi-bookmark-star text-info me-2"></i>
                                            <span>Règles pré-appliquées</span>
                                            <small class="text-muted ms-2">(Règles appliquées par défaut pour cet employé)</small>
                                        </div>

                                        <div class="row g-3">
                                            @if (PreappliedBonusRules.Any())
                                            {
                                                <div class="col-md-6">
                                                    <div class="preapplied-bonus-section">
                                                        <div class="subsection-title">
                                                            <i class="bi bi-plus-circle text-success me-2"></i>
                                                            <span>Primes pré-appliquées</span>
                                                            <span class="badge bg-success ms-auto">+@PreappliedBonusRules.Where(r => r.IsApplied).Sum(r => r.CalculatedAmount).ToString("N2") DA</span>
                                                        </div>

                                                        <div class="preapplied-rules-container">
                                                            @foreach (var rule in PreappliedBonusRules)
                                                            {
                                                                <div class="preapplied-rule-item @(rule.IsApplied ? "active" : "")">
                                                                    <div class="d-flex flex-column">
                                                                        <div class="d-flex align-items-center justify-content-between">
