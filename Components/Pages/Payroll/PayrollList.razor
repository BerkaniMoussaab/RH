    // IMPROVED SelectableRule class with better instance management
    public class SelectableRule
    {
        public Guid Id { get; set; } = Guid.NewGuid(); // Unique identifier for this UI instance
        public int? PayrollAppliedRuleId { get; set; } // Corresponds to PayrollAppliedRule.Id in DB
        public int RuleId { get; set; }
        public string Name { get; set; }
        public decimal Amount { get; set; }
        public bool IsPercentage { get; set; }
        public bool IsCountable { get; set; }
        public bool IsApplied { get; set; } = true;
        public decimal Quantity { get; set; } = 1;
        public bool IsEditable { get; set; } = false;
        public decimal CalculatedAmount { get; set; }
        public int WorkDays { get; set; }
        public RuleTrigger Trigger { get; set; } = RuleTrigger.Manual;
        public bool AutoApplied { get; set; }
        public int InstanceNumber { get; set; } = 1; // NEW: For display purposes

        /// <summary>
        /// Constructor for applied rule (from DB) with optional fallback base salary.
        /// </summary>
        public SelectableRule(PayrollAppliedRule appliedRule, int workDaysPerMonth, decimal? lastPayrollBaseSalary = null)
        {
            PayrollAppliedRuleId = appliedRule.Id;
            RuleId = appliedRule.RuleId;
            Name = appliedRule.Rule.Name;
            Amount = appliedRule.Amount;
            IsPercentage = appliedRule.Rule.IsPercentage;
            IsCountable = appliedRule.Rule.IsCountable;
            AutoApplied = appliedRule.Rule.AutoApplied;
            IsApplied = true;
            IsEditable = appliedRule.Rule.IsEditable;
            Quantity = appliedRule.Quantity ?? 1;
            Trigger = appliedRule.Rule.Trigger;
            WorkDays = workDaysPerMonth;

            decimal baseSalary = appliedRule.Payroll?.BaseSalary ?? lastPayrollBaseSalary ?? 0;

            CalculatedAmount = IsCountable
                ? (IsPercentage ? baseSalary * Amount / 100 : Amount) * Quantity
                : (IsPercentage ? baseSalary * Amount / 100 : Amount);
        }

        /// <summary>
        /// Constructor for default rules (not yet applied, or new instance).
        /// </summary>
        public SelectableRule(PayrollAdjustmentRule rule, int workDaysPerMonth, bool isApplied = false)
        {
            RuleId = rule.Id;
            Name = rule.Name;
            Amount = rule.Amount;
            IsPercentage = rule.IsPercentage;
            IsCountable = rule.IsCountable;
            IsEditable = rule.IsEditable;
            IsApplied = isApplied;
            Quantity = 1;
            WorkDays = workDaysPerMonth;
            Trigger = rule.Trigger;
            AutoApplied = rule.AutoApplied;

            CalculatedAmount = IsCountable
                ? Amount * Quantity
                : Amount;
        }
    }

