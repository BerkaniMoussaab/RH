@code {
    // State variables
    private int? openedDropdownId = null;
    private bool IsPrintModalOpen = false;
    private bool IsModalOpen = false;
    private bool UseManualAbsences = false;
    private bool _isAdvanceAmountManuallySet = false;
    private int? SelectedEmployeeId { get; set; } = null;
    private DateTime? FilterStartDate { get; set; } = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-1);
    private DateTime? FilterEndDate { get; set; } = DateTime.Today;
    private DateTime? SelectedStartDate { get; set; }
    private DateTime? SelectedEndDate { get; set; }

    private List<Payroll> Payrolls = new();
    private List<Employee> Employees = new();
    private List<PayrollAdjustmentRule> AllAdjustmentRules = new();
    private List<SelectableRule> SelectedBonusRules = new();
    private List<SelectableRule> SelectedDeductionRules = new();
    private List<SelectableRule> PreappliedBonusRules = new();
    private List<SelectableRule> PreappliedDeductionRules = new();
    public decimal PreappliedBonuses { get; set; }

    private Payroll CurrentPayroll = new();
    public int workDaysPerMonth;

    private PayrollService.AdvanceDeductionSummary CurrentAdvanceDeductionSummary = new();
    private List<AbsenceRecord> EmployeeAbsences = new();

    protected override async Task OnInitializedAsync()
    {
        Employees = await EmployeeService.GetAllAsync();
        AllAdjustmentRules = await AdjustmentService.GetAllAsync();

        var company = await CompanyService.GetAsync();
        workDaysPerMonth = company.WorKdaysInMonth;

        if (CurrentPayroll.ManualAbsenceDays != 0)
        {
            UseManualAbsences = true;
        }

        await LoadPayrolls();
    }

    private void ToggleDropdown(int payrollId)
    {
        if (openedDropdownId == payrollId)
            openedDropdownId = null;
        else
            openedDropdownId = payrollId;
    }

    private async Task ConfirmDelete(int payrollId, bool deleteAppliedRules)
    {
        openedDropdownId = null;
        await PayrollService.DeleteAsync(payrollId, deleteAppliedRules);
        await LoadPayrolls();
        StateHasChanged();
    }

    private async Task PrintPage()
    {
        await JSRuntime.InvokeVoidAsync("printDiv", "printable-area");
    }

    private async Task ShowPrintModal()
    {
        await RefreshAdvanceDeductionSummary();
        IsPrintModalOpen = true;
        StateHasChanged();
    }

    void ClosePrintModal()
    {
        IsPrintModalOpen = false;
        StateHasChanged();
    }

    // ⭐ UPDATED: Now uses CurrentPayroll.BaseSalary instead of Employee.BaseSalary
    private void OnBaseSalaryChanged(decimal value, int workDays)
    {
        if (CurrentPayroll == null) return;

        Console.WriteLine($"=== OnBaseSalaryChanged ===");
        Console.WriteLine($"Old Payroll.BaseSalary: {CurrentPayroll.BaseSalary}");
        Console.WriteLine($"New value: {value}");
        Console.WriteLine($"Employee.BaseSalary before: {CurrentPayroll.Employee?.BaseSalary}");

        // ⭐ ONLY update the payroll's base salary, NOT the employee's
        CurrentPayroll.BaseSalary = value;

        Console.WriteLine($"Payroll.BaseSalary after: {CurrentPayroll.BaseSalary}");
        Console.WriteLine($"Employee.BaseSalary after: {CurrentPayroll.Employee?.BaseSalary} (unchanged)");

        // Calculate deduction per absence day based on working days
        var actualWorkDays = workDays;
        CurrentPayroll.DeductionPerAbsenceDay = Math.Round(value / actualWorkDays, 2);

        Console.WriteLine($"DeductionPerAbsenceDay: {CurrentPayroll.DeductionPerAbsenceDay} (based on {actualWorkDays} work days)");

        // Recalculate all dependent values
        InvokeAsync(async () =>
        {
            await RefreshAdvanceDeductionSummary();
            RecalculateBonusesAndDeductions();
        });

        // Also recalculate now for immediate UI update
        RecalculateBonusesAndDeductions();
    }

    private void ValidateAdvanceAmount()
    {
        var max = CurrentAdvanceDeductionSummary.MaximumDeductionAllowed;
        if (CurrentPayroll.AdvanceDeductionsAmounts > max)
        {
            CurrentPayroll.AdvanceDeductionsAmounts = max;
        }
        _isAdvanceAmountManuallySet = true;
        RecalculateBonusesAndDeductions();
    }

    private Task OnManualAbsenceDaysChanged(int value)
    {
        CurrentPayroll.ManualAbsenceDays = value;
        RecalculateBonusesAndDeductions();
        return Task.CompletedTask;
    }

    private void MarkAdvanceAsManuallySet(ChangeEventArgs e)
    {
        _isAdvanceAmountManuallySet = true;

        if (decimal.TryParse(e.Value?.ToString(), out var value))
        {
            var maxAllowed = CurrentAdvanceDeductionSummary.MaximumDeductionAllowed;

            if (value > maxAllowed)
                CurrentPayroll.AdvanceDeductionsAmounts = maxAllowed;
            else if (value < 0)
                CurrentPayroll.AdvanceDeductionsAmounts = 0;
            else
                CurrentPayroll.AdvanceDeductionsAmounts = value;
        }
    }

    private async Task RefreshAdvanceDeductionSummary()
    {
        if (CurrentPayroll.EmployeeId > 0)
        {
            // ⭐ UPDATED: Use CurrentPayroll.BaseSalary instead of Employee.BaseSalary
            var preliminaryNetPay = CurrentPayroll.BaseSalary + CurrentPayroll.Bonus - CurrentPayroll.Deductions;
            CurrentAdvanceDeductionSummary = await PayrollService.GetAdvanceDeductionSummaryAsync(CurrentPayroll.EmployeeId, preliminaryNetPay);

            if (!_isAdvanceAmountManuallySet || CurrentPayroll.Id == 0)
            {
                CurrentPayroll.AdvanceDeductionsAmounts = CurrentAdvanceDeductionSummary.ProposedDeduction;
                CurrentAdvanceDeductionSummary.MaximumDeductionAllowed = CurrentAdvanceDeductionSummary.ProposedDeduction;
            }
            else
            {
                if (CurrentPayroll.AdvanceDeductionsAmounts > CurrentAdvanceDeductionSummary.MaximumDeductionAllowed)
                {
                    CurrentPayroll.AdvanceDeductionsAmounts = CurrentAdvanceDeductionSummary.MaximumDeductionAllowed;
                }
                CurrentAdvanceDeductionSummary.MaximumDeductionAllowed = CurrentAdvanceDeductionSummary.ProposedDeduction;
            }
            StateHasChanged();
        }
    }

    private async Task OnPayrollPeriodChanged()
    {
        if (CurrentPayroll.PayrollStartDate.HasValue && CurrentPayroll.PayrollEndDate.HasValue)
        {
            // ⭐ UPDATED: Use CurrentPayroll.BaseSalary instead of Employee.BaseSalary
            if (CurrentPayroll.BaseSalary > 0)
            {
                CurrentPayroll.DeductionPerAbsenceDay = Math.Round(CurrentPayroll.BaseSalary / workDaysPerMonth, 2);
            }

            // Refresh absences for the new period
            if (CurrentPayroll.EmployeeId > 0)
            {
                await RefreshAbsencesForPeriod();
            }
        }

        StateHasChanged();
    }

    private async Task OnPredefinedPeriodChanged(ChangeEventArgs e)
    {
        var selectedPeriod = e.Value?.ToString();
        var today = DateTime.Today;

        switch (selectedPeriod)
        {
            case "current_month":
                CurrentPayroll.PayrollStartDate = new DateTime(today.Year, today.Month, 1);
                CurrentPayroll.PayrollEndDate = CurrentPayroll.PayrollStartDate.Value.AddMonths(1).AddDays(-1);
                break;

            case "previous_month":
                var firstDayPrevMonth = new DateTime(today.Year, today.Month, 1).AddMonths(-1);
                CurrentPayroll.PayrollStartDate = firstDayPrevMonth;
                CurrentPayroll.PayrollEndDate = firstDayPrevMonth.AddMonths(1).AddDays(-1);
                break;

            case "last_30_days":
                CurrentPayroll.PayrollEndDate = today;
                CurrentPayroll.PayrollStartDate = today.AddDays(-29);
                break;

            case "current_quarter":
                var quarter = (today.Month - 1) / 3 + 1;
                CurrentPayroll.PayrollStartDate = new DateTime(today.Year, (quarter - 1) * 3 + 1, 1);
                CurrentPayroll.PayrollEndDate = CurrentPayroll.PayrollStartDate.Value.AddMonths(3).AddDays(-1);
                break;

            case "custom":
                break;

            default:
                return;
        }

        if (selectedPeriod != "custom")
        {
            await OnPayrollPeriodChanged();
        }
    }

    private async Task RefreshAbsencesForPeriod()
    {
        if (CurrentPayroll.PayrollStartDate.HasValue &&
            CurrentPayroll.PayrollEndDate.HasValue &&
            CurrentPayroll.EmployeeId > 0)
        {
            await LoadAbsenceDates(CurrentPayroll.EmployeeId,
                                 CurrentPayroll.PayrollStartDate.Value,
                                 CurrentPayroll.PayrollEndDate.Value);
            RecalculateBonusesAndDeductions();
            StateHasChanged();
        }
    }

    private int CalculateWorkingDays(DateTime startDate, DateTime endDate)
    {
        int workingDays = 0;
        for (var date = startDate; date <= endDate; date = date.AddDays(1))
        {
            if (date.DayOfWeek != DayOfWeek.Friday && date.DayOfWeek != DayOfWeek.Saturday)
            {
                workingDays++;
            }
        }
        return workingDays;
    }

