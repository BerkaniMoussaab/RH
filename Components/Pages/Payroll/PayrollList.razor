    private void OnPreappliedBonusRuleChanged(SelectableRule rule, bool isApplied)
    {
        rule.IsApplied = isApplied;
        if (isApplied && rule.IsCountable)
        {
            OnPreappliedQuantityChanged(rule, rule.Quantity > 0 ? rule.Quantity : 1);
        }
        else
        {
            RecalculateBonusesAndDeductions();
        }
    }

    private void OnPreappliedDeductionRuleChanged(SelectableRule rule, bool isApplied)
    {
        rule.IsApplied = isApplied;
        if (isApplied && rule.IsCountable)
        {
            OnPreappliedQuantityChanged(rule, rule.Quantity > 0 ? rule.Quantity : 1);
        }
        else
        {
            RecalculateBonusesAndDeductions();
        }
    }

    private void OnPreappliedAmountChanged(SelectableRule rule, decimal? newAmount)
    {
        rule.Amount = newAmount ?? 0;
        if (!rule.IsCountable)
        {
            rule.Quantity = 1;
        }
        OnPreappliedQuantityChanged(rule, rule.Quantity);
    }

    private void OnPreappliedQuantityChanged(SelectableRule rule, decimal? quantity)
    {
        var finalQuantity = quantity ?? 1;
        rule.Quantity = finalQuantity;

        // ⭐ UPDATED: Use CurrentPayroll.BaseSalary instead of Employee.BaseSalary
        if (rule.IsCountable)
        {
            var unitAmount = rule.IsPercentage ? CurrentPayroll.BaseSalary * rule.Amount / 100 : rule.Amount;
            rule.CalculatedAmount = unitAmount * finalQuantity;
        }
        else
        {
            rule.CalculatedAmount = rule.IsPercentage ? CurrentPayroll.BaseSalary * rule.Amount / 100 : rule.Amount;
        }

        RecalculateBonusesAndDeductions();
    }

