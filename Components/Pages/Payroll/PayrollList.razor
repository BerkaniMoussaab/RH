    // ⭐ UPDATED: OnEmployeeChanged now handles new vs existing payrolls differently
    private async Task OnEmployeeChanged(int employeeId)
    {
        Console.WriteLine($"=== OnEmployeeChanged: employeeId={employeeId} ===");

        SelectedBonusRules.Clear();
        SelectedDeductionRules.Clear();
        PreappliedBonusRules.Clear();
        PreappliedDeductionRules.Clear();

        CurrentAdvanceDeductionSummary = new AdvanceDeductionSummary();
        _isAdvanceAmountManuallySet = false;

        var employee = Employees.FirstOrDefault(e => e.Id == employeeId);
        if (employee == null)
        {
            Console.WriteLine($"Employee {employeeId} not found");
            return;
        }

        CurrentPayroll.EmployeeId = employeeId;
        CurrentPayroll.Employee = employee;

        var lastPayroll = await PayrollService.GetLastPayrollForEmployeeAsync(employeeId);

        // ⭐ CRITICAL LOGIC: Different for new vs existing payrolls
        if (CurrentPayroll.Id == 0)
        {
            // New payroll: Start with employee's current salary
            CurrentPayroll.BaseSalary = employee.BaseSalary;
            Console.WriteLine($"NEW payroll: Setting BaseSalary to employee's current salary: {CurrentPayroll.BaseSalary}");
        }
        else
        {
            // Existing payroll: KEEP the historical BaseSalary
            Console.WriteLine($"EXISTING payroll #{CurrentPayroll.Id}: Keeping historical BaseSalary: {CurrentPayroll.BaseSalary}");

            if (CurrentPayroll.BaseSalary != employee.BaseSalary)
            {
                Console.WriteLine($"WARNING: Historical payroll salary ({CurrentPayroll.BaseSalary}) differs from current employee salary ({employee.BaseSalary})");
            }
        }

        CurrentPayroll.Transaction = lastPayroll?.Transaction ?? 0;

        await LoadPreappliedRules(employeeId);

        if (employee.JobTitleId is int jobTitleId)
        {
            var applicableBonusRules = AllAdjustmentRules
                .Where(r => r.Type == AdjustmentType.Bonus && r.JobTitles.Any(j => j.Id == jobTitleId));

            var applicableDeductionRules = AllAdjustmentRules
                .Where(r => r.Type == AdjustmentType.Deduction && r.JobTitles.Any(j => j.Id == jobTitleId));

            // Pass CurrentPayroll.BaseSalary to SelectableRule constructors
            SelectedBonusRules = applicableBonusRules
                .Select(rule => new SelectableRule(rule, workDaysPerMonth, rule.AutoApplied, CurrentPayroll.BaseSalary))
                .ToList();

            SelectedDeductionRules = applicableDeductionRules
                .Select(rule => new SelectableRule(rule, workDaysPerMonth, rule.AutoApplied, CurrentPayroll.BaseSalary))
                .ToList();
        }

        // Calculate deduction per absence day using CurrentPayroll.BaseSalary
        if (CurrentPayroll.BaseSalary != 0)
        {
            CurrentPayroll.DeductionPerAbsenceDay = Math.Round(CurrentPayroll.BaseSalary / workDaysPerMonth, 2);
        }

        if (CurrentPayroll.PayrollStartDate.HasValue && CurrentPayroll.PayrollEndDate.HasValue)
        {
            await LoadAbsenceDates(employeeId, CurrentPayroll.PayrollStartDate.Value, CurrentPayroll.PayrollEndDate.Value);
        }

        await RefreshAdvanceDeductionSummary();
        await RecalculateBonusesAndDeductions();
        StateHasChanged();
    }

    // ⭐ UPDATED: All calculations now use CurrentPayroll.BaseSalary
    private async Task RecalculateBonusesAndDeductions()
    {
        Console.WriteLine("=== Recalculating Bonuses and Deductions ===");
        Console.WriteLine($"Using BaseSalary: {CurrentPayroll.BaseSalary}");
        Console.WriteLine($"Employee.BaseSalary: {CurrentPayroll.Employee?.BaseSalary}");

        // Regular Bonuses - ALL using CurrentPayroll.BaseSalary
        var regularBonuses = SelectedBonusRules
            .Where(r => r.IsApplied)
            .Sum(r =>
            {
                decimal calculatedValue;
                if (r.IsCountable)
                {
                    calculatedValue = r.Quantity * (r.IsPercentage
                        ? CurrentPayroll.BaseSalary * r.Amount / 100
                        : r.Amount);
                }
                else
                {
                    calculatedValue = r.IsPercentage
                        ? CurrentPayroll.BaseSalary * r.Amount / 100
                        : r.Amount;
                }
                return calculatedValue;
            });

        var preappliedBonuses = PreappliedBonusRules
            .Where(r => r.IsApplied)
            .Sum(r => r.CalculatedAmount);

        CurrentPayroll.Bonus = regularBonuses + preappliedBonuses;
        // CurrentPayroll.BaseSalary is already set, don't overwrite it
        PreappliedBonuses = preappliedBonuses;
        Console.WriteLine($"Total Bonus (Regular: {regularBonuses} + Preapplied: {preappliedBonuses}): {CurrentPayroll.Bonus}");

        // Absence - using CurrentPayroll.BaseSalary for deduction calculation
        var absenceDays = UseManualAbsences ? CurrentPayroll.ManualAbsenceDays : EmployeeAbsences.Count(a => a.Counted);
        var absenceDeduction = absenceDays * CurrentPayroll.DeductionPerAbsenceDay;

        // Rule-based deductions - ALL using CurrentPayroll.BaseSalary
        var regularDeductions = SelectedDeductionRules
            .Where(r => r.IsApplied)
            .Sum(r =>
            {
                decimal calculatedValue;
                if (r.IsCountable)
                {
                    calculatedValue = r.Quantity * (r.IsPercentage
                        ? CurrentPayroll.BaseSalary * r.Amount / 100
                        : r.Amount);
                }
                else
                {
                    calculatedValue = r.IsPercentage
                        ? CurrentPayroll.BaseSalary * r.Amount / 100
                        : r.Amount;
                }
                return calculatedValue;
            });

        var preappliedDeductions = PreappliedDeductionRules
            .Where(r => r.IsApplied)
            .Sum(r => r.CalculatedAmount);

        CurrentPayroll.Deductions = regularDeductions + preappliedDeductions + absenceDeduction;

        await RefreshAdvanceDeductionSummary();

        // Recalculate NetPay
        Console.WriteLine($"Net Pay calculation:");
        Console.WriteLine($"  BaseSalary: {CurrentPayroll.BaseSalary}");
        Console.WriteLine($"  + Bonus: {CurrentPayroll.Bonus}");
        Console.WriteLine($"  - Deductions: {CurrentPayroll.Deductions}");
        Console.WriteLine($"  - AdvanceDeductions: {CurrentPayroll.AdvanceDeductionsAmounts}");
        Console.WriteLine($"  = NetPay: {CurrentPayroll.NetPay}");

        StateHasChanged();
        Console.WriteLine("=== Recalculation Complete ===");
    }

    private void OnCountableQuantityChanged(SelectableRule rule, decimal? quantity)
    {
        Console.WriteLine($"OnCountableQuantityChanged: Rule '{rule.Name}', Old Quantity: {rule.Quantity}, New Quantity: {quantity}");
        var finalQuantity = quantity ?? 1;
        rule.Quantity = finalQuantity;

        // ⭐ UPDATED: Use CurrentPayroll.BaseSalary instead of Employee.BaseSalary
        if (rule.IsCountable)
        {
            var unitAmount = rule.IsPercentage ? CurrentPayroll.BaseSalary * rule.Amount / 100 : rule.Amount;
            rule.CalculatedAmount = unitAmount * finalQuantity;
        }
        else
        {
            rule.CalculatedAmount = rule.IsPercentage ? CurrentPayroll.BaseSalary * rule.Amount / 100 : rule.Amount;
        }
        Console.WriteLine($"  Rule '{rule.Name}' - Amount: {rule.Amount}, Quantity: {rule.Quantity}, CalculatedAmount: {rule.CalculatedAmount}");

        RecalculateBonusesAndDeductions();
    }

    private void OnAmountChanged(SelectableRule rule, decimal? newAmount)
    {
        Console.WriteLine($"OnAmountChanged: Rule '{rule.Name}', Old Amount: {rule.Amount}, New Amount: {newAmount}");
        rule.Amount = newAmount ?? 0;

        if (!rule.IsCountable)
        {
            rule.Quantity = 1;
        }

        OnCountableQuantityChanged(rule, rule.Quantity);
        Console.WriteLine($"After OnAmountChanged: Rule '{rule.Name}' - Amount: {rule.Amount}, Quantity: {rule.Quantity}, CalculatedAmount: {rule.CalculatedAmount}");
    }

