                                                    <button type="button" class="btn btn-sm btn-success" @onclick="ConfirmAddBonusRule">
                                                        <i class="bi bi-check me-1"></i> Ajouter
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-secondary" @onclick="CancelAddBonusRule">
                                                        <i class="bi bi-x me-1"></i> Annuler
                                                    </button>
                                                </div>
