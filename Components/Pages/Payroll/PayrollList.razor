@page "/payrolls"

@using RH.Models
@using RH.Services
@inject PayrollService PayrollService
@inject IEmployeeService EmployeeService
@inject PayrollAdjustmentRuleService AdjustmentService
@inject AbsenceService AbsenceService
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@attribute [Authorize]
@inject IJSRuntime JS

<PageTitle>Fiches de paie</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary fw-bold m-0">Fiches de paie</h2>
    <button class="btn btn-primary" @onclick="async () => await AddPayroll()">
        <i class="bi bi-plus-circle me-2"></i> Nouvelle fiche de paie
    </button>
</div>

@if (Payrolls is null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Chargement...</span>
        </div>
    </div>
}
else if (!Payrolls.Any())
{
    <div class="alert alert-info text-center">
        Aucune fiche de paie disponible.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-primary text-center">
                <tr>
                    <th scope="col">Code</th>
                    <th scope="col">Employé</th>
                    <th scope="col">Date de paiement</th>
                    <th scope="col">Salaire de base</th>
                    <th scope="col">Primes</th>
                    <th scope="col">Retenues</th>
                    <th scope="col">Net à payer</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payroll in Payrolls)
                {
                    <tr>
                        <td class="text-center fw-semibold">#@payroll.Id</td>
                        <td>@payroll.Employee?.FullName</td>
                        <td>@payroll.PayDate.ToString("dd/MM/yyyy")</td>
                        <td class="text-end text-dark">@payroll.BaseSalary.ToString("C")</td>
                        <td class="text-end text-success fw-semibold">+@payroll.Bonus.ToString("C")</td>
                        <td class="text-end text-danger fw-semibold">-@payroll.Deductions.ToString("C")</td>
                        <td class="text-end text-primary fw-bold">@payroll.NetPay.ToString("C")</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() =>  EditPayroll(payroll)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => DeletePayroll(payroll.Id)">
                                Supprimer
                            </button>
                          

                            <!-- Optional: Delete Button -->
                            <!--<button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(payroll.Id)">
                            <i class="bi bi-trash"></i>
                            </button>-->
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


@if (IsModalOpen)
{
    <EditForm Model="CurrentPayroll" OnValidSubmit="SavePayroll">
    <DataAnnotationsValidator />
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content rounded-4 shadow border-primary">
    <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">
            <i class="bi bi-cash-coin me-2"></i>
            @((CurrentPayroll.Id == 0)
                ? "Ajouter une fiche de paie"
                : $"Modifier la fiche de paie (ID: {CurrentPayroll.Id})")
        </h5>

        <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
    </div>

    <div class="modal-body">
        <div class="row g-3">
            <!-- Détails de l'employé -->
            <div class="col-md-6">
                <label class="form-label fw-semibold">Employé</label>
                <InputSelect class="form-select" @bind-Value="CurrentEmployeeId">
                    <option value="">-- Sélectionner un employé --</option>
                    @foreach (var emp in Employees)
                    {
                        <option value="@emp.Id">@emp.FullName</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Date de paiement</label>
                <InputDate class="form-control" @bind-Value="CurrentPayroll.PayDate" />
            </div>

            <!-- Salaire de base -->
            <div class="col-md-6">
                <label class="form-label fw-semibold">Salaire de base</label>
                <InputNumber TValue="decimal"
                             class="form-control"
                             Value="CurrentPayroll.BaseSalary"
                             ValueChanged="OnBaseSalaryChanged"
                             ValueExpression="@(() => CurrentPayroll.BaseSalary)" />
                <small class="text-muted">Récupéré depuis la dernière fiche de paie</small>
            </div>

            <!-- Mode d'absence -->
            <div class="col-md-6">
                <label class="form-label fw-semibold">Mode de saisie des absences</label>
                <select class="form-select" @onchange="OnAbsenceModeChanged">
                    @if (CurrentPayroll.ManualAbsenceDays != 0)
                    {
                        <option value="true">Saisie manuelle</option>
                        <option value="false">Utiliser les absences enregistrées</option>
                    }
                    else
                    {
                        <option value="false">Utiliser les absences enregistrées</option>
                        <option value="true">Saisie manuelle</option>
                    }
                </select>
            </div>

            <!-- Retenue par jour d'absence -->
            <div class="col-md-6">
                <label class="form-label fw-semibold">
                    Retenue par jour d'absence
                    <i class="bi bi-info-circle ms-1 text-muted"
                       title="Montant appliqué automatiquement : salaire de base / 22."></i>
                </label>
                <InputNumber TValue="decimal"
                             class="form-control"
                             Value="CurrentPayroll.DeductionPerAbsenceDay"
                             ValueExpression="@(() => CurrentPayroll.DeductionPerAbsenceDay)"
                             Disabled="true" />
                <small class="text-muted">Calculé automatiquement</small>
            </div>

            <!-- Absences -->
            <div class="col-md-6">
                <div class="card border-secondary p-3">
                    <h6 class="card-title mb-2"><i class="bi bi-calendar-x me-2"></i> Absences</h6>

                    @if (UseManualAbsences || CurrentPayroll.ManualAbsenceDays != 0)
                    {
                        <label class="form-label">Nombre de jours d'absence (manuel)</label>
                        <InputNumber TValue="int"
                                     class="form-control"
                                     Value="CurrentPayroll.ManualAbsenceDays"
                                     ValueChanged="OnManualAbsenceDaysChanged"
                                     ValueExpression="@(() =>CurrentPayroll.ManualAbsenceDays)" />
                    }
                    else if (EmployeeAbsences.Any())
                    {
                        <div class="table-responsive" style="max-height: 200px; overflow-y: auto;">
                            <table class="table table-bordered table-sm">
                                <thead class="table-light">
                                <tr>
                                    <th style="width: 25%;">Date</th>
                                    <th>Motif</th>
                                    <th style="width: 100px;" class="text-center">Comptée</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var a in EmployeeAbsences)
                                {
                                    <tr>
                                        <td>@a.Date.ToShortDateString()</td>
                                        <td>
                                            <InputText class="form-control form-control-sm" @bind-Value="a.Reason" Disabled />
                                        </td>
                                        <td class="text-center">
                                            <InputCheckbox class="form-check-input mt-1"
                                                           Value="a.Counted"
                                                           ValueChanged="val => OnCountedChanged(a, val)"
                                                           ValueExpression="@(() => a.Counted)" />
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">Aucune absence enregistrée.</div>
                    }
                </div>
            </div>

            <!-- PRIMES -->
            <div class="col-md-6">
                <div class="card border-success p-3 shadow-sm rounded-3">
                    <h6 class="text-success mb-3"><i class="bi bi-plus-circle me-2"></i> Primes</h6>

                    @foreach (var rule in SelectedBonusRules)
                    {
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <!-- Checkbox and label -->
                            <div class="d-flex align-items-center flex-grow-1 me-2">
                                <InputCheckbox class="form-check-input me-2"
                                               Value="rule.IsApplied"
                                               ValueChanged="val => OnBonusRuleChanged(rule, val)"
                                               ValueExpression="@(() => rule.IsApplied)" />
                                <label class="form-check-label mb-0">
                                    @rule.Name
                                    @if (!rule.IsPercentage && rule.Amount > 0)
                                    {
                                        <span class="text-muted ms-1">(@rule.Amount.ToString("C"))</span>
                                    }
                                    else if (rule.IsPercentage)
                                    {
                                        <span class="text-muted ms-1">(@rule.Amount %)</span>
                                    }
                                </label>
                            </div>

                            @if (rule.IsApplied)
                            {
                                <div class="d-flex align-items-center" style="gap: 0.5rem;">
                                    @* Editable amount if not preset *@
                                    @if (rule.IsEditable)

                                    {
                                        <InputNumber TValue="decimal"
                                                     class="form-control form-control-sm"
                                                     style="width: 90px;"
                                                     Value="rule.Amount"
                                                     ValueChanged="val => OnAmountChanged(rule, val)"
                                                     ValueExpression="@(() => rule.Amount)" />
                                    }

                                    @if (rule.IsCountable)
                                    {
                                        <InputNumber TValue="int"
                                                     class="form-control form-control-sm"
                                                     style="width: 80px;"
                                                     Value="rule.Quantity"
                                                     ValueChanged="val => OnCountableQuantityChanged(rule, val)"
                                                     ValueExpression="@(() => rule.Quantity)" />
                                    }

                                    <div class="text-success fw-semibold" style="min-width: 90px; text-align: end;">
                                        @rule.CalculatedAmount.ToString("N2") DA
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>


            <!-- RETENUES -->
            <div class="col-md-6">
                <div class="card border-danger p-3 shadow-sm rounded-3">
                    <h6 class="text-danger mb-3"><i class="bi bi-dash-circle me-2"></i> Retenues</h6>

                    @foreach (var rule in SelectedDeductionRules)
                    {
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <!-- Checkbox and label -->
                            <div class="d-flex align-items-center flex-grow-1 me-2">
                                <InputCheckbox class="form-check-input me-2"
                                               Value="rule.IsApplied"
                                               ValueChanged="val => OnDeductionRuleChanged(rule, val)"
                                               ValueExpression="@(() => rule.IsApplied)" />
                                <label class="form-check-label mb-0">
                                    @rule.Name
                                    @if (!rule.IsPercentage && rule.Amount > 0)
                                    {
                                        <span class="text-muted ms-1">(@rule.Amount:N2 DA)</span>
                                    }
                                    else if (rule.IsPercentage)
                                    {
                                        <span class="text-muted ms-1">(@rule.Amount %)</span>
                                    }
                                </label>
                            </div>

                            @if (rule.IsApplied)
                            {
                                <div class="d-flex align-items-center" style="gap: 0.5rem;">
                                    @if (rule.IsEditable)

                                    {
                                        <InputNumber TValue="decimal"
                                                     class="form-control form-control-sm"
                                                     style="width: 90px;"
                                                     Value="rule.Amount"
                                                     ValueChanged="val => OnAmountChanged(rule, val)"
                                                     ValueExpression="@(() => rule.Amount)" />
                                    }

                                    @if (rule.IsCountable)
                                    {
                                        <InputNumber TValue="int"
                                                     class="form-control form-control-sm"
                                                     style="width: 80px;"
                                                     Value="rule.Quantity"
                                                     ValueChanged="val => OnCountableQuantityChanged(rule, val)"
                                                     ValueExpression="@(() => rule.Quantity)" />
                                    }

                                    <div class="text-danger fw-semibold" style="min-width: 90px; text-align: end;">
                                        @rule.CalculatedAmount.ToString("N2") DA
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>





            <!-- Résumé -->
            <div class="col-md-4">
                <label class="form-label fw-semibold">Total primes</label>
                <InputNumber class="form-control" @bind-Value="CurrentPayroll.Bonus" Disabled />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Total retenues</label>
                <InputNumber class="form-control" @bind-Value="CurrentPayroll.Deductions" Disabled />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Net à payer</label>
                <div class="form-control bg-light border border-success fw-bold">
                    @((CurrentPayroll.BaseSalary + CurrentPayroll.Bonus - CurrentPayroll.Deductions).ToString("C"))
                </div>
            </div>
        </div> <!-- .row g-3 -->
    </div>

    <div class="modal-footer bg-light">
        <button type="submit" class="btn btn-success px-4">
            <i class="bi bi-save me-2"></i> Enregistrer
        </button>
        <button class="btn btn-outline-primary" @onclick="ShowPrintModal">🖨️ Aperçu impression</button>

                        
        <button type="button" class="btn btn-outline-secondary" @onclick="CloseModal">
            <i class="bi bi-x-lg me-1"></i> Annuler
        </button>
    </div>
    </div>
    </div>
    </div>
    </EditForm>

}
@if (IsPrintModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content rounded-4 shadow border-primary">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Aperçu de la fiche de paie</h5>
                    <button class="btn-close btn-close-white" @onclick="ClosePrintModal"></button>
                </div>
                <div class="modal-body">
                    <div id="printable-area">
                        <PayrollPrint CurrentPayroll="CurrentPayroll"
                                      Employee="CurrentPayroll.Employee"
                                      Bonuses="SelectedBonusRules"
                                      Deductions="SelectedDeductionRules"
                                      Absences="EmployeeAbsences" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button class="btn btn-success" @onclick="Print">Imprimer</button>
                    <button class="btn btn-outline-secondary" @onclick="ClosePrintModal">Fermer</button>
                </div>
            </div>
        </div>
    </div>
}
@code {
    private bool IsPrintModalOpen = false;
    private bool IsModalOpen = false;
    void ShowPrintModal()
    {
        IsPrintModalOpen = true;
        StateHasChanged(); // Assurez-vous que l'UI est rafraîchie
    }
    void ClosePrintModal()
    {
        IsPrintModalOpen = false;
        StateHasChanged(); // Assurez-vous que l'UI est rafraîchie
    }

   

    async Task Print()
    {
        // Print only a portion of the page (optional improvement)
        await JS.InvokeVoidAsync("printSection", "printable-area");
    }
}
<div id="printable-area">
    <!-- Fiche de paie content here -->
</div>
@code {
    private List<Payroll> Payrolls = new();
    private List<Employee> Employees = new();
    private List<PayrollAdjustmentRule> AllAdjustmentRules = new();
    private List<SelectableRule> SelectedBonusRules = new();
    private List<SelectableRule> SelectedDeductionRules = new();
    private Payroll CurrentPayroll = new();

    
    private bool UseManualAbsences = false;
    private async Task PrintPreview()
    {
        var payload = new
        {
            Payroll = CurrentPayroll,
            Employee = CurrentPayroll.Employee,
            Bonuses = SelectedBonusRules,
            Deductions = SelectedDeductionRules,
            Absences = EmployeeAbsences
        };

        // Serialize and store in sessionStorage
        var json = JsonSerializer.Serialize(payload);
        await JS.InvokeVoidAsync("sessionStorage.setItem", "payroll-print-data", json);

        // Open print page
        await JS.InvokeVoidAsync("open", "/print-payroll", "_blank");
    }
    private void OnBaseSalaryChanged(decimal value)
    {
        if (CurrentPayroll == null) return;

        CurrentPayroll.BaseSalary = value;
        CurrentPayroll.DeductionPerAbsenceDay = Math.Round(value / 22, 2);
    }

    private Task OnManualAbsenceDaysChanged(int value)
    {
        CurrentPayroll.ManualAbsenceDays = value;
        RecalculateBonusesAndDeductions();
        return Task.CompletedTask;
    }

    private void OnBonusRuleChanged(SelectableRule rule, bool isApplied)
    {
        rule.IsApplied = isApplied;

        if (isApplied && rule.IsCountable)
        {
            OnCountableQuantityChanged(rule, rule.Quantity);
        }
    }

    private void OnDeductionRuleChanged(SelectableRule rule, bool isApplied)
    {
        rule.IsApplied = isApplied;

        if (isApplied && rule.IsCountable)
        {
            OnCountableQuantityChanged(rule, rule.Quantity);
        }
    }

    private void OnCountedChanged(AbsenceRecord record, bool val)
    {
        record.Counted = val;
        RecalculateBonusesAndDeductions();
    }

    private async Task LoadAbsenceDates(int employeeId, DateTime payMonth)
    {
        EmployeeAbsences = await AbsenceService.GetByEmployeeAndMonthAsync(employeeId, payMonth);
     
    }

    private Task OnDeductionChanged(decimal val)
    {
        CurrentPayroll.DeductionPerAbsenceDay = val;
        RecalculateBonusesAndDeductions();
        return Task.CompletedTask;
    }

    private void RecalculateBonusesAndDeductions()
    {
        CurrentPayroll.Bonus = SelectedBonusRules
            .Where(r => r.IsApplied)
            .Sum(r => r.IsCountable && r.Quantity > 0 ? r.CalculatedAmount : (r.IsPercentage ? CurrentPayroll.BaseSalary * r.Amount / 100 : r.Amount));

        var absenceDays = UseManualAbsences ? CurrentPayroll.ManualAbsenceDays : EmployeeAbsences.Count(a => a.Counted);
        var absenceDeduction = absenceDays * CurrentPayroll.DeductionPerAbsenceDay;

        var ruleBasedDeductions = SelectedDeductionRules
            .Where(r => r.IsApplied)
            .Sum(r => r.IsCountable && r.Quantity > 0 ? r.CalculatedAmount : (r.IsPercentage ? CurrentPayroll.BaseSalary * r.Amount / 100 : r.Amount));

        CurrentPayroll.Deductions = ruleBasedDeductions + absenceDeduction;

        StateHasChanged();
    }

    private int CurrentEmployeeId
    {
        get => CurrentPayroll.EmployeeId;
        set
        {
            if (CurrentPayroll.EmployeeId != value)
            {
                CurrentPayroll.EmployeeId = value;
                InvokeAsync(async () => await OnEmployeeChanged(value));
            }
        }
    }

    private List<AbsenceRecord> EmployeeAbsences = new();

    protected override async Task OnInitializedAsync()
    {
        Employees = await EmployeeService.GetAllAsync();
        AllAdjustmentRules = await AdjustmentService.GetAllAsync();

        if (CurrentPayroll.ManualAbsenceDays != 0)
        {
            UseManualAbsences = true;
        }
        await LoadPayrolls();
    }

    private async Task LoadPayrolls() => Payrolls = await PayrollService.GetAllAsync();

    private async Task AddPayroll()
    {
        CurrentPayroll = new Payroll { PayDate = DateTime.Today };
        SelectedBonusRules.Clear();
        SelectedDeductionRules.Clear();
        if (Employees.Any())
        {
            await OnEmployeeChanged(CurrentPayroll.EmployeeId);
            await LoadAbsenceDates(CurrentPayroll.EmployeeId, CurrentPayroll.PayDate);
        }
        IsPrintModalOpen = false; // Assurez-vous que la modale d'impression est fermée
        IsModalOpen = true;
    }

    private async Task DeletePayroll(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Êtes-vous sûr de vouloir supprimer cette fiche de paie ?");
        if (confirmed)
        {
            await PayrollService.DeleteAsync(id);
        }
        await LoadPayrolls();
    }

    private async Task EditPayroll(Payroll payroll)
    {
        // Clone selected payroll into a new instance for editing
        CurrentPayroll = new Payroll
        {
            Id = payroll.Id,
            EmployeeId = payroll.EmployeeId,
            PayDate = payroll.PayDate,
            BaseSalary = payroll.BaseSalary,
            Bonus = payroll.Bonus,
            Deductions = payroll.Deductions,
            DeductionPerAbsenceDay = payroll.DeductionPerAbsenceDay,
            ManualAbsenceDays = payroll.ManualAbsenceDays,
            AbsenceDeduction = payroll.AbsenceDeduction,
            AbsenceDays = payroll.AbsenceDays,
            Employee = payroll.Employee

        };

        // Try to get employee's job title
        var employee = Employees.FirstOrDefault(e => e.Id == payroll.EmployeeId);
        var jobTitleId = employee?.JobTitleId;

        if (jobTitleId != null)
        {
            var appliedRules = payroll.AppliedRules ?? new List<PayrollAppliedRule>();

            // Filter adjustment rules based on employee's job title
            var bonusRules = AllAdjustmentRules
                .Where(r => r.Type == AdjustmentType.Bonus && r.JobTitles.Any(j => j.Id == jobTitleId));
            var deductionRules = AllAdjustmentRules
                .Where(r => r.Type == AdjustmentType.Deduction && r.JobTitles.Any(j => j.Id == jobTitleId));

            // Prepare selectable bonus rules
            SelectedBonusRules = bonusRules.Select(rule =>
            {
                var applied = appliedRules.FirstOrDefault(a => a.RuleId == rule.Id);
                return applied != null ? new SelectableRule(applied) : new SelectableRule(rule);
            }).ToList();

            // Prepare selectable deduction rules
            SelectedDeductionRules = deductionRules.Select(rule =>
            {
                var applied = appliedRules.FirstOrDefault(a => a.RuleId == rule.Id);
                return applied != null ? new SelectableRule(applied) : new SelectableRule(rule);
            }).ToList();
        }
        else
        {
            // Optional: log or notify if job title not found
            Console.WriteLine("Job title not found for the selected employee.");
            SelectedBonusRules = new List<SelectableRule>();
            SelectedDeductionRules = new List<SelectableRule>();
        }

        // Load absences (use your own implementation inside LoadAbsenceDates)
        await LoadAbsenceDates(CurrentPayroll.EmployeeId, CurrentPayroll.PayDate);

        // Open the modal for editing
        IsPrintModalOpen = false; // Assurez-vous que la modale d'impression est fermée
        IsModalOpen = true;
    }


    private async Task SavePayroll()
    {
        RecalculateBonusesAndDeductions();

        CurrentPayroll.Bonus = SelectedBonusRules.Where(r => r.IsApplied)
            .Sum(r => r.IsPercentage ? CurrentPayroll.BaseSalary * r.Amount / 100m : r.CalculatedAmount);

        CurrentPayroll.Deductions = SelectedDeductionRules.Where(r => r.IsApplied)
            .Sum(r => r.IsPercentage ? CurrentPayroll.BaseSalary * r.Amount / 100m : r.CalculatedAmount);

        if (UseManualAbsences)
        {
            CurrentPayroll.AbsenceDays = CurrentPayroll.ManualAbsenceDays;
            CurrentPayroll.AbsenceDeduction = CurrentPayroll.ManualAbsenceDays * CurrentPayroll.DeductionPerAbsenceDay;
        }
        else
        {
            int countedAbsences = EmployeeAbsences.Count(a => a.Counted);
            CurrentPayroll.AbsenceDays = countedAbsences;
            CurrentPayroll.AbsenceDeduction = countedAbsences * CurrentPayroll.DeductionPerAbsenceDay;
        }

        CurrentPayroll.Deductions += CurrentPayroll.AbsenceDeduction;

        CurrentPayroll.AppliedRules = SelectedBonusRules
            .Where(r => r.IsApplied)
            .Concat(SelectedDeductionRules.Where(r => r.IsApplied))
            .Select(r => new PayrollAppliedRule
                {
                    RuleId = r.RuleId,
                    Amount = r.Amount,
                    Quantity = r.IsCountable ? r.Quantity : null
                }).ToList();

        if (CurrentPayroll.Id == 0)
        {
            await PayrollService.CreateAsync(CurrentPayroll);
        }
        else
        {
            await PayrollService.UpdateAsync(CurrentPayroll);
        }

        if (!UseManualAbsences)
        {
            foreach (var abs in EmployeeAbsences.Where(a => a.Counted))
            {
                abs.PayrollId = CurrentPayroll.Id;
                await AbsenceService.UpdateAsync(abs);
            }
        }

        IsModalOpen = false;
        await LoadPayrolls();
    }

    private void OnAbsenceModeChanged(ChangeEventArgs e)
    {
        if (bool.TryParse(e.Value?.ToString(), out var result))
        {
            UseManualAbsences = result;
            RecalculateBonusesAndDeductions();
        }
    }

    private void CloseModal()
    {
        IsModalOpen = false;
        IsPrintModalOpen = false; // Ferme les deux modales si l'une est fermée
        StateHasChanged(); 
    }

    private async Task OnEmployeeChanged(int employeeId)
    {
        SelectedBonusRules.Clear();
        SelectedDeductionRules.Clear();
        CurrentPayroll.BaseSalary = 0;
        var employee = Employees.FirstOrDefault(e => e.Id == employeeId);
        if (employee == null) return;

        if (employee.JobTitleId is int jobTitleId)
        {
            SelectedBonusRules = AllAdjustmentRules.Where(r => r.Type == AdjustmentType.Bonus && r.JobTitles.Any(j => j.Id == jobTitleId))
                .Select(r => new SelectableRule(r)).ToList();
            SelectedDeductionRules = AllAdjustmentRules.Where(r => r.Type == AdjustmentType.Deduction && r.JobTitles.Any(j => j.Id == jobTitleId))
                .Select(r => new SelectableRule(r)).ToList();
        }

        var lastPayroll = await PayrollService.GetLastPayrollForEmployeeAsync(employeeId);
        CurrentPayroll.BaseSalary = lastPayroll?.BaseSalary ?? 0;
        if (CurrentPayroll.BaseSalary != 0)
        {
            CurrentPayroll.DeductionPerAbsenceDay = Math.Round(CurrentPayroll.BaseSalary / 22, 2);
        }
        if (CurrentPayroll?.PayDate != null)
        {
            await LoadAbsenceDates(employeeId, CurrentPayroll.PayDate);
        }

        RecalculateBonusesAndDeductions();
        StateHasChanged();
    }

    private void OnAbsenceDeductionChanged()
    {
        RecalculateBonusesAndDeductions();
    }

    private void OnCountableQuantityChanged(SelectableRule rule, int? quantity)
    {
        var finalQuantity = quantity ?? 1;
        rule.Quantity = finalQuantity;

        if (rule.IsCountable)
        {
            var unitAmount = rule.IsPercentage ? CurrentPayroll.BaseSalary * rule.Amount / 100 : rule.Amount;
            rule.CalculatedAmount = unitAmount * finalQuantity;
        }
        else
        {
            rule.CalculatedAmount = rule.IsPercentage ? CurrentPayroll.BaseSalary * rule.Amount / 100 : rule.Amount;
        }

        RecalculateBonusesAndDeductions();
    }

    private void OnAmountChanged(SelectableRule rule, decimal? newAmount)
    {
        rule.Amount = newAmount ?? 0;

        if (!rule.IsCountable)
        {
            rule.Quantity = 1;
        }

        OnCountableQuantityChanged(rule, rule.Quantity);
    }

    public class SelectableRule
    {
        public int RuleId { get; set; }
        public string Name { get; set; }
        public decimal Amount { get; set; }
        public bool IsPercentage { get; set; }
        public bool IsCountable { get; set; }
        public bool IsApplied { get; set; } = true;
        public int Quantity { get; set; } = 1;
        public bool IsEditable { get; set; } = false;
        public decimal CalculatedAmount { get; set; }

        public SelectableRule(PayrollAppliedRule appliedRule)
        {
            RuleId = appliedRule.RuleId;
            Name = appliedRule.Rule.Name;
            Amount = appliedRule.Amount;
            IsPercentage = appliedRule.Rule.IsPercentage;
            IsCountable = appliedRule.Rule.IsCountable;
            IsApplied = true;
            IsEditable = appliedRule.Rule.IsEditable;
            Quantity = appliedRule.Quantity ?? 1;
            CalculatedAmount = IsCountable
                ? (IsPercentage ? appliedRule.Payroll.BaseSalary * Amount / 100 : Amount) * Quantity
                : (IsPercentage ? appliedRule.Payroll.BaseSalary * Amount / 100 : Amount);
        }

        public SelectableRule(PayrollAdjustmentRule rule, bool isApplied = false)
        {
            RuleId = rule.Id;
            Name = rule.Name;
            Amount = rule.Amount;
            IsPercentage = rule.IsPercentage;
            IsCountable = rule.IsCountable;
            IsEditable = rule.IsEditable;
            IsApplied = isApplied;
            Quantity = 1;
            CalculatedAmount = 0;
        }
    }
