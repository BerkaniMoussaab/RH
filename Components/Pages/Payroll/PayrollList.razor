                                                            <div class="calculated-amount danger">
                                                                @rule.CalculatedAmount.ToString() DA
                                                            </div>

                                                            @if (!rule.IsEditable && !rule.IsCountable)
                                                            {
                                                                <small class="text-muted ms-1 fst-italic">Montant fixe</small>
                                                            }

                                                            <button type="button" class="btn btn-sm btn-outline-danger ms-2"
                                                                    @onclick="() => RemoveDeductionRule(rule.Id)"
                                                                    title="Supprimer cette instance">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <div class="mt-3">
                                        @if (IsAddingDeductionRule)
                                        {
                                            <div class="add-rule-form p-3 border rounded bg-light">
                                                <h6>Ajouter une retenue</h6>
                                                <div class="mb-3">
                                                    <label class="form-label">Sélectionner une règle:</label>
                                                    <select class="form-select" @bind="SelectedDeductionRuleToAdd">
                                                        <option value="">-- Choisir une règle --</option>
                                                        @foreach (var rule in AvailableDeductionRules)
                                                        {
                                                            <option value="@rule.Id">@rule.Name (@(rule.IsPercentage ? rule.Amount + "%" : rule.Amount.ToString("C")))</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="d-flex gap-2">
                                                    <button type="button" class="btn btn-sm btn-success" @onclick="ConfirmAddDeductionRule">
                                                        <i class="bi bi-check me-1"></i> Ajouter
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-secondary" @onclick="CancelAddDeductionRule">
                                                        <i class="bi bi-x me-1"></i> Annuler
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-primary" @onclick="StartAddDeductionRule">
                                                <i class="bi bi-plus-circle me-2"></i> Ajouter une retenue
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Summary Section -->
                            <div class="col-12">
                                <div class="summary-section">
                                    <div class="section-title">
                                        <i class="bi bi-calculator text-info me-2"></i>
                                        <span>Résumé des calculs</span>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-3">
                                            <div class="summary-card">
                                                <label class="form-label fw-semibold">Total primes</label>
                                                <InputNumber class="form-control enhanced-input summary-input success" @bind-Value="CurrentPayroll.Bonus" Disabled />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="summary-card">
                                                <label class="form-label fw-semibold">Total retenues</label>
                                                <InputNumber class="form-control enhanced-input summary-input danger" @bind-Value="CurrentPayroll.Deductions" Disabled />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="summary-card">
                                                <label class="form-label fw-semibold">Avances déduites</label>
                                                <InputNumber class="form-control enhanced-input summary-input warning" @bind-Value="CurrentPayroll.AdvanceDeductionsAmounts" Disabled />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="summary-card">
                                                <label class="form-label fw-semibold">Net à payer</label>
                                                <div class="form-control enhanced-input summary-input primary fw-bold">
                                                    @CurrentPayroll.NetPay.ToString("C")
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Payment Mode Section -->
                            <div class="col-12">
                                <div class="payment-section">
                                    <div class="section-title">
                                        <i class="bi bi-credit-card text-primary me-2"></i>
                                        <span>Mode de paiement</span>
                                    </div>

                                    <div class="payment-mode-wrapper">
                                        <InputRadioGroup @bind-Value="CurrentPayroll.TransactionIsManual">
                                            <div class="payment-options">
                                                <div class="payment-option">
                                                    <InputRadio class="form-check-input" Value="true" />
                                                    <label class="form-check-label">
                                                        <i class="bi bi-credit-card me-2"></i>
                                                        Saisir Transaction
                                                    </label>
                                                </div>
                                                <div class="payment-option">
                                                    <InputRadio class="form-check-input" Value="false" />
                                                    <label class="form-check-label">
                                                        <i class="bi bi-cash me-2"></i>
                                                        Saisir Cash
                                                    </label>
                                                </div>
                                            </div>
                                        </InputRadioGroup>
                                    </div>

                                    <div class="row g-3 mt-3">
                                        @if (CurrentPayroll.TransactionIsManual)
                                        {
                                            <div class="col-md-6">
                                                <div class="enhanced-form-group">
                                                    <label class="form-label fw-semibold">
                                                        <i class="bi bi-credit-card me-1"></i>Transaction
                                                    </label>
                                                    <InputNumber @bind-Value="CurrentPayroll.Transaction" class="form-control enhanced-input" />
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="calculated-field-wrapper">
                                                    <label class="form-label fw-semibold">
                                                        <i class="bi bi-cash me-1"></i>Cash (calculé)
                                                    </label>
                                                    <div class="form-control enhanced-input calculated-display">
                                                        @CurrentPayroll.Cash.ToString("C")
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-md-6">
                                                <div class="enhanced-form-group">
                                                    <label class="form-label fw-semibold">
                                                        <i class="bi bi-cash me-1"></i>Cash
                                                    </label>
                                                    <InputNumber @bind-Value="CurrentPayroll.Cash" class="form-control enhanced-input" />
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="calculated-field-wrapper">
                                                    <label class="form-label fw-semibold">
                                                        <i class="bi bi-credit-card me-1"></i>Transaction (calculé)
                                                    </label>
                                                    <div class="form-control enhanced-input calculated-display">
                                                        @CurrentPayroll.Transaction.ToString("C")
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        <div class="col-md-6">
                                            <div class="net-pay-wrapper">
                                                <label class="form-label fw-semibold">
                                                    <i class="bi bi-check-circle me-1"></i>Net à payer
                                                </label>
                                                <div class="form-control enhanced-input net-pay-display">
                                                    @CurrentPayroll.NetPay.ToString("C")
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Enhanced Footer -->
                    <div class="modal-footer enhanced-footer">
                        <button type="submit" class="btn btn-success enhanced-btn primary-action">
                            <i class="bi bi-save me-2"></i> Enregistrer
                        </button>
                        @if (CurrentPayroll != null && CurrentPayroll.Id > 0)
                        {
                            <button class="btn btn-outline-primary enhanced-btn" @onclick="ShowPrintModal">
                                <i class="bi bi-printer me-2"></i> Aperçu impression
                            </button>
                        }
                        <button type="button" class="btn btn-outline-secondary enhanced-btn" @onclick="CloseModal">
                            <i class="bi bi-x-lg me-1"></i> Annuler
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
}

<!-- Print Modal -->
@if (IsPrintModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content rounded-4 shadow border-primary">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Aperçu de la fiche de paie</h5>
                    <button class="btn-close btn-close-white" @onclick="ClosePrintModal"></button>
                </div>
                <div class="modal-body">
                    <div id="printable-area">
                        <PayrollPrint CurrentPayroll="CurrentPayroll"
                                      Employee="CurrentPayroll.Employee"
                                      Bonuses="SelectedBonusRules"
                                      Deductions="SelectedDeductionRules"
                                      Absences="EmployeeAbsences"
                                      ManualAbsences="CurrentPayroll.ManualAbsenceDays"
                                      AdvanceSummary="CurrentAdvanceDeductionSummary" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button class="btn btn-success" @onclick="Print">Imprimer</button>
                    <button class="btn btn-outline-secondary" @onclick="ClosePrintModal">Fermer</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool IsPrintModalOpen = false;
    private bool IsModalOpen = false;

    // Rule management properties
    private bool IsAddingBonusRule = false;
    private bool IsAddingDeductionRule = false;
    private int SelectedBonusRuleToAdd = 0;
    private int SelectedDeductionRuleToAdd = 0;
    private List<PayrollAdjustmentRule> AvailableBonusRules = new();
    private List<PayrollAdjustmentRule> AvailableDeductionRules = new();

    // Filter properties
    private DateTime? FilterStartDate { get; set; } = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-1);
    private DateTime? FilterEndDate { get; set; } = DateTime.Today;

    // Data properties
    private List<Payroll> Payrolls = new();
    private List<Employee> Employees = new();
    private List<PayrollAdjustmentRule> AllAdjustmentRules = new();
    private List<SelectableRule> SelectedBonusRules = new();
    private List<SelectableRule> SelectedDeductionRules = new();
    private Payroll CurrentPayroll = new();
    public int workDaysPerMonth;

    // Advance payment related properties
    private PayrollService.AdvanceDeductionSummary CurrentAdvanceDeductionSummary = new();
    private bool _isAdvanceAmountManuallySet = false;

    private bool UseManualAbsences = false;
    private List<AbsenceRecord> EmployeeAbsences = new();

    // Print modal methods
    private async Task ShowPrintModal()
    {
        IsPrintModalOpen = true;
        StateHasChanged();
    }

    void ClosePrintModal()
    {
        IsPrintModalOpen = false;
        StateHasChanged();
    }

    async Task Print()
    {
        await JS.InvokeVoidAsync("printSection", "printable-area");
    }

    protected override async Task OnInitializedAsync()
    {
        Employees = await EmployeeService.GetAllAsync();
        AllAdjustmentRules = await AdjustmentService.GetAllAsync();

        var company = await CompanyService.GetAsync();
        workDaysPerMonth = company.WorKdaysInMonth;

        if (CurrentPayroll.ManualAbsenceDays != 0)
        {
            UseManualAbsences = true;
        }

        await LoadPayrolls();
    }

    private async Task LoadPayrolls()
    {
        Payrolls = await PayrollService.GetAllAsync(FilterStartDate, FilterEndDate);
    }

    private async Task AddPayroll()
    {
        CurrentPayroll = new Payroll
            {
                PayDate = DateTime.Today,
                PayrollStartDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1),
                PayrollEndDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1)
            };

        SelectedBonusRules.Clear();
        SelectedDeductionRules.Clear();
        CurrentAdvanceDeductionSummary = new PayrollService.AdvanceDeductionSummary();
        _isAdvanceAmountManuallySet = false;

        // Auto-apply rules with AutoApplied = true
        SelectedBonusRules = AllAdjustmentRules
            .Where(r => r.Type == AdjustmentType.Bonus && r.AutoApplied)
            .Select(r => new SelectableRule(r, workDaysPerMonth, isApplied: true))
            .ToList();

        SelectedDeductionRules = AllAdjustmentRules
            .Where(r => r.Type == AdjustmentType.Deduction && r.AutoApplied)
            .Select(r => new SelectableRule(r, workDaysPerMonth, isApplied: true))
            .ToList();

        // Assign instance numbers for display
        AssignInstanceNumbers();

        if (Employees.Any())
        {
            await OnEmployeeChanged(CurrentPayroll.EmployeeId);
        }

        IsPrintModalOpen = false;
        IsModalOpen = true;
    }

    private async Task DeletePayroll(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Êtes-vous sûr de vouloir supprimer cette fiche de paie ?");
        if (confirmed)
        {
            await PayrollService.ReverseAdvanceDeductionsAsync(id);
            await PayrollService.DeleteAsync(id);
        }
        await LoadPayrolls();
    }

    // IMPROVED EditPayroll method with better duplicate rule handling
    private async Task EditPayroll(Payroll payroll)
    {
        CurrentPayroll = new Payroll
            {
                Id = payroll.Id,
                EmployeeId = payroll.EmployeeId,
                PayDate = payroll.PayDate,
                PayrollStartDate = payroll.PayrollStartDate,
                PayrollEndDate = payroll.PayrollEndDate,
                BaseSalary = payroll.BaseSalary,
                Bonus = payroll.Bonus,
                Deductions = payroll.Deductions,
                DeductionPerAbsenceDay = payroll.DeductionPerAbsenceDay,
                ManualAbsenceDays = payroll.ManualAbsenceDays,
                AbsenceDeduction = payroll.AbsenceDeduction,
                AbsenceDays = payroll.AbsenceDays,
                Employee = payroll.Employee,
                Transaction = payroll.Transaction,
                Cash = payroll.Cash,
                AdvanceDeductionsAmounts = payroll.AdvanceDeductionsAmounts,
                AppliedRules = payroll.AppliedRules
            };

        var employee = Employees.FirstOrDefault(e => e.Id == payroll.EmployeeId);
        var jobTitleId = employee?.JobTitleId;

        SelectedBonusRules.Clear();
        SelectedDeductionRules.Clear();

        if (jobTitleId != null)
        {
            // Load applied rules from the database for this specific payroll
            var appliedRules = await PayrollService.GetAppliedRulesForPayrollAsync(payroll.Id);

            // Create SelectableRule instances from applied rules
            SelectedBonusRules = appliedRules
                .Where(ar => ar.Rule.Type == AdjustmentType.Bonus)
                .Select(ar => new SelectableRule(ar, workDaysPerMonth, CurrentPayroll.BaseSalary))
                .ToList();

            SelectedDeductionRules = appliedRules
                .Where(ar => ar.Rule.Type == AdjustmentType.Deduction)
                .Select(ar => new SelectableRule(ar, workDaysPerMonth, CurrentPayroll.BaseSalary))
                .ToList();

            // Add any auto-applied rules that are not already present
            var autoAppliedBonusRules = AllAdjustmentRules
                .Where(r => r.Type == AdjustmentType.Bonus && r.AutoApplied && r.JobTitles.Any(j => j.Id == jobTitleId)
                            && !SelectedBonusRules.Any(sbr => sbr.RuleId == r.Id));
            foreach (var rule in autoAppliedBonusRules)
            {
                SelectedBonusRules.Add(new SelectableRule(rule, workDaysPerMonth, isApplied: true));
            }

            var autoAppliedDeductionRules = AllAdjustmentRules
                .Where(r => r.Type == AdjustmentType.Deduction && r.AutoApplied && r.JobTitles.Any(j => j.Id == jobTitleId)
                            && !SelectedDeductionRules.Any(sdr => sdr.RuleId == r.Id));
            foreach (var rule in autoAppliedDeductionRules)
            {
                SelectedDeductionRules.Add(new SelectableRule(rule, workDaysPerMonth, isApplied: true));
            }

            // Load available rules for adding new instances
            LoadAvailableRules(jobTitleId.Value);
        }

        // Assign instance numbers for better display
        AssignInstanceNumbers();

        await LoadPayrollAbsences(CurrentPayroll.Id);
        await RefreshAdvanceDeductionSummary();
        _isAdvanceAmountManuallySet = false;

        IsPrintModalOpen = false;
        IsModalOpen = true;
    }

    // IMPROVED SavePayroll method with proper CRUD operations
    private async Task SavePayroll()
    {
        // Prepare applied rules for saving
        var appliedRulesToSave = SelectedBonusRules
            .Where(r => r.IsApplied)
            .Concat(SelectedDeductionRules.Where(r => r.IsApplied))
            .Select(r => new PayrollAppliedRule
                {
                    Id = r.PayrollAppliedRuleId ?? 0, // Use existing ID or 0 for new
                    RuleId = r.RuleId,
                    Amount = r.Amount,
                    Quantity = r.IsCountable ? r.Quantity : null,
                    EmployeeId = CurrentPayroll.EmployeeId,
                    PayrollId = CurrentPayroll.Id
                })
            .ToList();

        CurrentPayroll.AppliedRules = appliedRulesToSave;
        CurrentPayroll.DeductionPerAbsenceDay = Math.Round(CurrentPayroll.BaseSalary / workDaysPerMonth, 2);

        if (CurrentPayroll.Id == 0)
        {
            await PayrollService.CreateAsync(CurrentPayroll);
        }
        else
        {
            await PayrollService.UpdateAsync(CurrentPayroll);
        }

        if (CurrentPayroll.AdvanceDeductionsAmounts > 0)
        {
            await PayrollService.ProcessAdvanceDeductionsForPayrollAsync(CurrentPayroll);
        }

        if (!UseManualAbsences)
        {
            foreach (var abs in EmployeeAbsences.Where(a => a.Counted))
            {
                abs.PayrollId = CurrentPayroll.Id;
                await AbsenceService.UpdateAsync(abs);
            }
        }

        IsModalOpen = false;
        await LoadPayrolls();
    }

    // NEW: Method to assign instance numbers for better display
    private void AssignInstanceNumbers()
    {
        // Assign instance numbers for bonus rules
        var bonusGroups = SelectedBonusRules.GroupBy(r => r.RuleId);
        foreach (var group in bonusGroups)
        {
            var rules = group.OrderBy(r => r.PayrollAppliedRuleId ?? int.MaxValue).ToList();
            for (int i = 0; i < rules.Count; i++)
            {
                rules[i].InstanceNumber = i + 1;
            }
        }

        // Assign instance numbers for deduction rules
        var deductionGroups = SelectedDeductionRules.GroupBy(r => r.RuleId);
        foreach (var group in deductionGroups)
        {
            var rules = group.OrderBy(r => r.PayrollAppliedRuleId ?? int.MaxValue).ToList();
            for (int i = 0; i < rules.Count; i++)
            {
                rules[i].InstanceNumber = i + 1;
            }
        }
    }

    private void OnBaseSalaryChanged(decimal value, int workDays)
    {
        if (CurrentPayroll == null) return;

        CurrentPayroll.BaseSalary = value;
        var actualWorkDays = workDays;
        CurrentPayroll.DeductionPerAbsenceDay = Math.Round(value / actualWorkDays, 2);

        InvokeAsync(async () => await RefreshAdvanceDeductionSummary());
    }

    private Task OnManualAbsenceDaysChanged(int value)
    {
        CurrentPayroll.ManualAbsenceDays = value;
        RecalculateBonusesAndDeductions();
        return Task.CompletedTask;
    }

    private void OnAdvanceDeductionChanged(decimal value)
    {
        _isAdvanceAmountManuallySet = true;
        var maxAllowed = CurrentAdvanceDeductionSummary.MaximumDeductionAllowed;
        CurrentPayroll.AdvanceDeductionsAmounts = Math.Min(value, maxAllowed);
        RecalculateBonusesAndDeductions();
    }

    private async Task RefreshAdvanceDeductionSummary()
    {
        if (CurrentPayroll.EmployeeId > 0)
        {
            var preliminaryNetPay = CurrentPayroll.BaseSalary + CurrentPayroll.Bonus - CurrentPayroll.Deductions;
            CurrentAdvanceDeductionSummary = await PayrollService.GetAdvanceDeductionSummaryAsync(CurrentPayroll.EmployeeId, preliminaryNetPay); if (!_isAdvanceAmountManuallySet || CurrentPayroll.Id == 0)
            {
                CurrentPayroll.AdvanceDeductionsAmounts = CurrentAdvanceDeductionSummary.ProposedDeduction;
                CurrentAdvanceDeductionSummary.MaximumDeductionAllowed = CurrentAdvanceDeductionSummary.ProposedDeduction;
            }
            else
            {
                if (CurrentPayroll.AdvanceDeductionsAmounts > CurrentAdvanceDeductionSummary.MaximumDeductionAllowed)
                {
                    CurrentPayroll.AdvanceDeductionsAmounts = CurrentAdvanceDeductionSummary.MaximumDeductionAllowed;
                }
                CurrentAdvanceDeductionSummary.MaximumDeductionAllowed = CurrentAdvanceDeductionSummary.ProposedDeduction;
            }
            StateHasChanged();
        }
    }

    private void MarkAdvanceAsManuallySet(ChangeEventArgs e)
    {
        _isAdvanceAmountManuallySet = true;

        if (decimal.TryParse(e.Value?.ToString(), out var value))
        {
            var maxAllowed = CurrentAdvanceDeductionSummary.MaximumDeductionAllowed;

            if (value > maxAllowed)
                CurrentPayroll.AdvanceDeductionsAmounts = maxAllowed;
            else if (value < 0)
                CurrentPayroll.AdvanceDeductionsAmounts = 0;
            else
                CurrentPayroll.AdvanceDeductionsAmounts = value;
        }
    }

    private async Task OnPayrollPeriodChanged()
    {
        if (CurrentPayroll.PayrollStartDate.HasValue && CurrentPayroll.PayrollEndDate.HasValue)
        {
            if (CurrentPayroll.BaseSalary > 0)
            {
                var workingDays = workDaysPerMonth;
                CurrentPayroll.DeductionPerAbsenceDay = Math.Round(CurrentPayroll.BaseSalary / workDaysPerMonth, 2);
            }

            if (CurrentPayroll.EmployeeId > 0)
            {
                await RefreshAbsencesForPeriod();
            }
        }

        StateHasChanged();
    }

    private async Task OnPredefinedPeriodChanged(ChangeEventArgs e)
    {
        var selectedPeriod = e.Value?.ToString();
        var today = DateTime.Today;

        switch (selectedPeriod)
        {
            case "current_month":
                CurrentPayroll.PayrollStartDate = new DateTime(today.Year, today.Month, 1);
                CurrentPayroll.PayrollEndDate = CurrentPayroll.PayrollStartDate.Value.AddMonths(1).AddDays(-1);
                break;

            case "previous_month":
                var firstDayPrevMonth = new DateTime(today.Year, today.Month, 1).AddMonths(-1);
                CurrentPayroll.PayrollStartDate = firstDayPrevMonth;
                CurrentPayroll.PayrollEndDate = firstDayPrevMonth.AddMonths(1).AddDays(-1);
                break;

            case "last_30_days":
                CurrentPayroll.PayrollEndDate = today;
                CurrentPayroll.PayrollStartDate = today.AddDays(-29);
                break;

            case "current_quarter":
                var quarter = (today.Month - 1) / 3 + 1;
                CurrentPayroll.PayrollStartDate = new DateTime(today.Year, (quarter - 1) * 3 + 1, 1);
                CurrentPayroll.PayrollEndDate = CurrentPayroll.PayrollStartDate.Value.AddMonths(3).AddDays(-1);
                break;

            case "custom":
                break;

            default:
                return;
        }

        if (selectedPeriod != "custom")
        {
            await OnPayrollPeriodChanged();
        }
    }

    private async Task RefreshAbsencesForPeriod()
    {
        if (CurrentPayroll.PayrollStartDate.HasValue &&
            CurrentPayroll.PayrollEndDate.HasValue &&
            CurrentPayroll.EmployeeId > 0)
        {
            await LoadAbsenceDates(CurrentPayroll.EmployeeId,
                                 CurrentPayroll.PayrollStartDate.Value,
                                 CurrentPayroll.PayrollEndDate.Value);
            RecalculateBonusesAndDeductions();
            StateHasChanged();
        }
    }

    private int CalculateWorkingDays(DateTime startDate, DateTime endDate)
    {
        int workingDays = 0;
        for (var date = startDate; date <= endDate; date = date.AddDays(1))
        {
            if (date.DayOfWeek != DayOfWeek.Friday && date.DayOfWeek != DayOfWeek.Saturday)
            {
                workingDays++;
            }
        }
        return workingDays;
    }

    private void OnBonusRuleChanged(SelectableRule rule, bool isApplied)
    {
        rule.IsApplied = isApplied;

        if (isApplied && rule.IsCountable)
        {
            OnCountableQuantityChanged(rule, rule.Quantity > 0 ? rule.Quantity : 1);
        }
        else
        {
            RecalculateBonusesAndDeductions();
        }
    }

    private void OnDeductionRuleChanged(SelectableRule rule, bool isApplied)
    {
        rule.IsApplied = isApplied;

        if (isApplied && rule.IsCountable)
        {
            OnCountableQuantityChanged(rule, rule.Quantity > 0 ? rule.Quantity : 1);
