    // ⭐ UPDATED: EditPayroll now preserves the historical BaseSalary
    private async Task EditPayroll(Payroll payroll)
    {
        Console.WriteLine($"=== EDITING PAYROLL #{payroll.Id} ===");

        CurrentPayroll = new Payroll
        {
            Id = payroll.Id,
            EmployeeId = payroll.EmployeeId,
            PayDate = payroll.PayDate,
            PayrollStartDate = payroll.PayrollStartDate,
            PayrollEndDate = payroll.PayrollEndDate,
            BaseSalary = payroll.BaseSalary, // ⭐ Use the historical payroll salary
            Bonus = payroll.Bonus,
            Deductions = payroll.Deductions,
            DeductionPerAbsenceDay = payroll.DeductionPerAbsenceDay,
            ManualAbsenceDays = payroll.ManualAbsenceDays,
            AbsenceDeduction = payroll.AbsenceDeduction,
            AbsenceDays = payroll.AbsenceDays,
            Employee = payroll.Employee,
            Transaction = payroll.Transaction,
            Cash = payroll.Cash,
            TransactionIsManual = payroll.TransactionIsManual,
            AdvanceDeductionsAmounts = payroll.AdvanceDeductionsAmounts
        };

        Console.WriteLine($"Loaded payroll #{payroll.Id}:");
        Console.WriteLine($"  Payroll.BaseSalary (historical): {CurrentPayroll.BaseSalary}");
        Console.WriteLine($"  Employee.BaseSalary (current): {CurrentPayroll.Employee?.BaseSalary}");

        var employee = Employees.FirstOrDefault(e => e.Id == payroll.EmployeeId);
        var jobTitleId = employee?.JobTitleId;

        if (jobTitleId != null)
        {
            var appliedRules = payroll.AppliedRules ?? new List<PayrollAppliedRule>();

            var bonusRules = AllAdjustmentRules
                .Where(r => r.Type == AdjustmentType.Bonus && r.JobTitles.Any(j => j.Id == jobTitleId))
                .ToList();

            var deductionRules = AllAdjustmentRules
                .Where(r => r.Type == AdjustmentType.Deduction && r.JobTitles.Any(j => j.Id == jobTitleId))
                .ToList();

            // --- BONUS RULES ---
            SelectedBonusRules = appliedRules
                .Where(r => r.Rule.Type == AdjustmentType.Bonus)
                .Select(r => new SelectableRule(r, workDaysPerMonth))
                .ToList();

            var usedBonusRuleIds = SelectedBonusRules.Select(r => r.RuleId).ToHashSet();

            // Only include non-applied and NOT auto-applied rules
            SelectedBonusRules.AddRange(
                bonusRules
                    .Where(r => !usedBonusRuleIds.Contains(r.Id) && !r.AutoApplied)
                    .Select(r => new SelectableRule(r, workDaysPerMonth, false, CurrentPayroll.BaseSalary))
            );

            // --- DEDUCTION RULES ---
            SelectedDeductionRules = appliedRules
                .Where(r => r.Rule.Type == AdjustmentType.Deduction)
                .Select(r => new SelectableRule(r, workDaysPerMonth))
                .ToList();

            var usedDeductionRuleIds = SelectedDeductionRules.Select(r => r.RuleId).ToHashSet();

            // Only include non-applied and NOT auto-applied rules
            SelectedDeductionRules.AddRange(
                deductionRules
                    .Where(r => !usedDeductionRuleIds.Contains(r.Id) && !r.AutoApplied)
                    .Select(r => new SelectableRule(r, workDaysPerMonth, false, CurrentPayroll.BaseSalary))
            );
        }
        else
        {
            Console.WriteLine("Job title not found for the selected employee.");
            SelectedBonusRules = new List<SelectableRule>();
            SelectedDeductionRules = new List<SelectableRule>();
        }

        await LoadPreappliedRules(payroll.EmployeeId);
        await LoadPayrollAbsences(CurrentPayroll.Id);
        await RefreshAdvanceDeductionSummary();
        _isAdvanceAmountManuallySet = false;

        IsPrintModalOpen = false;
        IsModalOpen = true;
        StateHasChanged();
    }

    private async Task SavePayroll()
    {
        Console.WriteLine("=== SavePayroll ===");
        Console.WriteLine($"Payroll #{CurrentPayroll.Id}, Employee: {CurrentPayroll.EmployeeId}");
        Console.WriteLine($"Saving with BaseSalary: {CurrentPayroll.BaseSalary}");
        Console.WriteLine($"Employee's current salary: {CurrentPayroll.Employee?.BaseSalary}");

        var updatedRules = SelectedBonusRules
            .Where(r => r.IsApplied)
            .Concat(SelectedDeductionRules.Where(r => r.IsApplied))
            .Concat(PreappliedBonusRules.Where(r => r.IsApplied))
            .Concat(PreappliedDeductionRules.Where(r => r.IsApplied))
            .ToList();

        var finalAppliedRules = new List<PayrollAppliedRule>();

        foreach (var rule in updatedRules)
        {
            finalAppliedRules.Add(new PayrollAppliedRule
            {
                RuleId = rule.RuleId,
                Amount = rule.Amount,
                Quantity = rule.Quantity,
                EmployeeId = CurrentPayroll.EmployeeId,
                PayrollId = CurrentPayroll.Id,
                Date = rule.Date,
                Notes = rule.note
            });
        }

        CurrentPayroll.AppliedRules = finalAppliedRules;

        // ⭐ UPDATED: Use CurrentPayroll.BaseSalary instead of Employee.BaseSalary
        CurrentPayroll.DeductionPerAbsenceDay = Math.Round(CurrentPayroll.BaseSalary / workDaysPerMonth, 2);

        Console.WriteLine($"Final DeductionPerAbsenceDay: {CurrentPayroll.DeductionPerAbsenceDay}");
        Console.WriteLine($"Before save - Payroll.BaseSalary: {CurrentPayroll.BaseSalary}");

        if (CurrentPayroll.Id == 0)
        {
            Console.WriteLine("Creating new payroll...");
            CurrentPayroll = await PayrollService.CreateAsync(CurrentPayroll);
        }
        else
        {
            Console.WriteLine("Updating existing payroll...");
            await PayrollService.UpdateAsync(CurrentPayroll);
        }

        Console.WriteLine($"After save - Payroll.BaseSalary: {CurrentPayroll.BaseSalary}");
        Console.WriteLine($"Employee.BaseSalary remains: {CurrentPayroll.Employee?.BaseSalary}");

        if (CurrentPayroll.AdvanceDeductionsAmounts > 0)
        {
            await PayrollService.ProcessAdvanceDeductionsForPayrollAsync(CurrentPayroll);
        }

        if (!UseManualAbsences)
        {
            foreach (var abs in EmployeeAbsences.Where(a => a.Counted))
            {
                abs.PayrollId = CurrentPayroll.Id;
                await AbsenceService.UpdateAsync(abs);
            }
        }

        IsModalOpen = false;
        await LoadPayrolls();
        Console.WriteLine("=== Payroll saved successfully ===");
    }

