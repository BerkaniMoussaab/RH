                                                            {
                                                                <span class="text-muted ms-1">(@rule.Amount %)</span>
                                                            }
                                                            @if (rule.AutoApplied)
                                                            {
                                                                <span class="text-muted ms-1 fst-italic" title="Règle appliquée automatiquement">(Auto)</span>
                                                            }
                                                            @if (rule.PayrollAppliedRuleId.HasValue)
                                                            {
                                                                <span class="text-muted ms-1 fst-italic" title="DB ID: @rule.PayrollAppliedRuleId">(DB:#@rule.PayrollAppliedRuleId)</span>
