                                    </div>

                                    <div class="mt-3">
                                        @if (IsAddingBonusRule)
                                        {
                                            <div class="add-rule-form p-3 border rounded bg-light">
                                                <h6>Ajouter une prime</h6>
                                                <div class="mb-3">
                                                    <label class="form-label">Sélectionner une règle:</label>
                                                    <select class="form-select" @bind="SelectedBonusRuleToAdd">
                                                        <option value="">-- Choisir une règle --</option>
                                                        @foreach (var rule in AvailableBonusRules)
                                                        {
