    private async Task OnEmployeeChanged(int employeeId)
    {
        SelectedBonusRules.Clear();
        SelectedDeductionRules.Clear();
        CurrentPayroll.BaseSalary = 0;
        CurrentAdvanceDeductionSummary = new AdvanceDeductionSummary();
        _isAdvanceAmountManuallySet = false;

        var employee = Employees.FirstOrDefault(e => e.Id == employeeId);
        if (employee == null) return;

        CurrentPayroll.EmployeeId = employeeId;
        CurrentPayroll.Employee = employee;

        var lastPayroll = await PayrollService.GetLastPayrollForEmployeeAsync(employeeId);
        var lastBaseSalary = lastPayroll?.BaseSalary ?? 0;
        CurrentPayroll.BaseSalary = lastBaseSalary;
        CurrentPayroll.Transaction = lastPayroll?.Transaction ?? 0;

        if (employee.JobTitleId is int jobTitleId)
        {
            var allJobTitleBonusRules = AllAdjustmentRules
                .Where(r => r.Type == AdjustmentType.Bonus && r.JobTitles.Any(j => j.Id == jobTitleId))
                .ToList();
            var allJobTitleDeductionRules = AllAdjustmentRules
                .Where(r => r.Type == AdjustmentType.Deduction && r.JobTitles.Any(j => j.Id == jobTitleId))
                .ToList();

            // REVISED: Use the GetAppliedRulesForEmployeeAsync that now fetches rules from last payroll AND unassigned rules
            var appliedRules = await PayrollService.GetAppliedRulesForEmployeeAsync(employeeId);

            SelectedBonusRules = new List<SelectableRule>();
            SelectedDeductionRules = new List<SelectableRule>();

            // Process bonus rules
            foreach (var rule in allJobTitleBonusRules)
            {
                // Find all applied instances of this rule (from last payroll or unassigned)
                var appliedInstances = appliedRules.Where(a => a.RuleId == rule.Id).ToList();

                if (appliedInstances.Any())
                {
                    // Add each applied instance as a separate SelectableRule
                    foreach (var appliedInstance in appliedInstances)
                    {
                        SelectedBonusRules.Add(new SelectableRule(appliedInstance, workDaysPerMonth, lastBaseSalary));
                    }
                }
                else if (rule.AutoApplied)
                {
                    // Add auto-applied rule if not found in applied rules
                    SelectedBonusRules.Add(new SelectableRule(rule, workDaysPerMonth, isApplied: true));
                }
                else
                {
                    // Add as available but not applied
                    SelectedBonusRules.Add(new SelectableRule(rule, workDaysPerMonth, isApplied: false));
                }
            }

            // Process deduction rules
            foreach (var rule in allJobTitleDeductionRules)
            {
                // Find all applied instances of this rule (from last payroll or unassigned)
                var appliedInstances = appliedRules.Where(a => a.RuleId == rule.Id).ToList();

                if (appliedInstances.Any())
                {
                    // Add each applied instance as a separate SelectableRule
                    foreach (var appliedInstance in appliedInstances)
                    {
                        SelectedDeductionRules.Add(new SelectableRule(appliedInstance, workDaysPerMonth, lastBaseSalary));
                    }
                }
                else if (rule.AutoApplied)
                {
                    // Add auto-applied rule if not found in applied rules
                    SelectedDeductionRules.Add(new SelectableRule(rule, workDaysPerMonth, isApplied: true));
                }
                else
                {
                    // Add as available but not applied
                    SelectedDeductionRules.Add(new SelectableRule(rule, workDaysPerMonth, isApplied: false));
                }
            }

            LoadAvailableRules(jobTitleId);
        }

        // CRITICAL: Assign instance numbers for proper display
        AssignInstanceNumbers();

        if (CurrentPayroll.BaseSalary != 0)
        {
            CurrentPayroll.DeductionPerAbsenceDay = Math.Round(CurrentPayroll.BaseSalary / workDaysPerMonth, 2);
        }

        if (CurrentPayroll.PayrollStartDate.HasValue && CurrentPayroll.PayrollEndDate.HasValue)
        {
            await LoadAbsenceDates(employeeId, CurrentPayroll.PayrollStartDate.Value, CurrentPayroll.PayrollEndDate.Value);
        }

        await RefreshAdvanceDeductionSummary();

        RecalculateBonusesAndDeductions();
        StateHasChanged();
    }

    private void LoadAvailableRules(int jobTitleId)
    {
        AvailableBonusRules = AllAdjustmentRules
            .Where(r => r.Type == AdjustmentType.Bonus && r.JobTitles.Any(j => j.Id == jobTitleId))
            .ToList();

        AvailableDeductionRules = AllAdjustmentRules
            .Where(r => r.Type == AdjustmentType.Deduction && r.JobTitles.Any(j => j.Id == jobTitleId))
            .ToList();
    }

    private void OnCountableQuantityChanged(SelectableRule rule, decimal? quantity)
    {
        var finalQuantity = quantity ?? 1;
        rule.Quantity = finalQuantity;

        if (rule.IsCountable)
        {
            var unitAmount = rule.IsPercentage ? CurrentPayroll.BaseSalary * rule.Amount / 100 : rule.Amount;
            rule.CalculatedAmount = unitAmount * finalQuantity;
        }
        else
        {
            rule.CalculatedAmount = rule.IsPercentage ? CurrentPayroll.BaseSalary * rule.Amount / 100 : rule.Amount;
        }

        RecalculateBonusesAndDeductions();
    }

    private void OnAmountChanged(SelectableRule rule, decimal? newAmount)
    {
        rule.Amount = newAmount ?? 0;

        if (!rule.IsCountable)
        {
            rule.Quantity = 1;
        }

        OnCountableQuantityChanged(rule, rule.Quantity);
    }

    // Bonus rule management methods
    private void StartAddBonusRule()
    {
        IsAddingBonusRule = true;
        SelectedBonusRuleToAdd = 0;
    }

    private void CancelAddBonusRule()
    {
        IsAddingBonusRule = false;
        SelectedBonusRuleToAdd = 0;
    }

    private void ConfirmAddBonusRule()
    {
        if (SelectedBonusRuleToAdd > 0)
        {
            var ruleToAdd = AvailableBonusRules.FirstOrDefault(r => r.Id == SelectedBonusRuleToAdd);
            if (ruleToAdd != null)
            {
                var newSelectableRule = new SelectableRule(ruleToAdd, workDaysPerMonth, isApplied: true);
                SelectedBonusRules.Add(newSelectableRule);
                AssignInstanceNumbers();
                RecalculateBonusesAndDeductions();
            }
        }
        IsAddingBonusRule = false;
        SelectedBonusRuleToAdd = 0;
    }

    private void RemoveBonusRule(Guid ruleInstanceId)
    {
        var ruleToRemove = SelectedBonusRules.FirstOrDefault(r => r.Id == ruleInstanceId);
        if (ruleToRemove != null)
        {
            SelectedBonusRules.Remove(ruleToRemove);
            AssignInstanceNumbers();
            RecalculateBonusesAndDeductions();
