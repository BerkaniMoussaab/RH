    public class SelectableRule
    {
        public int RuleId { get; set; }
        public string Name { get; set; }
        public decimal Amount { get; set; }
        public bool IsPercentage { get; set; }
        public bool IsCountable { get; set; }
        public bool IsApplied { get; set; } = true;
        public decimal Quantity { get; set; } = 1;
        public bool IsEditable { get; set; } = false;
        public decimal CalculatedAmount { get; set; }
        public int WorkDays { get; set; }
        public bool AutoApplied { get; set; }
        public string note { get; set; }
        public DateTime? Date { get; set; }

        /// <summary>
        /// Constructor for applied rule (from database)
        /// </summary>
        public SelectableRule(PayrollAppliedRule appliedRule, int workDaysPerMonth)
        {
            RuleId = appliedRule.RuleId;
            Name = appliedRule.Rule.Name;
            Amount = appliedRule.Amount;
            IsPercentage = appliedRule.Rule.IsPercentage;
            IsCountable = appliedRule.Rule.IsCountable;
            AutoApplied = appliedRule.Rule.AutoApplied;
            IsApplied = true;
            IsEditable = appliedRule.Rule.IsEditable;
            Quantity = appliedRule.Quantity ?? 1;
            WorkDays = workDaysPerMonth;
            note = appliedRule.Notes;
            Date = appliedRule.Date;

            // ⭐ CRITICAL: Use the payroll's BaseSalary, not employee's current salary
            decimal baseSalary = appliedRule.Payroll?.BaseSalary ?? 0;

            Console.WriteLine($"SelectableRule from applied rule '{Name}':");
            Console.WriteLine($"  Payroll.BaseSalary: {baseSalary}");
            Console.WriteLine($"  Payroll ID: {appliedRule.Payroll?.Id}");

            // Calculate amount based on payroll's historical salary
            if (IsCountable)
            {
                var unitAmount = IsPercentage ? baseSalary * Amount / 100 : Amount;
                CalculatedAmount = unitAmount * Quantity;
            }
            else
            {
                CalculatedAmount = IsPercentage ? baseSalary * Amount / 100 : Amount;
            }
        }

        /// <summary>
        /// Constructor for default rules (not yet applied)
        /// </summary>
        public SelectableRule(PayrollAdjustmentRule rule, int workDaysPerMonth, bool isApplied = false, decimal? payrollBaseSalary = null)
        {
            RuleId = rule.Id;
            Name = rule.Name;
            Amount = rule.Amount;
            IsPercentage = rule.IsPercentage;
            IsCountable = rule.IsCountable;
            IsEditable = rule.IsEditable;
            IsApplied = isApplied;
            Quantity = 1;
            WorkDays = workDaysPerMonth;
            AutoApplied = rule.AutoApplied;

            // ⭐ Use the provided payroll base salary (from CurrentPayroll.BaseSalary)
            decimal baseSalary = payrollBaseSalary ?? 0;

            Console.WriteLine($"SelectableRule from adjustment rule '{Name}':");
            Console.WriteLine($"  BaseSalary provided: {baseSalary}");
            Console.WriteLine($"  IsPercentage: {IsPercentage}");
            Console.WriteLine($"  IsCountable: {IsCountable}");

            if (IsCountable)
            {
                var unitAmount = IsPercentage ? baseSalary * Amount / 100 : Amount;
                CalculatedAmount = unitAmount * Quantity;
            }
            else
            {
                CalculatedAmount = IsPercentage ? baseSalary * Amount / 100 : Amount;
            }
        }
    }
