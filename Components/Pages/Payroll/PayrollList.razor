@page "/payrolls"

@using Microsoft.AspNetCore.Authorization
@using RH.Models
@using RH.Services
@using System.Text.Json
@inject PayrollService PayrollService
@inject IEmployeeService EmployeeService
@inject PayrollAdjustmentRuleService AdjustmentService
@inject AbsenceService AbsenceService
@inject WorkedDaysOffService WorkedDaysOffService
@inject IJSRuntime JS
@attribute [Authorize]

<PageTitle>Fiches de paie</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white rounded shadow-sm">
    <h2 class="text-primary fw-bold mb-0">
        <i class="bi bi-cash-coin me-2"></i> Fiches de paie
    </h2>
    <button class="btn btn-success px-4" @onclick="async () => await AddPayroll()">
        <i class="bi bi-plus-circle me-2"></i> Nouvelle fiche
    </button>
</div>

@if (Payrolls is null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">Chargement...</span>
        </div>
        <p class="mt-3 text-muted">Chargement des fiches de paie...</p>
    </div>
}
else if (!Payrolls.Any())
{
    <div class="alert alert-info text-center">
        <i class="bi bi-info-circle me-2"></i> Aucune fiche de paie disponible.
    </div>
}
else
{
    <div class="table-responsive shadow-sm">
        <table class="table table-striped table-hover align-middle bg-white rounded">
            <thead class="table-light text-center">
                <tr>
                    <th>Code</th>
                    <th>Employé</th>
                    <th>Période de paie</th>
                    <th>Date de paiement</th>
                    <th>Salaire de base</th>
                    <th>Primes</th>
                    <th>Retenues</th>
                    <th>Net à payer</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payroll in Payrolls)
                {
                    <tr>
                        <td class="text-center fw-semibold">#@payroll.Id</td>
                        <td>@payroll.Employee?.FullName</td>
                        <td class="text-center">
                            @if (payroll.PayrollStartDate.HasValue && payroll.PayrollEndDate.HasValue)
                            {
                                <span class="badge bg-info">
                                    @payroll.PayrollStartDate.Value.ToString("dd/MM") - @payroll.PayrollEndDate.Value.ToString("dd/MM/yyyy")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Non définie</span>
                            }
                        </td>
                        <td class="text-center">@payroll.PayDate.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">@payroll.BaseSalary.ToString("C")</td>
                        <td class="text-end text-success">
                            <span class="fw-semibold">+@payroll.Bonus.ToString("C")</span>
                        </td>
                        <td class="text-end text-danger">
                            <span class="fw-semibold">-@payroll.Deductions.ToString("C")</span>
                        </td>
                        <td class="text-end fw-bold text-primary">@payroll.NetPay.ToString("C")</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-secondary me-1" title="Modifier"
                                    @onclick="() => EditPayroll(payroll)">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" title="Supprimer"
                                    @onclick="() => DeletePayroll(payroll.Id)">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (IsModalOpen)
{
    <EditForm Model="CurrentPayroll" OnValidSubmit="SavePayroll">
        <DataAnnotationsValidator />
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content rounded-4 shadow border-primary enhanced-modal">

                    <!-- Enhanced Header -->
                    <div class="modal-header bg-primary text-white enhanced-header">
                        <div class="d-flex align-items-center">
                            <div>
                                <h5 class="modal-title mb-1 fw-bold">
                                    <i class="bi bi-cash-coin me-2"></i>
                                    @((CurrentPayroll.Id == 0)
                                        ? "Ajouter une fiche de paie"
                                        : $"Modifier la fiche de paie (ID: {CurrentPayroll.Id})")
                                </h5>
                            </div>
                        </div>
                        <button type="button" class="btn-close btn-close-white enhanced-close-btn" @onclick="CloseModal"></button>
                    </div>

                    <div class="modal-body enhanced-body">
                        <div class="row g-3">
                            <!-- Section Informations Employé et Période -->
                            <div class="col-12">
                                <div class="info-section">
                                    <div class="section-title">
                                        <i class="bi bi-person-badge text-primary me-2"></i>
                                        <span>Informations de l'employé et période de paie</span>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <div class="enhanced-form-group">
                                                <label class="form-label fw-semibold">
                                                    <i class="bi bi-person me-1"></i>Employé
                                                </label>
                                                <InputSelect class="form-select enhanced-select" @bind-Value="CurrentEmployeeId">
                                                    <option value="">-- Sélectionner un employé --</option>
                                                    @foreach (var emp in Employees)
                                                    {
                                                        <option value="@emp.Id">@emp.FullName</option>
                                                    }
                                                </InputSelect>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="enhanced-form-group">
                                                <label class="form-label fw-semibold">
                                                    <i class="bi bi-calendar-event me-1"></i>Date de paiement
                                                </label>
                                                <InputDate class="form-control enhanced-input" @bind-Value="CurrentPayroll.PayDate" />
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Enhanced Date Interval Selection Section -->
                                    <div class="row g-3 mt-2">
                                        <div class="col-12">
                                            <div class="payroll-period-section">
                                                <div class="section-subtitle">
                                                    <i class="bi bi-calendar-range text-info me-2"></i>
                                                    <span>Période de paie</span>
                                                    <small class="text-muted ms-2">(Définit la période pour le calcul des absences et primes)</small>
                                                </div>

                                                <div class="row g-3 mt-2">
                                                    <div class="col-md-3">
                                                        <div class="enhanced-form-group">
                                                            <label class="form-label fw-semibold">
                                                                <i class="bi bi-calendar-check me-1"></i>Date de début
                                                            </label>
                                                            <InputDate class="form-control enhanced-input"
                                                                       @bind-Value="CurrentPayroll.PayrollStartDate"
                                                                       @onchange="OnPayrollPeriodChanged" />
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <div class="enhanced-form-group">
                                                            <label class="form-label fw-semibold">
                                                                <i class="bi bi-calendar-x me-1"></i>Date de fin
                                                            </label>
                                                            <InputDate class="form-control enhanced-input"
                                                                       @bind-Value="CurrentPayroll.PayrollEndDate"
                                                                       @onchange="OnPayrollPeriodChanged" />
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <div class="enhanced-form-group">
                                                            <label class="form-label fw-semibold">Période prédéfinie</label>
                                                            <select class="form-select enhanced-select" @onchange="OnPredefinedPeriodChanged">
                                                                <option value="">-- Sélectionner --</option>
                                                                <option value="current_month">Mois en cours</option>
                                                                <option value="previous_month">Mois précédent</option>
                                                                <option value="last_30_days">30 derniers jours</option>
                                                                <option value="current_quarter">Trimestre en cours</option>
                                                                <option value="custom">Personnalisé</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3 ">
                                                        <label class="form-label fw-semibold"> </label>
                                                        <button type="button" class="btn btn-outline-info w-100"
                                                                @onclick="RefreshAbsencesForPeriod"
                                                                disabled="@(!CurrentPayroll.PayrollStartDate.HasValue || !CurrentPayroll.PayrollEndDate.HasValue || CurrentPayroll.EmployeeId == 0)">
                                                            <i class="bi bi-arrow-clockwise me-1"></i>
                                                            Actualiser les absences
                                                        </button>
                                                    </div>
                                                </div>

                                                @if (CurrentPayroll.PayrollStartDate.HasValue && CurrentPayroll.PayrollEndDate.HasValue)
                                                {
                                                    <div class="period-summary mt-3 p-3 bg-light rounded">
                                                        <div class="row">
                                                            <div class="col-md-4">
                                                                <strong>Période sélectionnée:</strong><br>
                                                                <span class="text-primary">
                                                                    @CurrentPayroll.PayrollStartDate.Value.ToString("dd/MM/yyyy")
                                                                    au
                                                                    @CurrentPayroll.PayrollEndDate.Value.ToString("dd/MM/yyyy")
                                                                </span>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <strong>Durée:</strong><br>
                                                                <span class="text-info">
                                                                    @((CurrentPayroll.PayrollEndDate.Value - CurrentPayroll.PayrollStartDate.Value).Days + 1) jours
                                                                </span>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <strong>Jours ouvrables:</strong><br>
                                                                <span class="text-success">
                                                                    @CalculateWorkingDays(CurrentPayroll.PayrollStartDate.Value, CurrentPayroll.PayrollEndDate.Value) jours
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Section Salaire -->
                            <div class="col-md-6">
                                <div class="salary-section">
                                    <div class="section-title">
                                        <i class="bi bi-currency-dollar text-success me-2"></i>
                                        <span>Salaire de base</span>
                                    </div>
                                    <div class="enhanced-form-group">
                                        <InputNumber TValue="decimal"
                                                     class="form-control enhanced-input salary-input"
                                                     Value="CurrentPayroll.BaseSalary"
                                                     ValueChanged="@(value => OnBaseSalaryChanged(value, WorkDays))"
                                                     ValueExpression="@(() => CurrentPayroll.BaseSalary)" />

                                        <small class="text-muted mt-1 d-flex align-items-center">
                                            <i class="bi bi-info-circle me-1"></i>
                                            Récupéré depuis la dernière fiche de paie
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <!-- Section Mode d'absence -->
                            <div class="col-md-6">
                                <div class="absence-mode-section">
                                    <div class="section-title">
                                        <i class="bi bi-gear text-warning me-2"></i>
                                        <span>Mode de saisie des absences</span>
                                    </div>
                                    <div class="enhanced-form-group">
                                        <select class="form-select enhanced-select" @onchange="OnAbsenceModeChanged">
                                            @if (CurrentPayroll.ManualAbsenceDays != 0)
                                            {
                                                <option value="true">Saisie manuelle</option>
                                                <option value="false">Utiliser les absences enregistrées</option>
                                            }
                                            else
                                            {
                                                <option value="false">Utiliser les absences enregistrées</option>
                                                <option value="true">Saisie manuelle</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Section Retenue par jour -->
                            <div class="col-md-6">
                                <div class="deduction-info">
                                    <div class="section-title">
                                        <i class="bi bi-calculator text-info me-2"></i>
                                        <span>Retenue par jour d'absence</span>
                                        <i class="bi bi-info-circle ms-1 text-muted"
                                           title="Montant appliqué automatiquement : salaire de base / jours ouvrables de la période."></i>
                                    </div>
                                    <div class="enhanced-form-group">
                                        <InputNumber TValue="decimal"
                                                     class="form-control enhanced-input"
                                                     Value="CurrentPayroll.DeductionPerAbsenceDay"
                                                     ValueExpression="@(() => CurrentPayroll.DeductionPerAbsenceDay)"
                                                     Disabled="true" />
                                        <small class="text-muted">Calculé automatiquement</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Section Absences -->
                            <div class="col-md-6">
                                <div class="absence-section">
                                    <div class="section-title">
                                        <i class="bi bi-calendar-x text-warning me-2"></i>
                                        <span>Absences</span>
                                        @if (CurrentPayroll.PayrollStartDate.HasValue && CurrentPayroll.PayrollEndDate.HasValue)
                                        {
                                            <small class="text-muted ms-2">
                                                (Période: @CurrentPayroll.PayrollStartDate.Value.ToString("dd/MM") - @CurrentPayroll.PayrollEndDate.Value.ToString("dd/MM"))
                                            </small>
                                        }
                                    </div>

                                    @if (UseManualAbsences || CurrentPayroll.ManualAbsenceDays != 0)
                                    {
                                        <div class="enhanced-form-group">
                                            <label class="form-label">Nombre de jours d'absence (manuel)</label>
                                            <InputNumber TValue="int"
                                                         class="form-control enhanced-input"
                                                         Value="CurrentPayroll.ManualAbsenceDays"
                                                         ValueChanged="OnManualAbsenceDaysChanged"
                                                         ValueExpression="@(() =>CurrentPayroll.ManualAbsenceDays)" />
                                        </div>
                                    }

                                    @if (EmployeeAbsences.Any())
                                    {
                                        <div class="absence-table-wrapper mb-3">
                                            <div class="table-responsive" style="max-height: 200px; overflow-y: auto;">
                                                <table class="table table-bordered table-sm enhanced-table">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th style="width: 25%;">Date</th>
                                                            <th>Motif</th>
                                                            <th style="width: 100px;" class="text-center">Comptée</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var a in EmployeeAbsences)
                                                        {
                                                            <tr class="@(a.Counted ? "table-warning" : "")">
                                                                <td class="fw-medium">@a.Date.ToString("dd/MM/yyyy")</td>
                                                                <td>
                                                                    <InputText class="form-control form-control-sm border-0" @bind-Value="a.Reason" Disabled />
                                                                </td>
                                                                <td class="text-center">
                                                                    <InputCheckbox class="form-check-input enhanced-checkbox"
                                                                                   Value="a.Counted"
                                                                                   ValueChanged="GetCountedChangedCallback(a)"
                                                                                   ValueExpression="@(() => a.Counted)" />
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="empty-state">
                                            <i class="bi bi-calendar-check text-muted"></i>
                                            <span class="text-muted">
                                                @if (CurrentPayroll.PayrollStartDate.HasValue && CurrentPayroll.PayrollEndDate.HasValue)
                                                {
                                                    <text>Aucune absence enregistrée pour cette période.</text>
                                                }
                                                else
                                                {
                                                    <text>Veuillez définir une période de paie pour voir les absences.</text>
                                                }
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Section PRIMES -->
                            <div class="col-md-6">
                                <div class="bonus-section">
                                    <div class="section-title bonus-title">
                                        <i class="bi bi-plus-circle text-success me-2"></i>
                                        <span>Primes</span>
                                        <span class="badge bg-success ms-auto">+@CurrentPayroll.Bonus.ToString("N2") DA</span>
                                    </div>

                                    <div class="bonus-rules-container">
                                        @foreach (var rule in SelectedBonusRules)
                                        {
                                            <div class="bonus-rule-item @(rule.IsApplied ? "active" : "")">
                                                <div class="d-flex align-items-center justify-content-between">
                                                    <div class="d-flex align-items-center flex-grow-1 me-2">
                                                        <InputCheckbox class="form-check-input enhanced-checkbox me-2"
                                                                       Value="rule.IsApplied"
                                                                       ValueChanged="val => OnBonusRuleChanged(rule, val)"
                                                                       ValueExpression="@(() => rule.IsApplied)" />
                                                        <label class="form-check-label mb-0 rule-label">
                                                            @rule.Name
                                                            @if (!rule.IsPercentage && rule.Amount > 0)
                                                            {
                                                                <span class="text-muted ms-1">(@rule.Amount.ToString("C"))</span>
                                                            }
                                                            else if (rule.IsPercentage)
                                                            {
                                                                <span class="text-muted ms-1">(@rule.Amount %)</span>
                                                            }
                                                        </label>
                                                    </div>

                                                    @if (rule.IsApplied)
                                                    {
                                                        <div class="rule-controls">
                                                            @if (rule.IsEditable)
                                                            {
                                                                <InputNumber TValue="decimal"
                                                                             class="form-control form-control-sm enhanced-input-sm"
                                                                             Value="rule.Amount"
                                                                             ValueChanged="val => OnAmountChanged(rule, val)"
                                                                             ValueExpression="@(() => rule.Amount)" />
                                                            }

                                                            @if (rule.IsCountable)
                                                            {
                                                                <InputNumber TValue="decimal"
                                                                             class="form-control form-control-sm enhanced-input-sm"
                                                                             Value="rule.Quantity"
                                                                             ValueChanged="val => OnCountableQuantityChanged(rule, val)"
                                                                             ValueExpression="@(() => rule.Quantity)" />
                                                            }

                                                            <div class="calculated-amount success">
                                                                @rule.CalculatedAmount.ToString("N2") DA
                                                            </div>

                                                            @if (!rule.IsEditable && !rule.IsCountable)
                                                            {
                                                                <small class="text-muted ms-1 fst-italic">Montant fixe</small>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Section RETENUES -->
                            <div class="col-md-6">
                                <div class="deduction-section">
                                    <div class="section-title deduction-title">
                                        <i class="bi bi-dash-circle text-danger me-2"></i>
                                        <span>Retenues</span>
                                        <span class="badge bg-danger ms-auto">-@CurrentPayroll.Deductions.ToString("N2") DA</span>
                                    </div>

                                    <div class="deduction-rules-container">
                                        @foreach (var rule in SelectedDeductionRules)
                                        {
                                            <div class="deduction-rule-item @(rule.IsApplied ? "active" : "")">
                                                <div class="d-flex align-items-center justify-content-between">
                                                    <div class="d-flex align-items-center flex-grow-1 me-2">
                                                        <InputCheckbox class="form-check-input enhanced-checkbox me-2"
                                                                       Value="rule.IsApplied"
                                                                       ValueChanged="val => OnDeductionRuleChanged(rule, val)"
                                                                       ValueExpression="@(() => rule.IsApplied)" />
                                                        <label class="form-check-label mb-0 rule-label">
                                                            @rule.Name
                                                            @if (!rule.IsPercentage && rule.Amount > 0)
                                                            {
                                                                <span class="text-muted ms-1">(@rule.Amount:N2 DA)</span>
                                                            }
                                                            else if (rule.IsPercentage)
                                                            {
                                                                <span class="text-muted ms-1">(@rule.Amount %)</span>
                                                            }
                                                        </label>
                                                    </div>

                                                    @if (rule.IsApplied)
                                                    {
                                                        <div class="rule-controls">
                                                            @if (rule.IsEditable)
                                                            {
                                                                <InputNumber TValue="decimal"
                                                                             class="form-control form-control-sm enhanced-input-sm"
                                                                             Value="rule.Amount"
                                                                             ValueChanged="val => OnAmountChanged(rule, val)"
                                                                             ValueExpression="@(() => rule.Amount)" />
                                                            }

                                                            @if (rule.IsCountable)
                                                            {
                                                                <InputNumber TValue="decimal"
                                                                             class="form-control form-control-sm enhanced-input-sm"
                                                                             Value="rule.Quantity"
                                                                             ValueChanged="val => OnCountableQuantityChanged(rule, val)"
                                                                             ValueExpression="@(() => rule.Quantity)" />
                                                            }

                                                            <div class="calculated-amount danger">
                                                                @rule.CalculatedAmount.ToString("N2") DA
                                                            </div>

                                                            @if (!rule.IsEditable && !rule.IsCountable)
                                                            {
                                                                <small class="text-muted ms-1 fst-italic">Montant fixe</small>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Section Résumé -->
                            <div class="col-12">
                                <div class="summary-section">
                                    <div class="section-title">
                                        <i class="bi bi-calculator text-info me-2"></i>
                                        <span>Résumé des calculs</span>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <div class="summary-card">
                                                <label class="form-label fw-semibold">Total primes</label>
                                                <InputNumber class="form-control enhanced-input summary-input success" @bind-Value="CurrentPayroll.Bonus" Disabled />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="summary-card">
                                                <label class="form-label fw-semibold">Total retenues</label>
                                                <InputNumber class="form-control enhanced-input summary-input danger" @bind-Value="CurrentPayroll.Deductions" Disabled />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="summary-card">
                                                <label class="form-label fw-semibold">Net à payer</label>
                                                <div class="form-control enhanced-input summary-input primary fw-bold">
                                                    @((CurrentPayroll.BaseSalary + CurrentPayroll.Bonus - CurrentPayroll.Deductions).ToString("C"))
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Section Mode de paiement -->
                            <div class="col-12">
                                <div class="payment-section">
                                    <div class="section-title">
                                        <i class="bi bi-credit-card text-primary me-2"></i>
                                        <span>Mode de paiement</span>
                                    </div>

                                    <div class="payment-mode-wrapper">
                                        <InputRadioGroup @bind-Value="CurrentPayroll.TransactionIsManual">
                                            <div class="payment-options">
                                                <div class="payment-option">
                                                    <InputRadio class="form-check-input" Value="true" />
                                                    <label class="form-check-label">
                                                        <i class="bi bi-credit-card me-2"></i>
                                                        Saisir Transaction
                                                    </label>
                                                </div>
                                                <div class="payment-option">
                                                    <InputRadio class="form-check-input" Value="false" />
                                                    <label class="form-check-label">
                                                        <i class="bi bi-cash me-2"></i>
                                                        Saisir Cash
                                                    </label>
                                                </div>
                                            </div>
                                        </InputRadioGroup>
                                    </div>

                                    <div class="row g-3 mt-3">
                                        @if (CurrentPayroll.TransactionIsManual)
                                        {
                                            <div class="col-md-6">
                                                <div class="enhanced-form-group">
                                                    <label class="form-label fw-semibold">
                                                        <i class="bi bi-credit-card me-1"></i>Transaction
                                                    </label>
                                                    <InputNumber @bind-Value="CurrentPayroll.Transaction" class="form-control enhanced-input" />
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="calculated-field-wrapper">
                                                    <label class="form-label fw-semibold">
                                                        <i class="bi bi-cash me-1"></i>Cash (calculé)
                                                    </label>
                                                    <div class="form-control enhanced-input calculated-display">
                                                        @CurrentPayroll.Cash.ToString("C")
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-md-6">
                                                <div class="enhanced-form-group">
                                                    <label class="form-label fw-semibold">
                                                        <i class="bi bi-cash me-1"></i>Cash
                                                    </label>
