@using RH.Models
@using RH.Services
@inject CompanyInfoService CompanyService
@inject AdvanceService AdvanceService
@inject IJSRuntime JSRuntime

@code {
    [Parameter] public Payroll CurrentPayroll { get; set; }
    [Parameter] public Employee Employee { get; set; }
    [Parameter] public List<PayrollList.SelectableRule> Bonuses { get; set; }
    [Parameter] public List<PayrollList.SelectableRule> Deductions { get; set; }
    [Parameter] public List<AbsenceRecord> Absences { get; set; }
    [Parameter] public int? ManualAbsences { get; set; }
    [Parameter] public int? Transaction { get; set; }
    [Parameter] public int? Cash { get; set; }
    [Parameter] public PayrollService.AdvanceDeductionSummary AdvanceSummary { get; set; }
    [Parameter] public AdvanceService advanceService { get; set; }

    private CompanyInfo? Company;

    protected override async Task OnInitializedAsync()
    {
        Company = await CompanyService.GetAsync();
        CurrentPayroll.AdvanceDeductions = await AdvanceService.GetDeductionsForPayroll(CurrentPayroll.Id);
    }

    
}



<div >
    
    <div id="printable-area" class="payroll-document-a5">
        @if (Company != null)
        {
            <header class="document-header">
                <div class="header-content">
                    <div class="company-section">
                        @if (Company.LogoBytes != null)
                        {
                            <img src="data:@Company.LogoMimeType;base64,@Convert.ToBase64String(Company.LogoBytes)"
                                 alt="Logo Entreprise"
                                 class="company-logo"/>
                        }
                        <div class="company-details">
                            <h1 class="company-name">@Company.Name</h1>
                            <div class="company-info">
                                <p>@Company.Address</p>
                                <p>RC : @Company.RC | NIF : @Company.NIF</p>
                            </div>
                        </div>
                    </div>

                    <div class="document-info">
                        <h2 class="document-title">FICHE DE PAIE</h2>
                        <div class="document-details">
                            <p><strong>Période :</strong> @CurrentPayroll?.PayDate.ToString("MMMM yyyy")</p>
                            <p><strong>Émission :</strong> @DateTime.Now.ToString("dd/MM/yyyy")</p>
                        </div>
                    </div>
                </div>
            </header>
        }

        <section class="employee-section">
            <h3 class="section-title">INFORMATIONS EMPLOYÉ</h3>
            <div class="employee-grid">
                <div class="info-item">
                    <span class="label">Nom :</span>
                    <span class="value">@Employee?.FullName</span>
                </div>
                <div class="info-item">
                    <span class="label">ID :</span>
                    <span class="value">@Employee?.Id</span>
                </div>
                <div class="info-item">
                    <span class="label">Poste :</span>
                    <span class="value">@Employee?.JobTitle.Title</span>
                </div>
                <div class="info-item">
                    <span class="label">Embauche :</span>
                    <span class="value">@Employee?.HireDate</span>
                </div>
            </div>
        </section>

        <section class="salary-section">
            <h3 class="section-title">RÉCAPITULATIF SALAIRE</h3>

            <div class="salary-grid">
                <div class="salary-item">
                    <div class="salary-label">Salaire de base</div>
                    <div class="salary-amount">@CurrentPayroll.BaseSalary.ToString("N0") DA</div>
                </div>
                <div class="salary-item bonus">
                    <div class="salary-label">Primes</div>
                    <div class="salary-amount positive">@CurrentPayroll.Bonus.ToString("N0") DA</div>
                </div>
                <div class="salary-item deduction">
                    <div class="salary-label">Retenues</div>
                    <div class="salary-amount negative">@CurrentPayroll.Deductions.ToString("N0") DA</div>
                </div>
            </div>

            <div class="net-pay-section">
                <div class="net-pay-label">NET À PAYER</div>
                <div class="net-pay-amount">@CurrentPayroll.NetPay.ToString("N0") DA</div>
            </div>

            @if (CurrentPayroll.Cash != null || CurrentPayroll.Transaction != null)
            {
                <div class="payment-methods">
                    @if (CurrentPayroll.Cash != null)
                    {
                        <div class="payment-item">
                            <div class="payment-label">Espèces</div>
                            <div class="payment-amount">@CurrentPayroll.Cash.ToString("N0") DA</div>
                        </div>
                    }
                    @if (CurrentPayroll.Transaction != null)
                    {
                        <div class="payment-item">
                            <div class="payment-label">Virement</div>
                            <div class="payment-amount">@CurrentPayroll.Transaction.ToString("N0") DA</div>
                        </div>
                    }
                </div>
            }
        </section>

        @if (Bonuses?.Any(b => b.IsApplied) == true)
        {
            <section class="details-section">
                <h3 class="section-title">PRIMES</h3>
                <table class="details-table">
                    <thead>
                    <tr>
                        <th>Description</th>
                       
                        <th>Quantité</th>
                       
                        <th>Commentaire</th>
                        
                    </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Bonuses.Where(b => b.IsApplied))
                        {
                            <tr>
                                <td class="description">@b.Name</td>
                        
                                <td>@(b.IsCountable? b.Quantity.ToString("G29") : "-")</td>
                               
                                <td>@b.note</td>
                            
                            </tr>
                        }

                    </tbody>
                </table>
            </section>
        }


        @if (Deductions?.Any(d => d.IsApplied) == true)
        {
            <section class="details-section">
                <h3 class="section-title">RETENUES</h3>
                <table class="details-table">
                    <thead>
                    <tr>
                        <th>Description</th>
                      
                        <th>Quantité</th>
                        
                        <th>Commentaire</th>
                      
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var d in Deductions.Where(d => d.IsApplied))
                    {
                        <tr>
                            <td class="description">@d.Name</td>
                            
                                <td>@(d.IsCountable? d.Quantity.ToString("G29") : "-")</td>
                              
                            <td>@d.note</td>
                             
                        </tr>
                    }
                    </tbody>
                </table>
            </section>
        }


        @if (CurrentPayroll?.AdvanceDeductions?.Any() == true)
        {
            var deductions = CurrentPayroll.AdvanceDeductions
                .Where(d => d.Advance != null)
                .ToList();

            if (deductions.Any())
            {
                <section class="details-section">
                    <h3 class="section-title">AVANCES</h3>
                    <table class="details-table">
                        <thead>
                        <tr>
                            <th>Date</th>
                            <th>Avance</th>
                            <th>Déduit</th>
                            <th>Restant</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var deduction in deductions)
                        {
                            var adv = deduction.Advance;
                            var totalDeducted = CurrentPayroll.AdvanceDeductions
                                .Where(d => d.AdvanceId == adv.Id)
                                .Sum(d => d.DeductedAmount);

                            var remaining = adv.Amount - totalDeducted;

                            <tr>
                                <td>@adv.Date.ToString("dd/MM")</td>
                                <td class="amount">@adv.Amount.ToString("N0") DA</td>
                                <td class="amount negative">@deduction.DeductedAmount.ToString("N0") DA</td>
                                <td class="amount">@remaining.ToString("N0") DA</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </section>
            }
        }

        @if (Absences?.Any() == true || ManualAbsences > 0)
        {
            <section class="details-section">
                <h3 class="section-title">ABSENCES</h3>

                @if (ManualAbsences > 0)
                {
                    <div class="absence-alert">
                        <strong>Absences : </strong> @ManualAbsences jour(s)
                    </div>
                }

                @if (Absences?.Any() == true)
                {
                    <table class="details-table">
                        <thead>
                        <tr>
                            <th>Date</th>
                            <th>Motif</th>
                            <th>Comptée</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var a in Absences)
                        {
                            <tr>
                                <td>@a.Date.ToString("dd/MM")</td>
                                <td class="reason">@a.Reason</td>
                                <td class="center">@(a.Counted ? "Oui" : "Non")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </section>
        }

        <footer class="document-footer">
            <div class="footer-content">
                <div class="footer-note">
                    <p>Document généré automatiquement - Service RH</p>
                </div>
                <div class="signature-section">
                    <p class="signature-label">Signature</p>
                    <div class="signature-line"></div>
                </div>
            </div>
        </footer>
    </div>
</div>

<style>
/* Print Controls */
.print-controls {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 1000;
}

.print-button {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: #007bff;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 123, 255, 0.3);
    transition: all 0.2s ease;
}

.print-button:hover {
    background: #0056b3;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 123, 255, 0.4);
}

/* A5 Document Layout */
.payroll-document-a5 {
    max-width: 148mm; /* A5 width */
    margin: 0 auto;
    padding: 12mm;
    background: white;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 9pt;
    line-height: 1.3;
    color: #333;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
}

/* Header - Compact for A5 */
.document-header {
    margin-bottom: 15px;
    padding-bottom: 12px;
    border-bottom: 2px solid #007bff;
}

.header-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
}

.company-section {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    flex: 1;
}

.company-logo {
    width: 50px;
    height: auto;
    max-height: 50px;
    object-fit: contain;
    border-radius: 3px;
    border: 1px solid #e0e0e0;
}

.company-name {
    font-size: 12pt;
    font-weight: 700;
    color: #007bff;
    margin: 0 0 4px 0;
    line-height: 1.1;
}

.company-info p {
    margin: 1px 0;
    font-size: 7pt;
    color: #666;
    line-height: 1.2;
}

.document-info {
    text-align: right;
    flex-shrink: 0;
}

.document-title {
    font-size: 14pt;
    font-weight: 800;
    color: #007bff;
    margin: 0 0 6px 0;
    letter-spacing: 0.5px;
}

.document-details p {
    margin: 2px 0;
    font-size: 7pt;
    color: #666;
}

/* Sections - Compact spacing */
.section-title {
    font-size: 9pt;
    font-weight: 700;
    color: #007bff;
    margin: 12px 0 8px 0;
    padding-bottom: 2px;
    border-bottom: 1px solid #e0e0e0;
    text-transform: uppercase;
    letter-spacing: 0.3px;
}

/* Employee Section - Compact grid */
.employee-section {
    margin-bottom: 15px;
}

.employee-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 12px;
}

.info-item {
    display: flex;
    font-size: 8pt;
}

.info-item .label {
    font-weight: 600;
    color: #555;
    min-width: 60px;
    flex-shrink: 0;
}

.info-item .value {
    color: #333;
}

/* Salary Section - Compact layout */
.salary-section {
    margin-bottom: 15px;
}

.salary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-bottom: 12px;
}

.salary-item {
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 4px;
    padding: 8px 6px;
    text-align: center;
}

.salary-label {
    font-size: 7pt;
    color: #666;
    margin-bottom: 3px;
    font-weight: 500;
}

.salary-amount {
    font-size: 9pt;
    font-weight: 700;
    color: #333;
}

.salary-amount.positive {
    color: #28a745;
}

.salary-amount.negative {
    color: #dc3545;
}

.net-pay-section {
    background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
    border: 2px solid #2196f3;
    border-radius: 6px;
    padding: 12px;
    text-align: center;
    margin: 12px 0;
}

.net-pay-label {
    font-size: 8pt;
    font-weight: 700;
    color: #1976d2;
    margin-bottom: 4px;
    letter-spacing: 0.5px;
}

.net-pay-amount {
    font-size: 16pt;
    font-weight: 900;
    color: #0d47a1;
}

.payment-methods {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 10px;
}

.payment-item {
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 4px;
    padding: 6px;
    text-align: center;
}

.payment-label {
    font-size: 7pt;
    color: #666;
    margin-bottom: 2px;
}

.payment-amount {
    font-size: 8pt;
    font-weight: 600;
    color: #333;
}

/* Tables - Compact for A5 */
.details-section {
    margin-bottom: 15px;
    page-break-inside: avoid;
}

.details-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 6px;
    font-size: 7pt;
}

.details-table th,
.details-table td {
    padding: 4px 6px;
    border: 1px solid #dee2e6;
    text-align: left;
    vertical-align: top;
}

.details-table th {
    background: #f8f9fa;
    font-weight: 600;
    color: #495057;
    font-size: 6pt;
    text-transform: uppercase;
    letter-spacing: 0.2px;
}

.details-table tbody tr:nth-child(even) {
    background: #fefefe;
}

.details-table .description {
    font-weight: 500;
    max-width: 80px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.details-table .reason {
    color: #666;
    font-style: italic;
    font-size: 6pt;
}

.details-table .amount {
    text-align: right;
    font-weight: 600;
    white-space: nowrap;
}

.details-table .amount.positive {
    color: #28a745;
}

.details-table .amount.negative {
    color: #dc3545;
}

.details-table .center {
    text-align: center;
}

/* Absence Alert - Compact */
.absence-alert {
    background: #fff3cd;
    border: 1px solid #ffeaa7;
    border-radius: 4px;
    padding: 6px 8px;
    margin-bottom: 8px;
    color: #856404;
    font-size: 7pt;
}

/* Footer - Compact */
.document-footer {
    margin-top: 15px;
    padding-top: 10px;
    border-top: 1px solid #e0e0e0;
}

.footer-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
}

.footer-note {
    flex: 1;
}

.footer-note p {
    margin: 1px 0;
    font-size: 6pt;
    color: #777;
    font-style: italic;
}

.signature-section {
    text-align: right;
    min-width: 80px;
}

.signature-label {
    font-size: 6pt;
    font-weight: 600;
    color: #555;
    margin-bottom: 4px;
}

.signature-line {
    border-bottom: 1px solid #999;
    width: 80px;
    height: 20px;
    margin-left: auto;
}

/* A5 Print Styles */
@@media print {
    body {
        margin: 0;
        padding: 0;
        background: white;
    }

    .no-print {
        display: none !important;
    }

    .payroll-document-a5 {
        max-width: none;
        width: 100%;
        margin: 0;
        padding: 8mm;
        box-shadow: none;
        font-size: 8pt;
    }

    .document-title {
        font-size: 12pt;
    }

    .company-name {
        font-size: 10pt;
    }

    .net-pay-amount {
        font-size: 14pt;
    }

    .section-title {
        font-size: 8pt;
        margin: 8px 0 6px 0;
    }

    .details-table {
        font-size: 6pt;
    }

    .details-table th,
    .details-table td {
        padding: 3px 4px;
    }

    .salary-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 6px;
    }

    .employee-grid {
        grid-template-columns: 1fr 1fr;
        gap: 4px 8px;
    }

    .payment-methods {
        grid-template-columns: 1fr 1fr;
        gap: 6px;
    }

    .details-section,
    .salary-section,
    .employee-section {
        page-break-inside: avoid;
        break-inside: avoid;
        margin-bottom: 10px;
    }

    .net-pay-section {
        page-break-inside: avoid;
        break-inside: avoid;
        padding: 8px;
    }

    .footer-note p {
        font-size: 5pt;
    }

    .signature-label {
        font-size: 5pt;
    }

    .company-info p {
        font-size: 6pt;
    }

    .document-details p {
        font-size: 6pt;
    }

    .info-item {
        font-size: 7pt;
    }

    .salary-label {
        font-size: 6pt;
    }

    .salary-amount {
        font-size: 8pt;
    }

    .payment-label {
        font-size: 6pt;
    }

    .payment-amount {
        font-size: 7pt;
    }

    .absence-alert {
        font-size: 6pt;
        padding: 4px 6px;
    }

    /* A5 specific page settings */
    @@page {
        size: A5;
        margin: 8mm;
    }

    /* Ensure proper page breaks */
    .section-title {
        page-break-after: avoid;
    }

    .details-table thead {
        display: table-header-group;
    }

    .details-table tbody {
        display: table-row-group;
    }
}

/* Responsive adjustments for smaller screens */
@@media screen and (max-width: 768px) {
    .payroll-document-a5 {
        padding: 10px;
        margin: 5px;
        font-size: 8pt;
    }

    .header-content {
        flex-direction: column;
        gap: 8px;
    }

    .document-info {
        text-align: left;
    }

    .employee-grid {
        grid-template-columns: 1fr;
        gap: 4px;
    }

    .salary-grid {
        grid-template-columns: 1fr;
        gap: 6px;
    }

    .payment-methods {
        grid-template-columns: 1fr;
        gap: 6px;
    }

    .footer-content {
        flex-direction: column;
        gap: 8px;
        align-items: flex-start;
    }

    .signature-section {
        text-align: left;
    }
}
</style>

<script>
    window.printDiv = (divId) => {
        const element = document.getElementById(divId);
        if (!element) {
            console.error('Element not found:', divId);
            return;
        }

        const content = element.innerHTML;
        const printWindow = window.open('', '_blank', 'width=600,height=800,scrollbars=yes');

        if (!printWindow) {
            alert('Popup blocked. Please allow popups for this site to print.');
            return;
        }

        // Collect all styles from the current page
        let styles = '';
        document.querySelectorAll('link[rel="stylesheet"], style').forEach(node => {
            if (node.tagName === 'LINK') {
                styles += `<link rel="stylesheet" href="${node.href}">`;
            } else {
                styles += node.outerHTML;
            }
        });

        const printContent = `
            <!DOCTYPE html>
            <html lang="fr">
            <head>
                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1.0">
                <title>Fiche de Paie A5</title>
                ${styles}
                <style>
                    @@media print {
                        @@page {
                            size: A5;
                            margin: 8mm;
                        }

                        body {
                            margin: 0;
                            padding: 0;
                            font-size: 8pt;
                            line-height: 1.2;
                        }

                        .payroll-document-a5 {
                            max-width: none;
                            width: 100%;
                            margin: 0;
                            padding: 0;
                            box-shadow: none;
                        }
                    }
                </style>
            </head>
            <body>
                ${content}
                <script>
                    window.onload = function() {
                        setTimeout(function() {
                            window.print();
                            window.close();
                        }, 500);
                    };
                <\/script>
            </body>
            </html>
        `;

        printWindow.document.write(printContent);
        printWindow.document.close();
    };
</script>


