@using RH.Models
@using RH.Services
@inject CompanyInfoService CompanyService
@inject AdvanceService AdvanceService
@code {
    [Parameter] public Payroll CurrentPayroll { get; set; }
    [Parameter] public Employee Employee { get; set; }
    [Parameter] public List<PayrollList.SelectableRule> Bonuses { get; set; }
    [Parameter] public List<PayrollList.SelectableRule> Deductions { get; set; }
    [Parameter] public List<AbsenceRecord> Absences { get; set; }
    [Parameter] public int? ManualAbsences { get; set; }
    [Parameter] public int? Transaction { get; set; }
    [Parameter] public int? Cash { get; set; }
    [Parameter] public PayrollService.AdvanceDeductionSummary AdvanceSummary { get; set; }
    [Parameter] public AdvanceService advanceService { get; set; }
    private CompanyInfo? Company;

    protected override async Task OnInitializedAsync()
    {
        Company = await CompanyService.GetAsync();
        CurrentPayroll.AdvanceDeductions = await AdvanceService.GetDeductionsForPayroll(CurrentPayroll.Id);
    }
}
<div id="printable-area" class="payroll-sheet">
    @if (Company != null)
    {
        <div class="payroll-header border rounded p-4 shadow-sm mb-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div class="d-flex align-items-center">
                    @if (Company.LogoBytes != null)
                    {
                        <img src="data:@Company.LogoMimeType;base64,@Convert.ToBase64String(Company.LogoBytes)"
                             alt="Logo Entreprise"
                             class="company-logo me-3 rounded border" />
                    }
                    <div class="company-info">
                        <h5 class="mb-1 fw-bold">@Company.Name</h5>
                        <small>@Company.Address</small><br />
                        <small>RC : @Company.RC | NIF : @Company.NIF</small>
                    </div>
                </div>
                <div class="text-end mt-3 mt-md-0">
                    <h4 class="text-primary fw-bold mb-2">FICHE DE PAIE</h4>
                    <p class="mb-1 text-muted"><strong>Période :</strong> @CurrentPayroll?.PayDate.ToString("MMMM yyyy")</p>
                    <p class="mb-0 text-muted"><strong>Émission :</strong> @DateTime.Now.ToString("dd/MM/yyyy")</p>
                </div>
            </div>
        </div>
    }

    <div class="employee-info-section mb-3">
        <h5 class="section-title">INFORMATIONS EMPLOYÉ</h5>
        <div class="row">
            <div class="col-6">
                <p><strong>Nom complet :</strong> @Employee?.FullName</p>
                <p><strong>Poste :</strong> @Employee?.JobTitle.Title</p>
            </div>
            <div class="col-6">
                <p><strong>ID Employé :</strong> @Employee?.Id</p>
                <p><strong>Date d'embauche :</strong> @Employee?.HireDate</p>
            </div>
        </div>
    </div>

    <div class="salary-summary-section mb-3">
        <h5 class="section-title">RÉCAPITULATIF SALAIRE</h5>
        <div class="row">
            <div class="col-md-4">
                <div class="summary-item">
                    <p class="label">Salaire de base</p>
                    <p class="value">@CurrentPayroll.BaseSalary.ToString("N2") DA</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="summary-item">
                    <p class="label">Total Primes</p>
                    <p class="value text-success">@CurrentPayroll.Bonus.ToString("N2") DA</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="summary-item">
                    <p class="label">Total Retenues</p>
                    <p class="value text-danger">@CurrentPayroll.Deductions.ToString("N2") DA</p>
                </div>
            </div>
        </div>
        <div class="net-pay-box mt-2">
            <p class="net-pay-label">NET À PAYER</p>
            <p class="net-pay-value">@CurrentPayroll.NetPay.ToString("N2") DA</p>
        </div>

        @if (CurrentPayroll.Cash != null || CurrentPayroll.Transaction != null)
        {
            <div class="row mt-3">
                @if (CurrentPayroll.Cash != null)
                {
                    <div class="col-md-6">
                        <div class="summary-item">
                            <p class="label">Paiement en espèces</p>
                            <p class="value">@CurrentPayroll.Cash.ToString("N2") DA</p>
                        </div>
                    </div>
                }
                @if (CurrentPayroll.Transaction != null)
                {
                    <div class="col-md-6">
                        <div class="summary-item">
                            <p class="label">Paiement par virement</p>
                            <p class="value">@CurrentPayroll.Transaction.ToString("N2") DA</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @if (Bonuses?.Any(b => b.IsApplied) == true)
    {
        <div class="details-section mb-3">
            <h5 class="section-title">DÉTAILS DES PRIMES</h5>
            <div class="table-container">
                <table class="table table-sm table-bordered details-table">
                    <thead class="table-light">
                        <tr>
                            <th>Description</th>
                            <th>Motif</th>
                            <th class="text-end">Montant</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Bonuses.Where(b => b.IsApplied))
                        {
                            <tr>
                                <td class="description-cell">@b.Name</td>
                                <td>@b.note</td>
                                <td class="text-end text-success">@b.CalculatedAmount.ToString("N2") DA</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Deductions?.Any(d => d.IsApplied) == true)
    {
        <div class="details-section mb-3">
            <h5 class="section-title">DÉTAILS DES RETENUES</h5>
            <div class="table-container">
                <table class="table table-sm table-bordered details-table">
                    <thead class="table-light">
                        <tr>
                            <th>Description</th>
                            <th>Motif</th>
                            <th class="text-end">Montant</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Deductions.Where(d => d.IsApplied))
                        {
                            <tr>
                                <td class="description-cell">@d.Name</td>
                                <td>@d.note</td>
                                <td class="text-end text-danger">@d.CalculatedAmount.ToString("N2") DA</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    @if (CurrentPayroll?.AdvanceDeductions?.Any() == true)
    {
        var deductions = CurrentPayroll.AdvanceDeductions
        .Where(d => d.Advance != null)
        .ToList();

        if (deductions.Any())
        {
            <div class="details-section mt-4">
                <div class="section-title">Avances et Déductions</div>
                <div class="table-container">
                    <table class="details-table">
                        <thead>
                            <tr>
                                <th>Date Avance</th>
                                <th>Montant Avance</th>
                                <th>Montant Déduit</th>
                                <th>Montant Restant</th>
                                <th>Remarque</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var deduction in deductions)
                            {
                                var adv = deduction.Advance;
                                var totalDeducted = CurrentPayroll.AdvanceDeductions
                                .Where(d => d.AdvanceId == adv.Id)
                                .Sum(d => d.DeductedAmount);

                                var remaining = adv.Amount - totalDeducted;

                                <tr>
                                    <td>@adv.Date.ToString("dd/MM/yyyy")</td>
                                    <td>@adv.Amount.ToString("0.00") DA</td>
                                    <td>@deduction.DeductedAmount.ToString("0.00") DA</td>
                                    <td>@remaining.ToString("0.00") DA</td>
                                    <td>@adv.Reason</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }





    @if (Absences?.Any() == true || ManualAbsences > 0)
    {
        <div class="details-section mb-3">
            <h5 class="section-title">DÉTAILS DES ABSENCES</h5>

            @if (ManualAbsences > 0)
            {
                <div class="alert alert-warning d-flex align-items-center mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Nombre des Absences : </strong> @ManualAbsences jour(s)
                </div>
            }

            @if (Absences?.Any() == true)
            {
                <div class="table-container">
                    <table class="table table-sm table-bordered details-table">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Motif</th>
                                <th class="text-center">Comptée</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Absences)
                            {
                                <tr>
                                    <td>@a.Date.ToShortDateString()</td>
                                    <td class="description-cell">@a.Reason</td>
                                    <td class="text-center">@(a.Counted ? "Oui" : "Non")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <div class="footer-section">
        <div class="row">
            <div class="col-6">
                <p class="text-muted small">
                    Ce document est une fiche de paie générée automatiquement.
                    Pour toute question, veuillez contacter le service RH.
                </p>
            </div>
            <div class="col-6 text-end">
                <p class="signature-label">Signature du responsable</p>
                <div class="signature-line"></div>
            </div>
        </div>
    </div>
</div>
