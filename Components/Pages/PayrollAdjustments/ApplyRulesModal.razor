@inject IPayrollService PayrollService
@inject PayrollAdjustmentRuleService PayrollRuleService
@inject IEmployeeService EmployeeService

@using RH.Models
@using RH.Services
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

<div class="modal fade show" style="display:@(IsVisible ? "block" : "none")" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-calculator-fill me-2"></i>Appliquer des Règles de Paie</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
            </div>

            <div class="modal-body bg-light px-5 py-4">

                <!-- Employee Selection -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">👤 Sélectionner un employé</label>
                        <select class="form-select rounded-pill px-3 shadow-sm" @onchange="e => OnEmployeeSelected(e.Value?.ToString())">
                            <option value="">-- Choisir --</option>
                            @foreach (var emp in Employees)
                            {
                                <option value="@emp.Id" selected="@(emp.Id == SelectedEmployeeId)">
                                    @emp.FullName
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">💰 Base de calcul (DZD)</label>
                        <div class="input-group rounded-pill shadow-sm">
                            <span class="input-group-text bg-white border-end-0">DZD</span>
                            <InputNumber class="form-control border-start-0" @bind-Value="BaseAmount" />
                        </div>
                    </div>
                </div>

                @if (Rules.Any())
                {
                    <div class="row gy-4">
                        <!-- Bonuses -->
                        @if (Rules.Any(r => r.Type == AdjustmentType.Bonus))
                        {
                            <div class="col-12">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-header bg-success text-white rounded-top">
                                        <h6 class="m-0"><i class="bi bi-cash-coin me-2"></i> Primes</h6>
                                    </div>
                                    <div class="card-body p-0">
                                        @RenderRuleTable(Rules.Where(r => r.Type == AdjustmentType.Bonus).ToList())
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Deductions -->
                        @if (Rules.Any(r => r.Type == AdjustmentType.Deduction))
                        {
                            <div class="col-12">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-header bg-danger text-white rounded-top">
                                        <h6 class="m-0"><i class="bi bi-dash-circle me-2"></i> Déductions</h6>
                                    </div>
                                    <div class="card-body p-0">
                                        @RenderRuleTable(Rules.Where(r => r.Type == AdjustmentType.Deduction).ToList())
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="modal-footer bg-white d-flex justify-content-between px-4">
                <button class="btn btn-outline-secondary rounded-pill px-4" @onclick="Close">
                    <i class="bi bi-x-circle me-1"></i> Fermer
                </button>
                <button class="btn btn-success rounded-pill px-4" @onclick="ApplySelectedRules">
                    <i class="bi bi-check2-circle me-1"></i> Appliquer
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private List<Employee> Employees = new();
    private List<SelectableRule> Rules = new();
    private decimal BaseAmount;
    private int SelectedEmployeeId;

    protected override async Task OnInitializedAsync()
    {
        Employees = await EmployeeService.GetAllAsync();
    }

    private async Task OnEmployeeSelected(string? value)
    {
        if (int.TryParse(value, out int id))
        {
            SelectedEmployeeId = id;
            await LoadRules();
        }
        else
        {
            SelectedEmployeeId = 0;
            Rules.Clear();
        }
    }

    private async Task LoadRules()
    {
        
        

        var allRules = await PayrollRuleService.GetAllAsync();
        var employee = await EmployeeService.GetByIdAsync(SelectedEmployeeId);
        BaseAmount = employee?.BaseSalary ?? 0;
        var jobTitleId = employee.JobTitleId;

        Rules = allRules
            .Where(rule => rule.JobTitles.Any(jt => jt.Id == jobTitleId))
            .Select(r => new SelectableRule
            {
                RuleId = r.Id,
                Name = r.Name,
                Amount = r.Amount,
                IsPercentage = r.IsPercentage,
                IsEditable = r.IsEditable,
                IsCountable = r.IsCountable,
                Quantity = r.IsCountable ? 1 : null,
                Notes = "",
                IsSelected = false,
                Type = r.Type
            }).ToList();

        foreach (var rule in Rules)
        {
            Recalculate(rule);
        }
        StateHasChanged();
    }

    private void Recalculate(SelectableRule rule)
    {
        if (rule.IsPercentage)
        {
            var rate = rule.Amount / 100m;
            rule.CalculatedAmount = rule.IsCountable && rule.Quantity != null
                ? rule.Quantity.Value * BaseAmount * rate
                : BaseAmount * rate;
        }
        else
        {
            rule.CalculatedAmount = rule.IsCountable && rule.Quantity != null
                ? rule.Quantity.Value * rule.Amount
                : rule.Amount;
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task ApplySelectedRules()
    {
        if (SelectedEmployeeId == 0) return;

        var selected = Rules.Where(r => r.IsSelected).ToList();
        if (!selected.Any()) return;

        var appliedRules = selected.Select(r => new PayrollAppliedRule
        {
            EmployeeId = SelectedEmployeeId,
            RuleId = r.RuleId,
            Amount = r.Amount,
            Quantity = r.Quantity ?? 1,
            Notes = r.Notes,
            Date = DateTime.Now
        }).ToList();

        await PayrollService.ApplyRulesAsync(SelectedEmployeeId, appliedRules);
        await Close();
    }

    public class SelectableRule
    {
        public int RuleId { get; set; }
        public string Name { get; set; } = "";
        public decimal Amount { get; set; }
        public bool IsEditable { get; set; }
        public bool IsPercentage { get; set; }
        public bool IsCountable { get; set; }
        public decimal? Quantity { get; set; }
        public decimal CalculatedAmount { get; set; }
        public string? Notes { get; set; }
        public bool IsSelected { get; set; }
        public AdjustmentType Type { get; set; }
    }

    private RenderFragment<List<SelectableRule>> RenderRuleTable => rules => @<div class="table-responsive">
    <table class="table table-striped table-sm m-0 align-middle">
        <thead class="table-light">
            <tr class="text-center">
                <th>✔️</th>
                <th>Règle</th>
                <th>Montant</th>
                <th>Quantité</th>
                <th>Total</th>
                <th>Remarques</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rule in rules)
                        {
            <tr>
                <td class="text-center">
                    <input type="checkbox" class="form-check-input" @bind="rule.IsSelected" />
                </td>
                <td>
                    @rule.Name
                    @if (rule.IsPercentage)
                                        {
                    <span class="badge bg-info ms-2">%</span>
                                        }
                </td>
                <td>
                    @if (rule.IsEditable)
                    {
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">DZD</span>
                            <InputNumber class="form-control" @bind-Value="rule.Amount" @oninput="_ => Recalculate(rule)" />
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">@rule.Amount.ToString("0.##") DZD</span>
                    }
                </td>
                <td>
                    @if (rule.IsCountable)
                    {
                        <InputNumber class="form-control form-control-sm" @bind-Value="rule.Quantity" @oninput="_ => Recalculate(rule)" />
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td class="fw-bold text-end text-success">
                    @rule.CalculatedAmount.ToString("0.##") DZD
                </td>
                <td>
                    <InputText class="form-control form-control-sm" @bind-Value="rule.Notes" placeholder="Remarque..." />
                </td>
            </tr>
                        }
        </tbody>
    </table>
</div>;
}
