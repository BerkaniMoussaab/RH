@page "/payroll/employee-applied-rules"
@inject IPayrollService PayrollService
@inject IEmployeeService EmployeeService

@using RH.Models
@using RH.Services
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

<PageTitle>Règles Appliquées par Employé</PageTitle>

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2>
                    <i class="bi bi-people-fill me-2"></i>
                    Règles Appliquées par Employé
                </h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Accueil</a></li>
                        <li class="breadcrumb-item"><a href="/payroll">Paie</a></li>
                        <li class="breadcrumb-item active">Règles par Employé</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <!-- Simplified Filters -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <!-- Employee Search -->
                        <div class="col-md-4">
                            <label class="form-label">Rechercher un employé</label>
                            <input type="text"
                                   class="form-control"
                                   placeholder="Nom de l'employé..."
                                   @bind="EmployeeSearchTerm"
                                   @oninput="FilterEmployees" />
                        </div>

                        

                        <!-- Global Period Filter -->
                        <div class="col-md-2">
                            <label class="form-label">Période</label>
                            <select class="form-select" @bind="GlobalSelectedPeriod">
                                @foreach (var period in AvailablePeriods)
                                {
                                    <option value="@period.Key">@period.Value</option>
                                }
                            </select>
                        </div>

                        <!-- Filter Button -->
                        <div class="col-md-2">
                            <button class="btn btn-success w-100" @onclick="ApplyFilters">
                                <i class="bi bi-funnel me-1"></i>
                                Filtrer
                            </button>
                        </div>

                        <!-- Refresh Button -->
                        <div class="col-md-2">
                            <button class="btn btn-primary w-100" @onclick="RefreshAllData">
                                <i class="bi bi-arrow-clockwise me-1"></i>
                                Actualiser
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Statistics -->
    @if (GlobalStatistics != null)
    {
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-people display-6"></i>
                        <h4 class="mt-2">@GlobalStatistics.TotalEmployees</h4>
                        <p class="mb-0">Employés</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-list-check display-6"></i>
                        <h4 class="mt-2">@GlobalStatistics.TotalRules</h4>
                        <p class="mb-0">Règles Totales</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-cash-coin display-6"></i>
                        <h4 class="mt-2">@GlobalStatistics.TotalBonuses.ToString("N0") DZD</h4>
                        <p class="mb-0">Total Primes</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-danger text-white">
                    <div class="card-body text-center">
                        <i class="bi bi-dash-circle display-6"></i>
                        <h4 class="mt-2">@GlobalStatistics.TotalDeductions.ToString("N0") DZD</h4>
                        <p class="mb-0">Total Déductions</p>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (IsLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Chargement...</span>
            </div>
            <p class="mt-3 text-muted">Chargement des employés et règles...</p>
        </div>
    }
    else
    {
        <!-- Employees List -->
        <div class="row">
            @foreach (var employeeData in FilteredEmployees)
            {
                <div class="col-12 mb-3">
                    <div class="card">
                        <!-- Employee Header -->
                        <div class="card-header">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-person-circle me-3 text-primary" style="font-size: 2rem;"></i>
                                        <div>
                                            <h5 class="mb-0">@employeeData.Employee.FullName</h5>
                                            <small class="text-muted">@employeeData.Employee.JobTitle?.Title</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="row text-center">
                                        <div class="col-4">
                                            <span class="badge bg-info">@employeeData.AllAppliedRules.Count règles</span>
                                        </div>
                                        <div class="col-4">
                                            <span class="badge bg-success">+@employeeData.TotalBonuses.ToString("N0") DZD</span>
                                        </div>
                                        <div class="col-4">
                                            <span class="badge bg-danger">-@employeeData.TotalDeductions.ToString("N0") DZD</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Employee Rules -->
                        <div class="card-body">
                            @if (employeeData.IsLoading)
                            {
                                <div class="text-center py-3">
                                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                    <span class="ms-2 text-muted">Chargement des règles...</span>
                                </div>
                            }
                            else if (!employeeData.AllAppliedRules.Any())
                            {
                                <div class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox display-4"></i>
                                    <p class="mt-2 mb-0">Aucune règle appliquée</p>
                                    <small class="text-muted">Aucune règle pour la période sélectionnée</small>
                                </div>
                            }
                            else
                            {
                                <!-- Simplified Rules Table -->
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Règle</th>
                                                <th class="text-end">Montant</th>
                                                <th class="text-center">Date</th>
                                                <th class="text-center">Statut</th>
                                                <th class="text-center">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var rule in employeeData.AllAppliedRules.OrderByDescending(r => r.Date).Take(5))
                                            {
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            @if (rule.Rule?.Type == AdjustmentType.Bonus)
                                                            {
                                                                <i class="bi bi-plus-circle text-success me-2"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-dash-circle text-danger me-2"></i>
                                                            }
                                                            <span>@(rule.Rule?.Name ?? "Règle supprimée")</span>
                                                        </div>
                                                    </td>
                                                    <td class="text-end">
                                                        <span class="fw-bold @(rule.Rule?.Type == AdjustmentType.Bonus ? "text-success" : "text-danger")">
                                                            @rule.Amount.ToString("N0") DZD
                                                        </span>
                                                    </td>
                                                    <td class="text-center">
                                                        <small class="text-muted">@(rule.Date?.ToString("dd/MM/yyyy") ?? "—")</small>
                                                    </td>
                                                    <td class="text-center">
                                                        @if (rule.PayrollId.HasValue)
                                                        {
                                                            <span class="badge bg-success">
                                                                <i class="bi bi-check-circle"></i> Intégrée
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning">
                                                                <i class="bi bi-clock"></i> En attente
                                                            </span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        @if (!rule.PayrollId.HasValue)
                                                        {
                                                            <button class="btn btn-outline-danger btn-sm"
                                                                    title="Supprimer"
                                                                    @onclick="() => RemoveRule(rule.Id)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                @if (employeeData.AllAppliedRules.Count > 5)
                                {
                                    <div class="text-center mt-2">
                                        <button class="btn btn-outline-primary btn-sm" @onclick="@(() => ToggleEmployeeExpanded(employeeData.Employee.Id))">
                                            <i class="bi @(expandedEmployees.Contains(employeeData.Employee.Id) ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                            @(expandedEmployees.Contains(employeeData.Employee.Id)
                                                ? "Voir moins"
                                                : $"Voir toutes ({employeeData.AllAppliedRules.Count} règles)")
                                        </button>
                                    </div>
                                }


                                <!-- Expanded view -->
                                @if (expandedEmployees.Contains(employeeData.Employee.Id) && employeeData.AllAppliedRules.Count > 5)
                                {
                                    <div class="table-responsive mt-3">
                                        <table class="table table-sm">
                                            <tbody>
                                                @foreach (var rule in employeeData.AllAppliedRules.OrderByDescending(r => r.Date).Skip(5))
                                                {
                                                    <tr>
                                                        <td>
                                                            <div class="d-flex align-items-center">
                                                                @if (rule.Rule?.Type == AdjustmentType.Bonus)
                                                                {
                                                                    <i class="bi bi-plus-circle text-success me-2"></i>
                                                                }
                                                                else
                                                                {
                                                                    <i class="bi bi-dash-circle text-danger me-2"></i>
                                                                }
                                                                <span>@(rule.Rule?.Name ?? "Règle supprimée")</span>
                                                            </div>
                                                        </td>
                                                        <td class="text-end">
                                                            <span class="fw-bold @(rule.Rule?.Type == AdjustmentType.Bonus ? "text-success" : "text-danger")">
                                                                @rule.Amount.ToString("N0") DZD
                                                            </span>
                                                        </td>
                                                        <td class="text-center">
                                                            <small class="text-muted">@(rule.Date?.ToString("dd/MM/yyyy") ?? "—")</small>
                                                        </td>
                                                        <td class="text-center">
                                                            @if (rule.PayrollId.HasValue)
                                                            {
                                                                <span class="badge bg-success">
                                                                    <i class="bi bi-check-circle"></i> Intégrée
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-warning">
                                                                    <i class="bi bi-clock"></i> En attente
                                                                </span>
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            @if (!rule.PayrollId.HasValue)
                                                            {
                                                                <button class="btn btn-outline-danger btn-sm"
                                                                        title="Supprimer"
                                                                        @onclick="() => RemoveRule(rule.Id)">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (!FilteredEmployees.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-search display-1 text-muted"></i>
                <h4 class="mt-3 text-muted">Aucun employé trouvé</h4>
                <p class="text-muted">Aucun employé ne correspond aux critères de recherche.</p>
            </div>
        }
    }
</div>

@code {
    private List<EmployeeRulesData> AllEmployees = new();
    private List<EmployeeRulesData> FilteredEmployees = new();
    private List<string> Departments = new();
    private GlobalRulesStatistics? GlobalStatistics;
    private bool IsLoading = true;
    private string EmployeeSearchTerm = "";
    private string SelectedDepartment = "";
    private string GlobalSelectedPeriod = "current_month"; // Default to current month
    private HashSet<int> expandedEmployees = new();

    private Dictionary<string, string> AvailablePeriods = new()
    {
        { "current_month", "Mois en cours" },
        { "last_month", "Mois dernier" },
        { "last_3_months", "3 derniers mois" },
        { "current_year", "Année en cours" },
        { "all", "Toutes les périodes" }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();
        await LoadGlobalStatistics();
    }

    private async Task LoadEmployees()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            var employees = await EmployeeService.GetAllAsync();

            AllEmployees = employees.Select(emp => new EmployeeRulesData
                {
                    Employee = emp,
                    AllAppliedRules = new(),
                    IsLoading = false
                }).ToList();

           

            // Load initial rules for all employees with current month filter
            foreach (var employeeData in AllEmployees)
            {
                await LoadEmployeeRules(employeeData);
            }

            FilterEmployees();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading employees: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadEmployeeRules(EmployeeRulesData employeeData)
    {
        employeeData.IsLoading = true;
        StateHasChanged();

        try
        {
            var (fromDate, toDate) = GetDateRange();
            employeeData.AllAppliedRules = await PayrollService.GetAppliedRulesForEmployeeAsync(
                employeeData.Employee.Id, fromDate, toDate);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading rules for employee {employeeData.Employee.Id}: {ex.Message}");
        }
        finally
        {
            employeeData.IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadGlobalStatistics()
    {
        try
        {
            var allEmployees = AllEmployees;
            var totalRules = allEmployees.SelectMany(e => e.AllAppliedRules).Count();
            var pendingRules = allEmployees.SelectMany(e => e.PendingRules).Count();
            var attachedRules = allEmployees.SelectMany(e => e.AttachedRules).Count();
            var totalBonuses = allEmployees.SelectMany(e => e.AllAppliedRules)
                .Where(r => r.Rule?.Type == AdjustmentType.Bonus)
                .Sum(r => r.Amount);
            var totalDeductions = allEmployees.SelectMany(e => e.AllAppliedRules)
                .Where(r => r.Rule?.Type == AdjustmentType.Deduction)
                .Sum(r => r.Amount);

            GlobalStatistics = new GlobalRulesStatistics
                {
                    TotalEmployees = allEmployees.Count,
                    TotalRules = totalRules,
                    PendingRules = pendingRules,
                    AttachedRules = attachedRules,
                    TotalBonuses = totalBonuses,
                    TotalDeductions = totalDeductions
                };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading global statistics: {ex.Message}");
        }
    }

    private (DateTime? fromDate, DateTime? toDate) GetDateRange()
    {
        return GlobalSelectedPeriod switch
        {
            "current_month" => (new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1), DateTime.Now),
            "last_month" => (new DateTime(DateTime.Now.AddMonths(-1).Year, DateTime.Now.AddMonths(-1).Month, 1),
                        new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddDays(-1)),
            "last_3_months" => (DateTime.Now.AddMonths(-3), DateTime.Now),
            "current_year" => (new DateTime(DateTime.Now.Year, 1, 1), DateTime.Now),
            _ => (null, null)
        };
    }

    private async Task OnGlobalPeriodChanged()
    {
        // This method is now called explicitly via ApplyFilters button
        // Reload all employee rules with new period
        foreach (var employeeData in AllEmployees)
        {
            await LoadEmployeeRules(employeeData);
        }
        await LoadGlobalStatistics();
        FilterEmployees();
    }

    private async Task ApplyFilters()
    {
        // Apply period changes and filter employees
        await OnGlobalPeriodChanged();
    }

    private void FilterEmployees()
    {
        FilteredEmployees = AllEmployees.Where(emp =>
        {
            // Search term filter
            bool matchesSearch = string.IsNullOrEmpty(EmployeeSearchTerm) ||
                               emp.Employee.FullName.Contains(EmployeeSearchTerm, StringComparison.OrdinalIgnoreCase);

         

            return matchesSearch ;
        }).OrderBy(emp => emp.Employee.FullName).ToList();

        StateHasChanged();
    }

    private async Task RefreshAllData()
    {
        await LoadEmployees();
        await LoadGlobalStatistics();
    }

    private void ToggleEmployeeExpanded(int employeeId)
    {
        if (expandedEmployees.Contains(employeeId))
        {
            expandedEmployees.Remove(employeeId);
        }
        else
        {
            expandedEmployees.Add(employeeId);
        }
        StateHasChanged();
    }

    private async Task RemoveRule(int ruleId)
    {
        try
        {
            PayrollService.deleteAppliedRule(ruleId);
            await RefreshAllData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error removing rule: {ex.Message}");
        }
    }

    public class EmployeeRulesData
    {
        public Employee Employee { get; set; } = new();
        public List<PayrollAppliedRule> AllAppliedRules { get; set; } = new();
        public bool IsLoading { get; set; }

        // Pending rules (not attached to any payroll)
        public List<PayrollAppliedRule> PendingRules =>
            AllAppliedRules.Where(r => !r.PayrollId.HasValue).ToList();

        // Attached rules (already integrated into a payroll)
        public List<PayrollAppliedRule> AttachedRules =>
            AllAppliedRules.Where(r => r.PayrollId.HasValue).ToList();

        public List<PayrollAppliedRule> BonusRules =>
            AllAppliedRules.Where(r => r.Rule?.Type == AdjustmentType.Bonus).ToList();

        public List<PayrollAppliedRule> DeductionRules =>
            AllAppliedRules.Where(r => r.Rule?.Type == AdjustmentType.Deduction).ToList();

        public decimal TotalBonuses => BonusRules.Sum(r => r.Amount);
        public decimal TotalDeductions => DeductionRules.Sum(r => r.Amount);
        public decimal NetAdjustment => TotalBonuses - TotalDeductions;
    }

    public class GlobalRulesStatistics
    {
        public int TotalEmployees { get; set; }
        public int TotalRules { get; set; }
        public int PendingRules { get; set; }
        public int AttachedRules { get; set; }
        public decimal TotalBonuses { get; set; }
        public decimal TotalDeductions { get; set; }
    }
}

