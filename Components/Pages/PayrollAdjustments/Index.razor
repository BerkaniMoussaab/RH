@page "/payrollRules"
@using RH.Models
@using RH.Services
@inject PayrollAdjustmentRuleService AdjustmentService
@inject JobTitleService JobTitleService
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<h3 class="mb-4">Règles d'ajustement de paie</h3>

<button class="btn btn-primary mb-3" @onclick="() => ShowModal = true">+ Nouvelle règle</button>

@if (isLoading)
{
    <div class="mt-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Chargement...</span>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <h5>Bonus</h5>
            @foreach (var adj in Adjustments.Where(a => a.Type == AdjustmentType.Bonus))
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">@adj.Name</h5>
                        <h6 class="card-subtitle mb-2 text-muted">
                            Montant : <strong>@(adj.IsPercentage ? $"{adj.Amount}%" : $"{adj.Amount:C}")</strong>
                        </h6>
                        <p class="card-text">
                            <i class="bi bi-people-fill me-1"></i>
                            @foreach (var title in adj.JobTitles)
                            {
                                <span class="badge bg-secondary me-1">@title.Title</span>
                            }
                        </p>
                        <p class="text-muted small">
                            <i class="bi bi-calculator me-1"></i>
                            @if (adj.IsCountable)
                            {
                                <span>Règle avec quantité</span>
                            }
                            else
                            {
                                <span>Règle simple</span>
                            }
                        </p>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditModal(adj)">
                            <i class="bi bi-pencil"></i> Modifier
                        </button>
                    </div>
                </div>
            }
        </div>
        <div class="col-md-6">
            <h5>Déductions</h5>
            @foreach (var adj in Adjustments.Where(a => a.Type == AdjustmentType.Deduction))
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">@adj.Name</h5>
                        <h6 class="card-subtitle mb-2 text-muted">
                            Montant : <strong>@(adj.IsPercentage ? $"{adj.Amount}%" : $"{adj.Amount:C}")</strong>
                        </h6>
                        <p class="card-text">
                            <i class="bi bi-people-fill me-1"></i>
                            @foreach (var title in adj.JobTitles)
                            {
                                <span class="badge bg-secondary me-1">@title.Title</span>
                            }
                        </p>
                        <p class="text-muted small">
                            <i class="bi bi-calculator me-1"></i>
                            @if (adj.IsCountable)
                            {
                                <span>Règle avec quantité</span>
                            }
                            else
                            {
                                <span>Règle simple</span>
                            }
                        </p>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditModal(adj)">
                            <i class="bi bi-pencil"></i> Modifier
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (ShowModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header bg-primary text-white rounded-top-4">
                    <h5 class="modal-title">
                        <i class="bi bi-sliders2-vertical me-2"></i>
                        @((IsEditMode ? "Modifier" : "Ajouter") + " une règle d'ajustement")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>

                <EditForm Model="@NewAdjustment" OnValidSubmit="SaveAdjustment">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="modal-body">
                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Nom</label>
                                <InputText class="form-control" @bind-Value="NewAdjustment.Name" />
                                <ValidationMessage For="@(() => NewAdjustment.Name)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Montant</label>
                                <div class="input-group">
                                    <InputNumber class="form-control" @bind-Value="NewAdjustment.Amount" disabled="@NewAdjustment.IsEditable" />
                                    <span class="input-group-text">
                                        <InputCheckbox class="form-check-input mt-0" @bind-Value="NewAdjustment.IsPercentage" />
                                        <span class="ms-1">%</span>
                                    </span>
                                </div>
                                <ValidationMessage For="@(() => NewAdjustment.Amount)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Type</label>
                                <InputSelect class="form-select" @bind-Value="NewAdjustment.Type">
                                    <option disabled value="">-- Type --</option>
                                    <option value="@AdjustmentType.Bonus">Bonus</option>
                                    <option value="@AdjustmentType.Deduction">Déduction</option>
                                </InputSelect>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Règle avec quantité ?</label>
                                <div class="form-check mt-1">
                                    <InputCheckbox class="form-check-input" @bind-Value="NewAdjustment.IsCountable" />
                                    <label class="form-check-label ms-2">Oui</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Montant modifiable ?</label>
                                <div class="form-check mt-1">
                                    <InputCheckbox class="form-check-input"
                                    @bind-Value="NewAdjustment.IsEditable"
                                    @onchange="OnEditableChanged" />
                                    <label class="form-check-label ms-2">Oui</label>
                                </div>
                            </div>


                            <div class="col-md-12">
                                <label class="form-label fw-semibold">Postes associés</label>

                                <div class="position-relative">
                                    <button type="button"
                                    class="btn btn-outline-primary w-100 text-start d-flex justify-content-between align-items-center"
                                    @onclick="ToggleDropdown">
                                        <span>
                                            @((SelectedJobTitleIds.Any())
                                                        ? $"{SelectedJobTitleIds.Count} poste(s) sélectionné(s)"
                                                        : "Sélectionnez des postes")
                                        </span>
                                        <i class="bi bi-caret-down-fill"></i>
                                    </button>

                                    @if (ShowDropdown)
                                    {
                                        <div class="position-absolute w-100 bg-white border rounded mt-1 shadow zindex-dropdown"
                                        style="max-height: 220px; overflow-y: auto; padding: 8px;">
                                            @foreach (var jt in AllJobTitles)
                                            {
                                                <div class="form-check mb-2">
                                                    <input class="form-check-input"
                                                    type="checkbox"
                                                    id="jt_@jt.Id"
                                                    checked="@SelectedJobTitleIds.Contains(jt.Id)"
                                                    @onchange="() => ToggleJobTitleSelection(jt.Id)" />
                                                    <label class="form-check-label ms-2" for="jt_@jt.Id">@jt.Title</label>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                @if (ShowJobTitleValidation && !SelectedJobTitleIds.Any())
                                {
                                    <div class="text-danger mt-1">Veuillez sélectionner au moins un poste.</div>
                                }
                            </div>

                        </div>
                    </div>

                    <div class="modal-footer bg-light border-top-0 rounded-bottom-4">
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-check-circle me-2"></i>
                            @(IsEditMode ? "Enregistrer les modifications" : "Ajouter")
                        </button>
                        <button type="button" class="btn btn-outline-secondary px-4" @onclick="CloseModal">
                            <i class="bi bi-x-circle me-2"></i> Annuler
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private PayrollAdjustmentRule NewAdjustment = new() { Type = AdjustmentType.Bonus };
    private PayrollAdjustmentRule? EditingAdjustment;
    private List<JobTitle> AllJobTitles = new();
    private List<int> SelectedJobTitleIds = new();
    private List<PayrollAdjustmentRule> Adjustments = new();
    private bool isLoading = true;
    private bool ShowJobTitleValidation = false;
    private bool ShowModal = false;
    private bool IsEditMode = false;
    private bool ShowDropdown = false;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        AllJobTitles = await JobTitleService.GetAllAsync();
        await LoadAdjustments();
        isLoading = false;
    }

    private async Task LoadAdjustments()
    {
        Adjustments = await AdjustmentService.GetAllAsync();
    }

    private void ToggleJobTitleSelection(int id)
    {
        if (SelectedJobTitleIds.Contains(id))
            SelectedJobTitleIds.Remove(id);
        else
            SelectedJobTitleIds.Add(id);
    }
    private void OnEditableChanged(ChangeEventArgs e)
    {
        if (bool.TryParse(e?.Value?.ToString(), out var isEditable))
        {
            NewAdjustment.IsEditable = isEditable;

            if (isEditable)
            {
                NewAdjustment.Amount = 0; // force amount to 0
            }

            StateHasChanged(); // refresh form
        }
    }

    private void OpenEditModal(PayrollAdjustmentRule adjustment)
    {
        IsEditMode = true;
        EditingAdjustment = adjustment;
        NewAdjustment = new PayrollAdjustmentRule
            {
                Id = adjustment.Id,
                Name = adjustment.Name,
                Amount = adjustment.Amount,
                IsPercentage = adjustment.IsPercentage,
                Type = adjustment.Type,
                IsCountable = adjustment.IsCountable,
                JobTitles = new List<JobTitle>(adjustment.JobTitles)
            };
        SelectedJobTitleIds = adjustment.JobTitles.Select(j => j.Id).ToList();
        ShowModal = true;
    }

    private async Task SaveAdjustment()
    {
        ShowJobTitleValidation = SelectedJobTitleIds.Count == 0;
        if (string.IsNullOrWhiteSpace(NewAdjustment.Name) || ShowJobTitleValidation)
            return;
        if (NewAdjustment.IsEditable && NewAdjustment.Amount != 0)
        {
            NewAdjustment.Amount = 0;
        }
        NewAdjustment.JobTitles = AllJobTitles
            .Where(j => SelectedJobTitleIds.Contains(j.Id))
            .ToList();

        if (IsEditMode)
        {
            await AdjustmentService.UpdateAsync(NewAdjustment);
        }
        else
        {
            await AdjustmentService.AddAsync(NewAdjustment);
        }

        await LoadAdjustments();
        CloseModal();
    }

    private void CloseModal()
    {
        ShowModal = false;
        ShowJobTitleValidation = false;
        SelectedJobTitleIds.Clear();
        NewAdjustment = new PayrollAdjustmentRule { Type = AdjustmentType.Bonus };
        EditingAdjustment = null;
        IsEditMode = false;
    }

    private void ToggleDropdown()
    {
        ShowDropdown = !ShowDropdown;
    }

}
