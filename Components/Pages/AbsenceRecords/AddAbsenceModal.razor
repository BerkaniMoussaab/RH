@using RH.Models
@inject AbsenceService AbsenceService
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<EditForm Model="AbsenceForm" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <div class="modal show d-block fade" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-secondary text-white">
                    <h5 class="modal-title"><i class="bi bi-calendar-x me-2"></i>Ajouter une absence</h5>
                    <button type="button" class="btn-close" @onclick="OnClose" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Employé</label>
                        <InputSelect class="form-select" @bind-Value="AbsenceForm.EmployeeId">
                            <option value="">-- Choisir un employé --</option>
                            @foreach (var emp in Employees)
                            {
                                <option value="@emp.Id">@emp.FullName</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Date début</label>
                            <InputDate class="form-control" @bind-Value="AbsenceForm.StartDate" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Date fin</label>
                            <InputDate class="form-control" @bind-Value="AbsenceForm.EndDate" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Motif de l'absence</label>
                        <InputText class="form-control" @bind-Value="AbsenceForm.Reason" />
                    </div>

                    <div class="form-check mb-3">
                        <InputCheckbox class="form-check-input" @bind-Value="AbsenceForm.Counted" />
                        <label class="form-check-label">Absence comptabilisée</label>
                    </div>

                    <ValidationSummary />
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Enregistrer</button>
                    <button type="button" class="btn btn-secondary" @onclick="OnClose">Annuler</button>
                </div>
            </div>
        </div>
    </div>
</EditForm>

@code {
    [Parameter] public List<Employee> Employees { get; set; } = new();
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    // Form model (not your database entity)
    private AbsenceFormModel AbsenceForm = new()
    {
        StartDate = DateTime.Today,
        EndDate = DateTime.Today,
        Counted = true
    };

    private async Task HandleValidSubmit()
    {
        if (AbsenceForm.EndDate < AbsenceForm.StartDate)
        {
            // optional: show error message or ValidationMessage
            return;
        }

        for (var date = AbsenceForm.StartDate; date <= AbsenceForm.EndDate; date = date.AddDays(1))
        {
            var absence = new AbsenceRecord
            {
                EmployeeId = AbsenceForm.EmployeeId,
                Date = date,
                Reason = AbsenceForm.Reason,
                Counted = AbsenceForm.Counted
            };

            await AbsenceService.CreateAsync(absence);
        }

        await OnSaved.InvokeAsync();
        await OnClose.InvokeAsync();
    }

    // Local DTO just for the form
    private class AbsenceFormModel
    {
        public int EmployeeId { get; set; }
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public string Reason { get; set; } = string.Empty;
        public bool Counted { get; set; }
    }
}
