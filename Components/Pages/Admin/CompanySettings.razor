@page "/admin/settings"
@inject CompanyInfoService CompanyService
@using Microsoft.AspNetCore.Components.Forms
@using RH.Models
@using RH.Services

<div class="container my-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Paramètres de l'entreprise</h4>
        </div>
        <div class="card-body">
            <EditForm Model="@company" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Nom</label>
                        <InputText @bind-Value="company.Name" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Adresse</label>
                        <InputText @bind-Value="company.Address" class="form-control" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">RC</label>
                        <InputText @bind-Value="company.RC" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">NIF</label>
                        <InputText @bind-Value="company.NIF" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Ville</label>
                        <InputText @bind-Value="company.City" class="form-control" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Nom du Directeur</label>
                        <InputText @bind-Value="company.DirectorName" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Titre du Directeur</label>
                        <InputText @bind-Value="company.DirectorTitle" class="form-control" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Mobile</label>
                        <InputText @bind-Value="company.Mobile" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Téléphone</label>
                        <InputText @bind-Value="company.Phone" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Email</label>
                        <InputText @bind-Value="company.Email" class="form-control" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Matricule Fiscale</label>
                        <InputText @bind-Value="company.RegistrationNumber" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Jours récupération/travail</label>
                        <InputNumber @bind-Value="company.RecoveryDaysPerWorkedDayOff" step="0.1" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Jours/mois</label>
                        <InputNumber @bind-Value="company.WorKdaysInMonth" step="1" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Logo</label>
                    <InputFile OnChange="UploadLogo" class="form-control" />
                    @if (company.LogoBytes != null)
                    {
                        <div class="mt-3">
                            <img src="data:@company.LogoMimeType;base64,@Convert.ToBase64String(company.LogoBytes)" alt="Logo Entreprise" class="img-thumbnail" style="max-height: 100px;" />
                        </div>
                    }
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success">Enregistrer</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private CompanyInfo company = new();

    protected override async Task OnInitializedAsync()
    {
        company = await CompanyService.GetAsync();
    }

    private async Task Save()
    {
        await CompanyService.SaveAsync(company);
    }

    private async Task UploadLogo(InputFileChangeEventArgs e)
    {
        var file = e.File;

        // Optional: Limit file size to 1MB
        if (file.Size > 1024 * 1024)
        {
            // Optional: Show error message
            return;
        }

        using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        company.LogoBytes = ms.ToArray();
        company.LogoMimeType = file.ContentType;
    }
}
