@page "/job-titles"
@using RH.Models
@using RH.Services
@inject IJobTitleService JobTitleService
@inject ILeavePolicyService LeavePolicyService
@inject IJSRuntime JS

<h3 class="mb-4">Postes & Politiques de congé</h3>

<button class="btn btn-primary mb-3" @onclick="OpenCreateModal">Ajouter un poste</button>

@if (jobTitles == null)
{
    <p><em>Chargement...</em></p>
}
else if (!jobTitles.Any())
{
    <p>Aucun poste trouvé.</p>
}
else
{
    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Titre</th>
                <th>Description</th>
                <th>Politique de congé</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in jobTitles)
            {
                <tr>
                    <td>@job.Title</td>
                    <td>@job.Description</td>
                    <td>
                        @if (job.LeavePolicies?.Any() == true)
                        {
                            @string.Join(", ", job.LeavePolicies.Select(p => $"{p.AnnualLeaveDays} jours/an"))
                        }
                        else
                        {
                            <em>Non défini</em>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-warning me-1" @onclick="@(() => OpenEditModal(job))">Modifier</button>
                        <button class="btn btn-sm btn-danger" @onclick="@(() => DeleteJobTitle(job.Id))">Supprimer</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <EditForm Model="@currentJobTitle" OnValidSubmit="SaveJobTitle">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">@((isEditing ? "Modifier" : "Ajouter") + " un poste")</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Titre</label>
                            <InputText class="form-control" @bind-Value="currentJobTitle.Title" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" @bind-Value="currentJobTitle.Description" />
                        </div>

                        <hr />
                        <div class="mb-3">
                            <label class="form-label">Politique de congé (jours/an)</label>
                            <InputNumber class="form-control" @bind-Value="leaveDays" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Annuler</button>
                        <button type="submit" class="btn btn-success">Enregistrer</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<JobTitle>? jobTitles;
    private JobTitle currentJobTitle = new();
    private int leaveDays = 30;
    private bool showModal = false;
    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadJobTitles();
    }

    private async Task LoadJobTitles()
    {
        jobTitles = await JobTitleService.GetAllWithLeavePoliciesAsync();
    }

    private void OpenCreateModal()
    {
        currentJobTitle = new JobTitle();
        leaveDays = 30;
        isEditing = false;
        showModal = true;
    }

    private void OpenEditModal(JobTitle job)
    {
        currentJobTitle = new JobTitle
            {
                Id = job.Id,
                Title = job.Title,
                Description = job.Description,
            };

        var firstPolicy = job.LeavePolicies?.FirstOrDefault();
        leaveDays = firstPolicy?.AnnualLeaveDays ?? 30;

        isEditing = true;
        showModal = true;
    }

    private async Task SaveJobTitle()
    {
        LeavePolicy policy = new() { AnnualLeaveDays = leaveDays };
        await LeavePolicyService.CreateAsync(policy);

        if (isEditing)
        {
            await JobTitleService.UpdateAsync(currentJobTitle);
        }
        else
        {
            await JobTitleService.AddAsync(currentJobTitle);
        }

        // Re-link job title and leave policy
        await LeavePolicyService.AssignToJobTitleAsync(policy.Id, currentJobTitle.Id);

        showModal = false;
        await LoadJobTitles();
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task DeleteJobTitle(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Êtes-vous sûr de vouloir supprimer ce poste ?");
        if (confirmed)
        {
            await JobTitleService.DeleteAsync(id);
            await LoadJobTitles();
        }
    }
}
