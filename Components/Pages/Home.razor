@page "/"
@using Microsoft.AspNetCore.Authorization
@using RH.Components.Pages.Advance
@using RH.Components.Pages.AbsenceRecords
@using RH.Components.Pages.PayrollAdjustments
@using RH.Models
@using RH.Services
@inject IEmployeeService EmployeeService
@inject AbsenceService AbsenceService
@inject PayrollAdjustmentRuleService RuleService
@inject IPayrollService PayrollService
@inject IJobTitleService JobTitleService
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Dashboard</PageTitle>

<h3 class="mb-4">Tableau de Bord</h3>

<div class="row g-4">
    <div class="col-md-3" @onclick="@(() => NavigateTo("/employees"))">
        <div class="card shadow-sm border-0 text-white bg-primary h-100 cursor-pointer">
            <div class="card-body">
                <h5 class="card-title">Employés</h5>
                <p class="card-text fs-4">@Employees.Count</p>
            </div>
        </div>
    </div>
    <div class="col-md-3" @onclick="@(() => NavigateTo("/job-titles"))">
        <div class="card shadow-sm border-0 text-white bg-info h-100 cursor-pointer">
            <div class="card-body">
                <h5 class="card-title">Postes</h5>
                <p class="card-text fs-4">@JobTitlesCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3" @onclick="@(() => NavigateTo("/payrolls"))">
        <div class="card shadow-sm border-0 text-white bg-success h-100 cursor-pointer">
            <div class="card-body">
                <h5 class="card-title">Salaires</h5>
                <p class="card-text fs-4">@PayrollsCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3" @onclick="@(() => NavigateTo("/absences"))">
        <div class="card shadow-sm border-0 text-white bg-danger h-100 cursor-pointer">
            <div class="card-body">
                <h5 class="card-title">Absences</h5>
                <p class="card-text fs-4">@AbsencesCount</p>
            </div>
        </div>
    </div>
</div>

<div class="mt-5 d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Actions rapides</h5>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-success" @onclick="OpenNewPayrollModal">
            <i class="bi bi-currency-dollar me-1"></i>Ajouter une règle salaire
        </button>
        <button class="btn btn-outline-primary" @onclick="() => ShowAddAbsenceModal = true">
            <i class="bi bi-plus-circle me-1"></i>Ajouter une absence
        </button>
        <button class="btn btn-outline-warning" @onclick="() => showModal = true">
            <i class="bi bi-cash me-1"></i>Ajouter une avance
        </button>
    </div>
</div>

<AdvanceModal IsVisible="showModal"
              OnClose="CloseModal"
              OnAdvanceCreated="OnAdvanceCreated"
              PreselectedEmployeeId="employeeId" />

@if (ShowAddAbsenceModal)
{
    <AddAbsenceModal Employees="Employees"
                     OnClose="() => ShowAddAbsenceModal = false"
                     OnSaved="ReloadAbsenceCount" />
}

@if (ShowPayrollModal)
{
    <PayrollModal @bind-ShowModal="ShowPayrollModal"
                  @bind-NewAdjustment="NewPayrollAdjustment"
                  @bind-IsEditMode="IsEditPayrollMode"
                  @bind-SelectedJobTitleIds="SelectedPayrollJobTitleIds"
                  AllJobTitles="@AllJobTitles"
                  OnSave="HandlePayrollSave"
                  OnClose="ClosePayrollModal" />
}

@code {
    private List<Employee> Employees = new();
    private List<JobTitle> AllJobTitles = new();

    private int JobTitlesCount;
    private int PayrollsCount;
    private int AbsencesCount;

    private bool ShowAddAbsenceModal = false;
    private bool ShowPayrollModal = false;
    private bool IsEditPayrollMode = false;
    private bool showModal = false; // Added for AdvanceModal

    private int employeeId = 0; // Optional: used to preselect employee

    private PayrollAdjustmentRule NewPayrollAdjustment = new() { Type = AdjustmentType.Bonus };
    private List<int> SelectedPayrollJobTitleIds = new();

    protected override async Task OnInitializedAsync()
    {
        Employees = await EmployeeService.GetAllAsync();
        JobTitlesCount = await EmployeeService.GetJobTitleCountAsync();
        PayrollsCount = await PayrollService.GetPayrollCountAsync();
        AbsencesCount = await AbsenceService.GetTotalAbsenceCountAsync();
        AllJobTitles = await JobTitleService.GetAllAsync();
    }

    private async Task ReloadAbsenceCount()
    {
        AbsencesCount = await AbsenceService.GetTotalAbsenceCountAsync();
    }

    private void NavigateTo(string url)
    {
        Navigation.NavigateTo(url);
    }

    private void OpenNewPayrollModal()
    {
        IsEditPayrollMode = false;
        NewPayrollAdjustment = new PayrollAdjustmentRule { Type = AdjustmentType.Bonus };
        SelectedPayrollJobTitleIds = new();
        ShowPayrollModal = true;
    }

    private async Task HandlePayrollSave(PayrollAdjustmentRule adjustment)
    {
        await RuleService.AddAsync(adjustment);
        ShowPayrollModal = false;
        PayrollsCount = await PayrollService.GetPayrollCountAsync();
        StateHasChanged();
    }

    private Task ClosePayrollModal()
    {
        ShowPayrollModal = false;
        return Task.CompletedTask;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private void OnAdvanceCreated()
    {
        showModal = false;
        // Optionally refresh advances
    }
}
