@using Microsoft.AspNetCore.Components.Web
@inherits ErrorBoundaryBase
@inject ILogger<ErrorBoundary> Logger

@if (CurrentException is null)
{
    @ChildContent
}
else
{
    <div class="alert alert-danger" role="alert">
        <div class="d-flex align-items-center mb-3">
            <i class="fas fa-exclamation-triangle fa-2x me-3 text-danger"></i>
            <div>
                <h4 class="alert-heading mb-1">Une erreur s'est produite</h4>
                <p class="mb-0">Nous nous excusons pour ce désagrément. L'erreur a été enregistrée.</p>
            </div>
        </div>
        
        @if (ShowDetails)
        {
            <hr>
            <div class="mb-3">
                <h6>Détails de l'erreur :</h6>
                <div class="bg-light p-3 rounded">
                    <code>@CurrentException.Message</code>
                </div>
            </div>
            
            @if (ShowStackTrace && !string.IsNullOrEmpty(CurrentException.StackTrace))
            {
                <div class="mb-3">
                    <h6>Stack Trace :</h6>
                    <div class="bg-light p-3 rounded" style="max-height: 200px; overflow-y: auto;">
                        <pre><code>@CurrentException.StackTrace</code></pre>
                    </div>
                </div>
            }
        }
        
        <div class="d-flex gap-2">
            <button class="btn btn-primary" @onclick="Recover">
                <i class="fas fa-redo me-2"></i>
                Réessayer
            </button>
            
            <button class="btn btn-outline-secondary" @onclick="ToggleDetails">
                <i class="fas fa-@(ShowDetails ? "eye-slash" : "eye") me-2"></i>
                @(ShowDetails ? "Masquer" : "Afficher") les détails
            </button>
            
            @if (ShowDetails && !string.IsNullOrEmpty(CurrentException.StackTrace))
            {
                <button class="btn btn-outline-info" @onclick="ToggleStackTrace">
                    <i class="fas fa-@(ShowStackTrace ? "eye-slash" : "eye") me-2"></i>
                    @(ShowStackTrace ? "Masquer" : "Afficher") Stack Trace
                </button>
            }
            
            <button class="btn btn-outline-warning" @onclick="CopyError">
                <i class="fas fa-copy me-2"></i>
                Copier l'erreur
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ShowDetails { get; set; } = false;
    [Parameter] public bool ShowStackTrace { get; set; } = false;

    protected override Task OnErrorAsync(Exception exception)
    {
        Logger.LogError(exception, "Erreur capturée par ErrorBoundary: {Message}", exception.Message);
        return Task.CompletedTask;
    }

    private void ToggleDetails()
    {
        ShowDetails = !ShowDetails;
        StateHasChanged();
    }

    private void ToggleStackTrace()
    {
        ShowStackTrace = !ShowStackTrace;
        StateHasChanged();
    }

    private async Task CopyError()
    {
        if (CurrentException != null)
        {
            var errorText = $"Erreur: {CurrentException.Message}\n\nStack Trace:\n{CurrentException.StackTrace}";
            
            // Utiliser JavaScript pour copier dans le presse-papiers
            await JSRuntime.InvokeVoidAsync("copyToClipboard", errorText);
        }
    }
}

@inject IJSRuntime JSRuntime

