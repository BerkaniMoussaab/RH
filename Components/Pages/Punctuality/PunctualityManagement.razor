@page "/punctuality-management"
@using RH.Models
@using RH.Models.Attendance
@using RH.Services
@using RH.Services.Interfaces
@inject IPayrollAdjustmentRuleService PayrollRuleService
@inject IExcelReaderService ExcelReaderService
@inject IAttendanceProcessingService AttendanceProcessingService
@inject IPayrollService PayrollService
@inject IJSRuntime JSRuntime

<PageTitle>Gestion de la Ponctualité</PageTitle>

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="simple-stepper-container">

                <!-- Header -->
                <div class="text-center mb-4">
                    <h2 class="mb-2" style="color: #1e293b; font-weight: 600;">
                        <i class="fas fa-clock me-2" style="color: #3b82f6;"></i>
                        Gestion de la Ponctualité
                    </h2>
                    <p style="color: #64748b; margin: 0;">Configurez vos règles de bonus et déductions en 5 étapes simples</p>
                </div>

                <!-- Progress Section -->
                <div class="progress-section">
                    <div class="progress-text">
                        Étape @currentStep sur 5 - @(((double)currentStep / 5) * 100):F0% terminé
                    </div>
                    <div class="progress-bar-simple">
                        <div class="progress-fill" style="width:@(((double)currentStep / 5) * 100):F0%"></div>
                    </div>
                </div>


                <!-- Simple Stepper -->
                <div class="stepper-simple">

                    <!-- Step 1 -->
                    <div class="step-simple @GetStepClass(1)">
                        <div class="step-circle">
                            @if (currentStep > 1)
                            {
                                <i class="fas fa-check"></i>
                            }
                            else
                            {
                                <span>1</span>
                            }
                            @if (currentStep == 1)
                            {
                                <div class="current-indicator">●</div>
                            }
                        </div>
                        <div class="step-label">Configuration</div>
                    </div>

                    <!-- Step 2 -->
                    <div class="step-simple @GetStepClass(2)">
                        <div class="step-circle">
                            @if (currentStep > 2)
                            {
                                <i class="fas fa-check"></i>
                            }
                            else
                            {
                                <span>2</span>
                            }
                            @if (currentStep == 2)
                            {
                                <div class="current-indicator">●</div>
                            }
                        </div>
                        <div class="step-label">Upload Excel</div>
                    </div>

                    <!-- Step 3 -->
                    <div class="step-simple @GetStepClass(3)">
                        <div class="step-circle">
                            @if (currentStep > 3)
                            {
                                <i class="fas fa-check"></i>
                            }
                            else
                            {
                                <span>3</span>
                            }
                            @if (currentStep == 3)
                            {
                                <div class="current-indicator">●</div>
                            }
                        </div>
                        <div class="step-label">Colonnes</div>
                    </div>

                    <!-- Step 4 -->
                    <div class="step-simple @GetStepClass(4)">
                        <div class="step-circle">
                            @if (currentStep > 4)
                            {
                                <i class="fas fa-check"></i>
                            }
                            else
                            {
                                <span>4</span>
                            }
                            @if (currentStep == 4)
                            {
                                <div class="current-indicator">●</div>
                            }
                        </div>
                        <div class="step-label">Seuils</div>
                    </div>

                    <!-- Step 5 -->
                    <div class="step-simple @GetStepClass(5)">
                        <div class="step-circle">
                            @if (currentStep > 5)
                            {
                                <i class="fas fa-check"></i>
                            }
                            else
                            {
                                <span>5</span>
                            }
                            @if (currentStep == 5)
                            {
                                <div class="current-indicator">●</div>
                            }
                        </div>
                        <div class="step-label">Résultats</div>
                    </div>

                </div>

                <!-- Step Content -->
                <div class="step-content">
                    @if (currentStep == 1)
                    {
                        <div class="step-title">
                            <i class="fas fa-cog step-icon"></i>
                            Configuration des Règles
                        </div>
                        <div class="step-description">
                            Sélectionnez les règles de bonus et de déduction à appliquer pour le calcul de la ponctualité.
                        </div>
                        <RuleSelectionComponent @bind-BonusRule="selectedBonusRule"
                                                @bind-DeductionRule="selectedDeductionRule"
                                                OnNext="() => NextStep()" />
                    }
                    else if (currentStep == 2)
                    {
                        <div class="step-title">
                            <i class="fas fa-upload step-icon"></i>
                            Import du Fichier Excel
                        </div>
                        <div class="step-description">
                            Téléchargez votre fichier Excel contenant les données d'attendance des employés.
                        </div>
                        <FileUploadComponent @bind-ExcelData="excelData"
                                             OnNext="() => NextStep()"
                                             OnPrevious="() => PreviousStep()" />
                    }
                    else if (currentStep == 3)
                    {
                        <div class="step-title">
                            <i class="fas fa-columns step-icon"></i>
                            Mapping des Colonnes
                        </div>
                        <div class="step-description">
                            Associez les colonnes de votre fichier Excel aux champs requis pour le traitement.
                        </div>
                        <ColumnSelectorComponent ExcelData="excelData"
                                                 @bind-ColumnMapping="columnMapping"
                                                 OnNext="() => NextStep()"
                                                 OnPrevious="() => PreviousStep()" />
                    }
                    else if (currentStep == 4)
                    {
                        <div class="step-title">
                            <i class="fas fa-sliders-h step-icon"></i>
                            Configuration des Seuils
                        </div>
                        <div class="step-description">
                            Définissez les seuils de ponctualité qui détermineront l'application des bonus et déductions.
                        </div>
                        <ThresholdConfigComponent @bind-Thresholds="thresholds"
                                                  OnNext="() => ProcessAttendance()"
                                                  OnPrevious="() => PreviousStep()" />
                    }
                    else if (currentStep == 5)
                    {
                        <div class="step-title">
                            <i class="fas fa-chart-bar step-icon"></i>
                            Résultats du Traitement
                        </div>
                        <div class="step-description">
                            Consultez les résultats calculés et validez les modifications avant la sauvegarde.
                        </div>
                        <ResultsComponent ProcessingResult="processingResult"
                                          BonusRule="selectedBonusRule"
                                          DeductionRule="selectedDeductionRule"
                                          OnSave="() => SaveResults()"
                                          OnPrevious="() => PreviousStep()"
                                          OnReset="() => ResetProcess()" />
                    }
                </div>

                <!-- Navigation -->
               @*  <div class="nav-section">
                    <button class="btn-simple btn-secondary-simple"
                            @onclick="PreviousStep"
                            disabled="@(currentStep <= 1)">
                        <i class="fas fa-arrow-left"></i>
                        Précédent
                    </button>

                    @if (currentStep < 5)
                    {
                        <button class="btn-simple btn-primary-simple" @onclick="NextStep">
                            Suivant
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    }
                    else
                    {
                        <button class="btn-simple btn-primary-simple" @onclick="SaveResults">
                            <i class="fas fa-save"></i>
                            Sauvegarder
                        </button>
                    }
                </div> *@

                <!-- Alerts -->
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert-simple alert-error">
                        <i class="fas fa-exclamation-triangle"></i>
                        @errorMessage
                    </div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert-simple alert-success">
                        <i class="fas fa-check-circle"></i>
                        @successMessage
                    </div>
                }

            </div>
        </div>
    </div>
</div>

<!-- Loading Overlay -->
@if (isLoading)
{
    <div class="loading-simple">
        <div class="loading-content">
            <div class="spinner-simple"></div>
            <div style="color: #64748b; font-weight: 500;">@loadingMessage</div>
        </div>
    </div>
}

@code {
    private int currentStep = 1;
    private bool isLoading = false;
    private string loadingMessage = "";
    private string errorMessage = "";
    private string successMessage = "";

    // Data models
    private PayrollAdjustmentRule? selectedBonusRule;
    private PayrollAdjustmentRule? selectedDeductionRule;
    private ExcelData? excelData;
    private ColumnMapping columnMapping = new();
    private PunctualityThresholds thresholds = new();
    private AttendanceProcessingResult? processingResult;

    private string GetStepClass(int step)
    {
        if (step < currentStep) return "completed";
        if (step == currentStep) return "active";
        return "pending";
    }

    private void NextStep()
    {
        if (ValidateCurrentStep())
        {
            currentStep++;
            ClearMessages();
            StateHasChanged();
        }
    }

    private void PreviousStep()
    {
        if (currentStep > 1)
        {
            currentStep--;
            ClearMessages();
            StateHasChanged();
        }
    }

    private void ClearMessages()
    {
        errorMessage = "";
        successMessage = "";
    }

    private bool ValidateCurrentStep()
    {
        errorMessage = "";

        switch (currentStep)
        {
            case 1:
                if (selectedBonusRule == null || selectedDeductionRule == null)
                {
                    errorMessage = "Veuillez sélectionner une règle de bonus et une règle de déduction.";
                    return false;
                }
                break;
            case 2:
                if (excelData == null || !excelData.Rows.Any())
                {
                    errorMessage = "Veuillez charger un fichier Excel valide.";
                    return false;
                }
                break;
            case 3:
                if (columnMapping.NameColumnIndex < 0 || columnMapping.DateTimeColumnIndex < 0)
                {
                    errorMessage = "Veuillez sélectionner les colonnes nom et date/heure.";
                    return false;
                }
                break;
        }

        return true;
    }

    private async Task ProcessAttendance()
    {
        if (!ValidateCurrentStep())
            return;

        try
        {
            isLoading = true;
            loadingMessage = "Traitement des données en cours...";
            StateHasChanged();

            var attendanceRecords = await ExcelReaderService.ConvertToAttendanceRecordsAsync(excelData!, columnMapping);

            thresholds.BonusRuleId = selectedBonusRule!.Id;
            thresholds.DeductionRuleId = selectedDeductionRule!.Id;

            processingResult = await AttendanceProcessingService.ProcessAttendanceAsync(
                attendanceRecords, thresholds, selectedBonusRule!, selectedDeductionRule!);

            currentStep = 5;
            successMessage = $"Traitement terminé! {processingResult.EmployeeResults.Count} employé(s) traité(s).";
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveResults()
    {
        if (processingResult == null)
            return;

        try
        {
            isLoading = true;
            loadingMessage = "Sauvegarde en cours...";
            StateHasChanged();

            var selectedResults = processingResult.EmployeeResults.Where(r => r.IsSelected).ToList();
            var appliedRules = await AttendanceProcessingService.CreateAppliedRulesAsync(
                selectedResults, selectedBonusRule!, selectedDeductionRule!);

            var rulesByEmployee = appliedRules
                .Where(r => r.EmployeeId.HasValue)
                .GroupBy(r => r.EmployeeId.Value);

            foreach (var group in rulesByEmployee)
            {
                int employeeId = group.Key;
                var employeeRules = group.ToList();
                await PayrollService.ApplyRulesAsync(employeeId, employeeRules);
            }

            successMessage = $"Succès! {appliedRules.Count} règle(s) appliquée(s).";

            await Task.Delay(2000);
            ResetProcess();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors de la sauvegarde: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ResetProcess()
    {
        currentStep = 1;
        selectedBonusRule = null;
        selectedDeductionRule = null;
        excelData = null;
        columnMapping = new();
        thresholds = new();
        processingResult = null;
        ClearMessages();
        StateHasChanged();
    }
}

