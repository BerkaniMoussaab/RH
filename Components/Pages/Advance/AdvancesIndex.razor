@page "/advances"
@using RH.Models
@using RH.Services
@inject IAdvanceService AdvanceService
@inject IEmployeeService EmployeeService
@inject IJSRuntime JS

<PageTitle>Gestion des Avances</PageTitle>

<h4 class="mb-4 text-primary">
    <i class="bi bi-cash-coin me-2"></i>Gestion des Avances
</h4>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="fromDate" class="form-label fw-bold">Date de début</label>
                <input type="date" class="form-control" id="fromDate" @bind="FromDate" @bind:after="FilterDeductions" />
            </div>
            <div class="col-md-4">
                <label for="toDate" class="form-label fw-bold">Date de fin</label>
                <input type="date" class="form-control" id="toDate" @bind="ToDate" @bind:after="FilterDeductions" />
            </div>
        </div>
    </div>
</div>

@if (FilteredAdvances == null)
{
    <div class="text-muted">Chargement...</div>
}
else if (!FilteredAdvances.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        Aucune avance enregistrée pour cette période.
    </div>
}
else
{
    @foreach (var advance in FilteredAdvances)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <div class="fw-bold">
                    <i class="bi bi-person-circle me-1"></i>@advance.Employee?.FullName
                </div>
                <span class="badge bg-@GetStatusColor(advance.Status)">
                    @advance.Status
                </span>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-3">
                        <i class="bi bi-currency-dollar me-1 text-success"></i>
                        <strong>Montant :</strong> @advance.Amount.ToString("C")
                    </div>
                    <div class="col-md-3">
                        <i class="bi bi-wallet2 me-1 text-warning"></i>
                        <strong>Restant :</strong> @advance.RemainingAmount.ToString("C")
                    </div>
                    <div class="col-md-3">
                        <i class="bi bi-calendar-event me-1 text-info"></i>
                        <strong>Date :</strong> @advance.Date.ToShortDateString()
                    </div>
                    <div class="col-md-3 text-end">
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAdvance(advance.Id)">
                            <i class="bi bi-trash me-1"></i>Supprimer
                        </button>
                    </div>
                </div>

                <div class="mb-2">
                    <i class="bi bi-chat-left-text me-1 text-secondary"></i>
                    <strong>Raison :</strong> @advance.Reason
                </div>

                @if (FilteredDeductions.TryGetValue(advance.Id, out var deductions) && deductions.Any())
                {
                    <div class="mt-3">
                        <h6 class="text-muted">
                            <i class="bi bi-list-check me-1"></i>Détails des Déductions
                        </h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Montant Déduit</th>
                                        <th>Bulletin</th>
                                        <th class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in deductions)
                                    {
                                        <tr>
                                            <td>@d.DeductionDate.ToShortDateString()</td>
                                            <td>@d.DeductedAmount.ToString("C")</td>
                                            <td>@d.PayrollId</td>
                                            <td class="text-center">
                                                <button class="btn btn-outline-danger btn-sm" title="Supprimer"
                                                        @onclick="() => DeleteDeduction(d.Id)">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private List<Advance> AllAdvances;
    private List<Advance> FilteredAdvances;
    private Dictionary<int, List<AdvanceDeduction>> FilteredDeductions = new();

    private DateTime FromDate { get; set; } = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime ToDate { get; set; } = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        AllAdvances = await AdvanceService.GetAllWithDeductionsAsync();
        FilterDeductions();
    }

    private void FilterDeductions()
    {
        FilteredAdvances = AllAdvances;

        FilteredDeductions = AllAdvances.ToDictionary(
            a => a.Id,
            a => a.Deductions?
                .Where(d => d.DeductionDate.Date >= FromDate && d.DeductionDate.Date <= ToDate)
                .ToList() ?? new()
        );
    }

    private async Task DeleteAdvance(int advanceId)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Confirmer la suppression de l'avance ?"))
        {
            await AdvanceService.DeleteAsync(advanceId);
            AllAdvances = await AdvanceService.GetAllWithDeductionsAsync();
            FilterDeductions();
        }
    }

    private async Task DeleteDeduction(int deductionId)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Confirmer la suppression de la déduction ?"))
        {
            await AdvanceService.DeleteDeductionAsync(deductionId);
            AllAdvances = await AdvanceService.GetAllWithDeductionsAsync();
            FilterDeductions();
        }
    }

    private string GetStatusColor(AdvanceStatus status) => status switch
    {
        AdvanceStatus.Active => "primary",
        AdvanceStatus.Completed => "success",
        AdvanceStatus.Cancelled => "secondary",
        _ => "light"
    };
}
