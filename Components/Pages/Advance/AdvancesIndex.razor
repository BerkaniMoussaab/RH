@page "/advances"
@using RH.Models
@using RH.Services
@inject IAdvanceService AdvanceService
@inject IEmployeeService EmployeeService
@inject IJSRuntime JS

<PageTitle>Gestion des Avances</PageTitle>

<link href="css/advances.css" rel="stylesheet" />

<div class="page-header bg-gradient-primary text-white py-4 shadow-sm rounded mb-4">
    <div class="container">
        <h1 class="page-title mb-1">
            <i class="bi bi-cash-coin me-2"></i>
            Gestion des Avances
        </h1>
        <p class="page-subtitle text-light-emphasis">Suivez les avances et les déductions associées aux employés</p>
    </div>
</div>

<div class="container">
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-4">
                    <label for="fromDate" class="form-label">Date de début</label>
                    <input type="date" class="form-control shadow-sm" id="fromDate" @bind="FromDate" @bind:after="FilterDeductions" />
                </div>
                <div class="col-md-4">
                    <label for="toDate" class="form-label">Date de fin</label>
                    <input type="date" class="form-control shadow-sm" id="toDate" @bind="ToDate" @bind:after="FilterDeductions" />
                </div>
                <div class="col-md-4">
                    <label for="searchText" class="form-label">Rechercher</label>
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control" placeholder="Nom de l'employé..." @bind="SearchText" @bind:after="FilterDeductions" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (FilteredAdvances == null)
    {
        <div class="loading-skeleton fade-in"></div>
        <div class="loading-skeleton fade-in" style="animation-delay: 0.1s;"></div>
        <div class="loading-skeleton fade-in" style="animation-delay: 0.2s;"></div>
    }
    else if (!FilteredAdvances.Any())
    {
        <div class="empty-state fade-in">
            <div class="empty-icon">
                <i class="bi bi-inbox"></i>
            </div>
            <h3 class="empty-title">Aucune avance trouvée</h3>
            <p class="empty-description">
                Aucune avance n'a été enregistrée pour la période sélectionnée ou les critères de recherche.
                <br>Modifiez vos filtres ou ajoutez une nouvelle avance.
            </p>
        </div>
    }
    else
    {
        @foreach (var advance in FilteredAdvances)
        {
            <div class="card advance-card shadow-sm mb-4 border-0 fade-in">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center avatar-circle">
                            @GetInitials(advance.Employee?.FullName)
                        </div>
                        <div class="fw-semibold">@advance.Employee?.FullName</div>
                    </div>
                    <span class="badge @GetStatusClass(advance.Status)">@advance.Status</span>
                </div>
                <div class="card-body">
                    <div class="row g-4 mb-3">
                        <div class="col-md-4">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-currency-dollar fs-5 text-primary me-2"></i>
                                <div>
                                    <div class="fw-semibold text-muted">Montant</div>
                                    <div class="fw-bold">@advance.Amount.ToString("C")</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-wallet2 fs-5 text-success me-2"></i>
                                <div>
                                    <div class="fw-semibold text-muted">Restant</div>
                                    <div class="fw-bold">@advance.RemainingAmount.ToString("C")</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-calendar-event fs-5 text-secondary me-2"></i>
                                <div>
                                    <div class="fw-semibold text-muted">Date</div>
                                    <div class="fw-bold">@advance.Date.ToString("dd/MM/yyyy")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(advance.Reason))
                    {
                        <div class="mb-3">
                            <div class="fw-semibold text-muted mb-1">
                                <i class="bi bi-chat-left-text me-1 text-info"></i>Raison
                            </div>
                            <div class="border-start ps-3 text-body">@advance.Reason</div>
                        </div>
                    }

                    @if (FilteredDeductions.TryGetValue(advance.Id, out var deductions) && deductions.Any())
                    {
                        <div class="table-responsive mt-3">
                            <h6 class="fw-semibold text-muted mb-2"><i class="bi bi-list-check me-1"></i> Déductions (@deductions.Count)</h6>
                            <table class="table table-sm table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Montant Déduit</th>
                                        <th>Bulletin</th>
                                        <th class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in deductions)
                                    {
                                        <tr>
                                            <td>@d.DeductionDate.ToString("dd/MM/yyyy")</td>
                                            <td><strong>@d.DeductedAmount.ToString("C")</strong></td>
                                            <td>@d.PayrollId</td>
                                            <td class="text-center">
                                                <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteDeduction(d.Id)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="d-flex justify-content-end mt-3">
                        <button class="btn btn-outline-danger" @onclick="() => DeleteAdvance(advance.Id)">
                            <i class="bi bi-trash me-1"></i> Supprimer l'avance
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<Advance> AllAdvances;
    private List<Advance> FilteredAdvances;
    private Dictionary<int, List<AdvanceDeduction>> FilteredDeductions = new();

    private DateTime FromDate { get; set; } = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime ToDate { get; set; } = DateTime.Today;
    private string SearchText { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        AllAdvances = await AdvanceService.GetAllWithDeductionsAsync();
        FilterDeductions();
    }

    private void FilterDeductions()
    {
        FilteredAdvances = AllAdvances
            .Where(a => string.IsNullOrEmpty(SearchText) ||
                       (a.Employee?.FullName?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();

        FilteredDeductions = FilteredAdvances.ToDictionary(
            a => a.Id,
            a => a.Deductions?
                .Where(d => d.DeductionDate.Date >= FromDate && d.DeductionDate.Date <= ToDate)
                .OrderByDescending(d => d.DeductionDate)
                .ToList() ?? new()
        );
    }

    private async Task DeleteAdvance(int advanceId)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Êtes-vous sûr de vouloir supprimer cette avance ? Cette action est irréversible."))
        {
            try
            {
                await AdvanceService.DeleteAsync(advanceId);
                AllAdvances = await AdvanceService.GetAllWithDeductionsAsync();
                FilterDeductions();
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("alert", $"Erreur : {ex.Message}");
            }
        }
    }

    private async Task DeleteDeduction(int deductionId)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Êtes-vous sûr de vouloir supprimer cette déduction ?"))
        {
            try
            {
                await AdvanceService.DeleteDeductionAsync(deductionId);
                AllAdvances = await AdvanceService.GetAllWithDeductionsAsync();
                FilterDeductions();
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("alert", $"Erreur : {ex.Message}");
            }
        }
    }

    private string GetStatusClass(AdvanceStatus status) => status switch
    {
        AdvanceStatus.Active => "status-active",
        AdvanceStatus.Completed => "status-completed",
        AdvanceStatus.Cancelled => "status-cancelled",
        _ => "status-cancelled"
    };

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrEmpty(fullName)) return "??";

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();

        return parts.Length > 0 ? parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper() : "??";
    }
}
