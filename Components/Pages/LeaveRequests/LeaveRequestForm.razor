@using RH.Models
@using RH.Services
@inject IEmployeeService EmployeeService
@inject ILeaveRequestService LeaveRequestService
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@if (editContext != null)
{
    <EditForm EditContext="editContext" OnValidSubmit="HandleValidSubmit">
        <div class="modal @(IsOpen ? "show d-block fade" : "fade")" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg rounded-3">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title d-flex align-items-center">
                            <i class="bi bi-calendar-check me-2 fs-4"></i>
                            @((LeaveRequest.Id == 0) ? "Nouvelle demande de congé" : "Modifier la demande de congé")
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="Close" aria-label="Fermer"></button>
                    </div>

                    <div class="modal-body">
                        <div class="row g-3">
                            <!-- Employé -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Employé</label>
                                <InputSelect class="form-select" @bind-Value="CurrentEmployeeId">
                                    <option value="">-- Sélectionner un employé --</option>
                                    @foreach (var emp in Employees)
                                    {
                                        <option value="@emp.Id">@emp.FullName</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => LeaveRequest.EmployeeId)" />
                                @if (isLoadingRemainingDays)
                                {
                                    <span class="badge bg-info mt-2">
                                        <i class="bi bi-hourglass-split me-1"></i>Chargement...
                                    </span>
                                }
                                else if (RemainingDays != null)
                                {
                                    <span class="badge @GetRemainingDaysBadgeClass() mt-2">
                                        <i class="bi bi-clock-history me-1"></i>Reste : @RemainingDays.Value.ToString("0.0") jour(s)
                                    </span>
                                }
                            </div>

                            <!-- Date de début -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Date de début</label>
                                <InputDate class="form-control" @bind-Value="LeaveRequest.StartDate" />
                                <ValidationMessage For="@(() => LeaveRequest.StartDate)" />
                            </div>

                            <!-- Date de fin -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Date de fin</label>
                                <InputDate class="form-control" @bind-Value="LeaveRequest.EndDate" />
                                <ValidationMessage For="@(() => LeaveRequest.EndDate)" />
                            </div>

                            <!-- Motif -->
                            <div class="col-md-12">
                                <label class="form-label fw-semibold">Motif</label>
                                <InputTextArea class="form-control" @bind-Value="LeaveRequest.Reason" rows="3" />
                                <ValidationMessage For="@(() => LeaveRequest.Reason)" />
                            </div>

                            <!-- Congé payé -->
                            <div class="col-md-6 d-flex align-items-center mt-2">
                                <InputCheckbox class="form-check-input me-2" @bind-Value="LeaveRequest.IsPaid" />
                                <label class="form-check-label fw-semibold">Congé payé</label>
                            </div>

                            <!-- Statut -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Statut</label>
                                <InputSelect class="form-select" @bind-Value="LeaveRequest.Status">
                                    @foreach (var status in Enum.GetValues<LeaveStatus>())
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => LeaveRequest.Status)" />
                            </div>
                        </div>

                        <!-- Message d'erreur -->
                        @if (!string.IsNullOrWhiteSpace(ValidationMessage))
                        {
                            <div class="alert alert-danger mt-4">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>@ValidationMessage
                            </div>
                        }

                        <DataAnnotationsValidator />
                    </div>

                    <div class="modal-footer bg-light border-top-0">
                        <button type="submit" class="btn btn-success px-4" disabled="@isSubmitting">
                            <i class="bi bi-save me-2"></i>@(isSubmitting ? "Enregistrement..." : "Enregistrer")
                        </button>
                        <button type="button" class="btn btn-outline-secondary px-4" @onclick="Close">
                            <i class="bi bi-x-circle me-2"></i>Annuler
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter] public LeaveRequest LeaveRequest { get; set; } = new();
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<LeaveRequest> OnSave { get; set; }

    private List<Employee> Employees = new();
    private float? RemainingDays;
    private string? ValidationMessage;
    private EditContext? editContext;
    private bool isLoadingRemainingDays;
    private bool isSubmitting;

    private int CurrentEmployeeId
    {
        get => LeaveRequest.EmployeeId;
        set
        {
            if (LeaveRequest.EmployeeId != value)
            {
                LeaveRequest.EmployeeId = value;
                GetRemainingDaysBadgeClass();
                InvokeAsync(async () => await OnEmployeeChanged(value));
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Employees = await EmployeeService.GetAllAsync() ?? new();
            RemainingDays = null;
            if (LeaveRequest.EmployeeId != 0)
            {
                GetRemainingDaysBadgeClass();
            }
        }
        catch (Exception ex)
        {
            ValidationMessage = "Erreur lors du chargement des employés";
            Console.Error.WriteLine(ex);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        RemainingDays = null;
        editContext = new EditContext(LeaveRequest);

        if (LeaveRequest.EmployeeId != 0)
        {
            try
            {
                isLoadingRemainingDays = true;
                StateHasChanged();
                RemainingDays = await LeaveRequestService.GetRemainingDaysAsync(LeaveRequest.EmployeeId);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine(ex);
                ValidationMessage = "Erreur lors du chargement des jours restants";
            }
            finally
            {
                isLoadingRemainingDays = false;
                StateHasChanged();
            }
        }
    }



    private async Task OnEmployeeChanged(int employeeId)
    {
        if (employeeId > 0)
        {
            try
            {
                isLoadingRemainingDays = true;
                StateHasChanged();

                RemainingDays = await LeaveRequestService.GetRemainingDaysAsync(employeeId);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine(ex);
                ValidationMessage = "Erreur lors du chargement des jours restants";
                RemainingDays = null;
            }
            finally
            {
                isLoadingRemainingDays = false;
                StateHasChanged();
            }
        }
        else
        {
            RemainingDays = null;
        }
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        StateHasChanged();

        try
        {
            var validationResult = ValidateLeaveRequest();
            if (!validationResult.isValid)
            {
                ValidationMessage = validationResult.message;
                return;
            }

            await OnSave.InvokeAsync(LeaveRequest);
            await Close();
        }
        catch (Exception ex)
        {
            ValidationMessage = "Erreur lors de l'enregistrement de la demande";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private (bool isValid, string message) ValidateLeaveRequest()
    {
        if (LeaveRequest.EmployeeId <= 0)
        {
            return (false, "Veuillez sélectionner un employé");
        }

        if (LeaveRequest.StartDate == default || LeaveRequest.EndDate == default)
        {
            return (false, "Veuillez spécifier les dates de début et de fin");
        }

        if (LeaveRequest.StartDate > LeaveRequest.EndDate)
        {
            return (false, "La date de fin ne peut pas être avant la date de début");
        }

        if (LeaveRequest.StartDate < DateTime.Today)
        {
            return (false, "La date de début ne peut pas être dans le passé");
        }

        if (string.IsNullOrWhiteSpace(LeaveRequest.Reason))
        {
            return (false, "Veuillez spécifier un motif");
        }

        if (LeaveRequest.IsPaid && RemainingDays.HasValue)
        {
            var requestedDays = (float)(LeaveRequest.EndDate - LeaveRequest.StartDate).TotalDays + 1;
            if (requestedDays > RemainingDays.Value)
            {
                return (false, $"Congé payé demandé ({requestedDays:0.0} jours) dépasse le solde restant ({RemainingDays.Value:0.0} jours)");
            }
        }

        return (true, null);
    }

    private async Task Close()
    {
        ValidationMessage = null;
        await IsOpenChanged.InvokeAsync(false);
    }

    private string GetRemainingDaysBadgeClass()
    {
        if (!RemainingDays.HasValue) return "bg-secondary";

        if (LeaveRequest.StartDate == default || LeaveRequest.EndDate == default)
            return "bg-success";

        var requestedDays = (LeaveRequest.EndDate - LeaveRequest.StartDate).TotalDays + 1;
        return requestedDays > RemainingDays.Value ? "bg-danger" : "bg-success";
    }
}