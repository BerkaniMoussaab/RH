@using RH.Models
@using RH.Services
@inject IEmployeeService EmployeeService
@inject ILeaveRequestService LeaveRequestService
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@if (editContext != null)
{
    <EditForm EditContext="editContext" OnValidSubmit="HandleValidSubmit">
        <div class="modal @(IsOpen ? "show d-block fade enhanced-modal-backdrop" : "fade")" tabindex="-1">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content enhanced-modal">
                    <!-- Enhanced Modal Header -->
                    <div class="modal-header enhanced-modal-header">
                        <div class="modal-title-wrapper">
                            <div class="modal-icon">
                                <i class="bi bi-calendar-check-fill"></i>
                            </div>
                            <div class="modal-title-content">
                                <h5 class="modal-title">
                                    @((LeaveRequest.Id == 0) ? "Nouvelle demande de congé" : "Modifier la demande de congé")
                                </h5>
                                <small class="modal-subtitle">
                                    @((LeaveRequest.Id == 0) ? "Créez une nouvelle demande de congé pour un employé" : "Modifiez les détails de la demande existante")
                                </small>
                            </div>
                        </div>
                        <button type="button" class="btn-close bg-white" @onclick="Close" aria-label="Fermer"></button>
                    </div>

                    <!-- Enhanced Modal Body -->
                    <div class="modal-body enhanced-modal-body">
                        <div class="form-sections">
                            <!-- Section Employé et Informations -->
                            <div class="form-section compact-section">
                                <div class="section-title compact-title">
                                    <i class="bi bi-person-fill text-primary me-2"></i>
                                    Informations de l'employé
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-8">
                                        <div class="enhanced-form-group compact-form-group">
                                            <label class="form-label enhanced-label compact-label">
                                                <i class="bi bi-person me-1"></i>
                                                Employé
                                            </label>
                                            <InputSelect class="form-select enhanced-select compact-input" @bind-Value="CurrentEmployeeId">
                                                <option value="">-- Sélectionner un employé --</option>
                                                @foreach (var emp in Employees)
                                                {
                                                    <option value="@emp.Id">@emp.FullName</option>
                                                }
                                            </InputSelect>
                                            <ValidationMessage For="@(() => LeaveRequest.EmployeeId)" class="validation-message-enhanced" />
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <!-- Compact Remaining Days Display -->
                                        <div class="compact-remaining-days">
                                            <label class="form-label enhanced-label compact-label">
                                                <i class="bi bi-clock-history me-1"></i>
                                                Jours restants
                                            </label>
                                            @if (isLoadingRemainingDays)
                                            {
                                                <div class="compact-loading-badge">
                                                    <div class="loading-spinner-small"></div>
                                                    <span>Chargement...</span>
                                                </div>
                                            }
                                            else if (RemainingDays != null)
                                            {
                                                <div class="compact-remaining-badge @GetRemainingDaysBadgeClass()">
                                                    <span class="remaining-value">@RemainingDays.Value.ToString("0.0")</span>
                                                    <span class="remaining-unit">jour(s)</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="compact-remaining-badge bg-secondary">
                                                    <span class="remaining-value">--</span>
                                                    <span class="remaining-unit">jour(s)</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Section Dates -->
                            <div class="form-section">
                                <div class="section-title">
                                    <i class="bi bi-calendar-range text-success me-2"></i>
                                    Période de congé
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="enhanced-form-group">
                                            <label class="form-label enhanced-label">
                                                <i class="bi bi-calendar-plus me-1"></i>
                                                Date de début
                                            </label>
                                            <InputDate class="form-control enhanced-input" @bind-Value="LeaveRequest.StartDate" />
                                            <ValidationMessage For="@(() => LeaveRequest.StartDate)" class="validation-message-enhanced" />
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="enhanced-form-group">
                                            <label class="form-label enhanced-label">
                                                <i class="bi bi-calendar-x me-1"></i>
                                                Date de fin
                                            </label>
                                            <InputDate class="form-control enhanced-input" @bind-Value="LeaveRequest.EndDate" />
                                            <ValidationMessage For="@(() => LeaveRequest.EndDate)" class="validation-message-enhanced" />
                                        </div>
                                    </div>
                                </div>

                                <!-- Duration Display -->
                                @if (LeaveRequest.StartDate != default && LeaveRequest.EndDate != default && LeaveRequest.StartDate <= LeaveRequest.EndDate)
                                {
                                    var duration = (LeaveRequest.EndDate - LeaveRequest.StartDate).TotalDays + 1;
                                    <div class="duration-display">
                                        <i class="bi bi-hourglass-split me-2"></i>
                                        <span class="duration-text">Durée: <strong>@duration.ToString("0") jour(s)</strong></span>
                                    </div>
                                }
                            </div>

                            <!-- Section Détails -->
                            <div class="form-section">
                                <div class="section-title">
                                    <i class="bi bi-file-text text-warning me-2"></i>
                                    Détails de la demande
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-12">
                                        <div class="enhanced-form-group">
                                            <label class="form-label enhanced-label">
                                                <i class="bi bi-chat-text me-1"></i>
                                                Motif
                                            </label>
                                            <InputTextArea class="form-control enhanced-textarea" @bind-Value="LeaveRequest.Reason" rows="4" placeholder="Décrivez le motif de votre demande de congé..." />
                                            <ValidationMessage For="@(() => LeaveRequest.Reason)" class="validation-message-enhanced" />
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="enhanced-form-group">
                                            <div class="form-check enhanced-form-check">
                                                <InputCheckbox class="form-check-input enhanced-checkbox" @bind-Value="LeaveRequest.IsPaid" />
                                                <label class="form-check-label enhanced-check-label">
                                                    <i class="bi bi-cash-coin me-2"></i>
                                                    <div class="check-content">
                                                        <span class="check-title">Congé payé</span>
                                                        <small class="check-description">Ce congé sera décompté du solde de congés payés</small>
                                                    </div>
                                                </label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="enhanced-form-group">
                                            <label class="form-label enhanced-label">
                                                <i class="bi bi-flag me-1"></i>
                                                Statut
                                            </label>
                                            <InputSelect class="form-select enhanced-select" @bind-Value="LeaveRequest.Status">
                                                @foreach (var status in Enum.GetValues<LeaveStatus>())
                                                {
                                                    <option value="@status">@GetStatusDisplayName(status)</option>
                                                }
                                            </InputSelect>
                                            <ValidationMessage For="@(() => LeaveRequest.Status)" class="validation-message-enhanced" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Enhanced Error Message -->
                        @if (!string.IsNullOrWhiteSpace(ValidationMessage))
                        {
                            <div class="alert alert-danger enhanced-alert">
                                <div class="alert-icon">
                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                </div>
                                <div class="alert-content">
                                    <strong>Erreur de validation</strong>
                                    <p class="mb-0">@ValidationMessage</p>
                                </div>
                            </div>
                        }

                        <DataAnnotationsValidator />
                    </div>

                    <!-- Enhanced Modal Footer -->
                    <div class="modal-footer enhanced-modal-footer">
                        <div class="footer-actions">
                            <button type="submit" class="btn btn-success enhanced-btn primary-action" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <div class="loading-spinner-small me-2"></div>
                                    <span>Enregistrement...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle me-2"></i>
                                    <span>Enregistrer</span>
                                }
                            </button>
                            <button type="button" class="btn btn-outline-secondary enhanced-btn" @onclick="Close">
                                <i class="bi bi-x-circle me-2"></i>
                                Annuler
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
}

<!-- Enhanced Styles -->
<style>
    /* Your existing CSS styles here */
</style>

@code {
    [Parameter] public LeaveRequest LeaveRequest { get; set; } = new(){};
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<LeaveRequest> OnSave { get; set; }

    private List<Employee> Employees = new();
    private float? RemainingDays;
    private string? ValidationMessage;
    private EditContext? editContext;
    private bool isLoadingRemainingDays;
    private bool isSubmitting;

    // Store the previous EmployeeId to detect changes and re-fetch remaining days
    private int _previousEmployeeId;

    private int CurrentEmployeeId
    {
        get => LeaveRequest.EmployeeId;
        set
        {
            if (LeaveRequest.EmployeeId != value)
            {
                LeaveRequest.EmployeeId = value;
                // Only invoke if the employee ID actually changed
                InvokeAsync(async () => await OnEmployeeChanged(value));
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Employees = await EmployeeService.GetAllAsync() ?? new();
           
        }
        catch (Exception ex)
        {
            ValidationMessage = "Erreur lors du chargement des employés";
            Console.Error.WriteLine(ex);
        }
    }

    protected override void OnParametersSet()
    {
        // Re-initialize EditContext whenever the LeaveRequest parameter changes.
        // This is crucial for the form to reflect the new data when editing.
        if (editContext == null || editContext.Model != LeaveRequest)
        {
            editContext = new EditContext(LeaveRequest);
            RemainingDays = null;
        }

        // If the employee ID has changed (e.g., when opening for a new employee or editing a request for a different employee)
        // or if it's the initial load and an employee is already selected, fetch remaining days.
        if (LeaveRequest.EmployeeId > 0 && (LeaveRequest.EmployeeId != _previousEmployeeId || RemainingDays == null))
        {
            InvokeAsync(async () => await OnEmployeeChanged(LeaveRequest.EmployeeId));
        }
        _previousEmployeeId = LeaveRequest.EmployeeId; // Update previous ID for next check
    }

    private async Task OnEmployeeChanged(int employeeId)
    {
        if (employeeId > 0)
        {
            try
            {
                isLoadingRemainingDays = true;
                StateHasChanged(); // Show loading state immediately

                RemainingDays = await LeaveRequestService.GetRemainingDaysAsync(employeeId);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine(ex);
                ValidationMessage = "Erreur lors du chargement des jours restants";
                RemainingDays = null;
            }
            finally
            {
                isLoadingRemainingDays = false;
                StateHasChanged(); // Hide loading state and update display
            }
        }
        else
        {
            RemainingDays = null; // No employee selected
            StateHasChanged(); // Update display
        }
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        StateHasChanged();

        try
        {
            var validationResult = ValidateLeaveRequest();
            if (!validationResult.isValid)
            {
                ValidationMessage = validationResult.message;
                return;
            }
            if (LeaveRequest.Id == 0)
            {
                LeaveRequest.DateTime = DateTime.Now;
            }
            await OnSave.InvokeAsync(LeaveRequest);
            // Close is handled by the parent after OnSave completes and reloads data
        }
        catch (Exception ex)
        {
            ValidationMessage = "Erreur lors de l'enregistrement de la demande";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private (bool isValid, string message) ValidateLeaveRequest()
    {
        if (LeaveRequest.EmployeeId <= 0)
        {
            return (false, "Veuillez sélectionner un employé");
        }

        if (LeaveRequest.StartDate == default || LeaveRequest.EndDate == default)
        {
            return (false, "Veuillez spécifier les dates de début et de fin");
        }

        if (LeaveRequest.StartDate > LeaveRequest.EndDate)
        {
            return (false, "La date de fin ne peut pas être avant la date de début");
        }

        // Only enforce future start date for new requests, not for editing past ones
       

        if (string.IsNullOrWhiteSpace(LeaveRequest.Reason))
        {
            return (false, "Veuillez spécifier un motif");
        }

        // Calculate requested days only if dates are valid
        double requestedDays = 0;
        if (LeaveRequest.StartDate != default && LeaveRequest.EndDate != default && LeaveRequest.StartDate <= LeaveRequest.EndDate)
        {
            requestedDays = (LeaveRequest.EndDate - LeaveRequest.StartDate).TotalDays + 1;
        }


        // if (LeaveRequest.IsPaid && RemainingDays.HasValue)
        // {
        //     if (requestedDays > RemainingDays.Value)
        //     {
        //         return (false, $"Congé payé demandé ({requestedDays:0.0} jours) dépasse le solde restant ({RemainingDays.Value:0.0} jours)");
        //     }
        // }

        return (true, null);
    }

    private async Task Close()
    {
        ValidationMessage = null;
        await IsOpenChanged.InvokeAsync(false);
    }

    private string GetRemainingDaysBadgeClass()
    {
        if (!RemainingDays.HasValue) return "bg-secondary";

        // Calculate requested days based on current form dates
        double requestedDays = 0;
        if (LeaveRequest.StartDate != default && LeaveRequest.EndDate != default && LeaveRequest.StartDate <= LeaveRequest.EndDate)
        {
            requestedDays = (LeaveRequest.EndDate - LeaveRequest.StartDate).TotalDays + 1;
        }

        if (requestedDays > RemainingDays.Value)
            return "bg-danger";
        else if (RemainingDays.Value <= 5) // Example: warning if remaining days are low
            return "bg-warning";
        else
            return "bg-success";
    }

    private string GetStatusDisplayName(LeaveStatus status)
    {
        return status switch
        {
            LeaveStatus.Pending => "🕐 En attente",
            LeaveStatus.Approved => "✅ Approuvé",
            LeaveStatus.Rejected => "❌ Rejeté",
            _ => status.ToString()
        };
    }
}
