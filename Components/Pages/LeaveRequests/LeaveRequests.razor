@page "/leaves"
@using RH.Models
@using RH.Services
@inject ILeaveRequestService LeaveRequestService
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
<h2 class="mb-4">Demandes de congé</h2>
<button class="btn btn-primary mb-3" @onclick="CreateNew">Nouvelle demande</button>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Employé</th>
            <th>Dates</th>
            <th>Statut</th>
            <th>Motif</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Requests.Any())
        {
            @foreach (var request in Requests)
            {
                <tr>
                    <td>@request.Employee?.FullName</td>
                    <td>@request.StartDate.ToString("dd MMM yyyy") - @request.EndDate.ToString("dd MMM yyyy")</td>

                    <td>@request.Status</td>
                    <td>@request.Reason</td>
                    <td>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(request.Id)">Modifier</button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="5">Aucune demande de congé trouvée.</td></tr>
        }
    </tbody>
</table>


<LeaveRequestForm LeaveRequest="Selected" IsOpen="ShowForm" IsOpenChanged="HandleClose" OnSave="Save" />

@code {
    private List<LeaveRequest> Requests = new();
    private LeaveRequest Selected = new();
    private bool ShowForm = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Requests = await LeaveRequestService.GetAllAsync();
    }

    private void CreateNew()
    {
        Selected = new LeaveRequest();
        ShowForm = true;
    }

    private async Task Edit(int id)
    {
        Selected = await LeaveRequestService.GetByIdAsync(id);
        ShowForm = true;
    }

    private async Task Save(LeaveRequest req)
    {
        if (req.Id == 0)
            await LeaveRequestService.CreateAsync(req);
        else
            await LeaveRequestService.UpdateAsync(req);

        await LoadAsync();
        ShowForm = false;
    }

    private void HandleClose(bool isOpen)
    {
        ShowForm = isOpen;
    }
}
