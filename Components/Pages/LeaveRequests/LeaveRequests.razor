@page "/leaves"
@using RH.Models
@using RH.Services
@inject ILeaveRequestService LeaveRequestService
@inject IEmployeeService EmployeeService
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject RH.Services.AttestationGeneratorService AttestationService
@inject IJSRuntime JS

<link href="css/Leave.css" rel="stylesheet" />
<h2 class="mb-4">Demandes de congé</h2>
<button class="btn btn-primary mb-3" @onclick="CreateNew">Nouvelle demande</button>

@if (isLoading)
{
    <p><em>Chargement des demandes de congé...</em></p>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Employé</th>
                <th>Dates</th>
                <th>Statut</th>
                <th>Motif</th>
                <th>Jours Restants</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Requests.Any())
            {
                @foreach (var request in Requests)
                {
                    <tr>
                        <td>@request.Employee?.FullName</td>
                        <td>@request.StartDate.ToString("dd MMM yyyy") - @request.EndDate.ToString("dd MMM yyyy")</td>
                        <td>@GetStatusDisplayName(request.Status)</td>
                        <td>@request.Reason</td>
                        <td>
                            @if (employeeRemainingDays.TryGetValue(request.EmployeeId, out float remaining))
                            {
                                <span class="badge @GetRemainingDaysBadgeClass(remaining)">@remaining.ToString("0.0") jour(s)</span>
                            }
                            else
                            {
                                <span>Chargement...</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowModal(request.Id)">Imprimer</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(request.Id)">Modifier</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(request.Id)">Supprimer</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6">Aucune demande de congé trouvée.</td></tr>
            }
        </tbody>
    </table>
}

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Aperçu de l'attestation</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (leaveRequestData != null)
                    {
                        <div class="printable-content">
                            <LeaveRequestPrint LeaveData="leaveRequestData" />
                        </div>
                    }
                    else
                    {
                        <p>Chargement de l'attestation...</p>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Fermer</button>
                    <button class="btn btn-success" @onclick="Print">Imprimer</button>
                </div>
            </div>
        </div>
    </div>
}

<LeaveRequestForm LeaveRequest="Selected" IsOpen="ShowForm" IsOpenChanged="HandleClose" OnSave="Save" />

@code {
    private bool showModal = false;
    private LeaveRequestData? leaveRequestData; // Nullable to handle loading state

    private List<LeaveRequest> Requests = new();
    private LeaveRequest Selected = new();
    private bool ShowForm = false;
    private bool isLoading = true;
    private Dictionary<int, float> employeeRemainingDays = new Dictionary<int, float>();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        Requests = await LeaveRequestService.GetAllAsync();

        var uniqueEmployeeIds = Requests.Select(r => r.EmployeeId).Distinct().ToList();
        employeeRemainingDays.Clear();

        foreach (var empId in uniqueEmployeeIds)
        {
            try
            {
                var remaining = await LeaveRequestService.GetRemainingDaysAsync(empId);
                employeeRemainingDays[empId] = remaining;
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Error loading remaining days for employee {empId}: {ex.Message}");
                employeeRemainingDays[empId] = 0.0f;
            }
        }
        isLoading = false;
    }

    private void CreateNew()
    {
        Selected = new LeaveRequest()
        {
            StartDate = DateTime.Today,
            EndDate = DateTime.Today
        };
        ShowForm = true;
        StateHasChanged();
    }

    private async Task Edit(int id)
    {
        Selected = await LeaveRequestService.GetByIdAsync(id);
        ShowForm = true;
        StateHasChanged(); // Ensure UI updates after fetching data
    }

    private async Task Delete(int id)
    {
        await LeaveRequestService.DeleteAsync(id);
        await LoadAsync();
    }

    private async Task Save(LeaveRequest req)
    {
        if (req.Id == 0)
        {
            await LeaveRequestService.CreateAsync(req);
        }
        else
        {
            await LeaveRequestService.UpdateAsync(req);
        }

        await LoadAsync();
        ShowForm = false;
    }

    private void HandleClose(bool isOpen)
    {
        ShowForm = isOpen;
        if (!isOpen)
        {
            Selected = new LeaveRequest();
        }
    }

    private async Task ShowModal(int requestId)
    {
        leaveRequestData = null; // Clear previous data and show loading state
        showModal = true;
        StateHasChanged(); // Update UI to show loading

        leaveRequestData = await AttestationService.GenerateLeaveRequestAttestationAsync(requestId);
        StateHasChanged(); // Update UI with loaded data
    }

    void CloseModal() => showModal = false;
    private IJSObjectReference? jsModule;
    async Task Print()
    {
        await jsModule.InvokeVoidAsync("printLeaveContent");
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/attestation-utils.js");


            }
            catch (Exception ex)
            {
              
                StateHasChanged();
            }
        }
    }
    private string GetStatusDisplayName(LeaveStatus status)
    {
        return status switch
        {
            LeaveStatus.Pending => "🕐 En attente",
            LeaveStatus.Approved => "✅ Approuvé",
            LeaveStatus.Rejected => "❌ Rejeté",
            _ => status.ToString()
        };
    }

    private string GetRemainingDaysBadgeClass(float remainingDays)
    {
        if (remainingDays <= 0)
            return "bg-danger";
        else if (remainingDays < 5)
            return "bg-warning";
        else
            return "bg-success";
    }
}


