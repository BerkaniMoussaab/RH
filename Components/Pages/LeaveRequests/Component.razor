@page "/leave-requests"
@using RH.Models
@using RH.Services
@inject ILeaveRequestService LeaveService

<h1 class="text-2xl font-bold mb-4">Leave Requests Dashboard</h1>

<div class="mb-4">
    <label class="mr-2">Filter by status:</label>
    <select @bind="selectedStatus" class="border p-2 rounded">
        <option value="">All</option>
        @foreach (var status in Enum.GetValues<LeaveStatus>())
        {
            <option value="@status">@status</option>
        }
    </select>
</div>

<table class="w-full table-auto border-collapse">
    <thead>
        <tr class="bg-gray-100 text-left">
            <th class="p-2 border">Employee</th>
            <th class="p-2 border">Leave Type</th>
            <th class="p-2 border">Start</th>
            <th class="p-2 border">End</th>
            <th class="p-2 border">Status</th>
            <th class="p-2 border">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (FilteredRequests.Any())
        {
            @foreach (var request in FilteredRequests)
            {
                <tr>
                    <td class="p-2 border">@request.Employee?.FullName</td>
                    <td class="p-2 border">@request.Reason</td>
                    <td class="p-2 border">@request.StartDate.ToShortDateString()</td>
                    <td class="p-2 border">@request.EndDate.ToShortDateString()</td>
                    <td class="p-2 border">@request.Status</td>
                    <td class="p-2 border">
                        @if (request.Status == LeaveStatus.Pending)
                        {
                            <button class="bg-green-500 text-white px-2 py-1 rounded mr-2"
                                    @onclick="() => ApproveRequest(request.Id)">
                                Approve
                            </button>
                            <button class="bg-red-500 text-white px-2 py-1 rounded"
                                    @onclick="() => RejectRequest(request.Id)">
                                Reject
                            </button>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="p-2 text-center">No leave requests found.</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<LeaveRequest> allRequests = new();
    private LeaveStatus? selectedStatus = null;

    private IEnumerable<LeaveRequest> FilteredRequests =>
        selectedStatus == null
            ? allRequests
            : allRequests.Where(r => r.Status == selectedStatus);

    protected override async Task OnInitializedAsync()
    {
        await LoadRequests();
    }

    private async Task LoadRequests()
    {
        allRequests = await LeaveService.GetAllAsync();
    }

    private async Task ApproveRequest(int id)
    {
        await LeaveService.UpdateStatusAsync(id, LeaveStatus.Approved);
        await LoadRequests();
    }

    private async Task RejectRequest(int id)
    {
        await LeaveService.UpdateStatusAsync(id, LeaveStatus.Rejected);
        await LoadRequests();
    }
}
