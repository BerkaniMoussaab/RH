@page "/recovery-dashboard"
@using RH.Services
@inject RecoveryDayService RecoveryService
@inject WorkedDaysOffService WorkedService
@inject EmployeeService EmployeeService
@inject NavigationManager NavManager

<style>
    .dashboard-header {
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
        color: white;
        padding: 2rem;
        border-radius: 15px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 15px rgba(0, 123, 255, 0.2);
    }

    .dashboard-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        padding: 1.5rem;
    }

    .summary-badge {
        font-weight: 600;
        padding: 0.4rem 0.75rem;
        border-radius: 12px;
        font-size: 0.875rem;
        display: inline-block;
    }

    .badge-paid {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
    }

    .badge-pending {
        background: linear-gradient(135deg, #ffc107 0%, #e0a800 100%);
        color: #212529;
    }

    .badge-available {
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
        color: white;
    }
</style>

<div class="container">
    <div class="dashboard-header">
        <h1 class="mb-2">
            <i class="fas fa-chart-bar me-3"></i>
            Tableau de bord — Jours de récupération
        </h1>
        <p class="opacity-75 mb-0">Vue d'ensemble des jours travaillés, récupérations et primes par employé</p>
    </div>

    @if (EmployeeSummaries == null)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3">Chargement des données...</p>
        </div>
    }
    else
    {
        <div class="dashboard-card table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Employé</th>
                        <th>Jours travaillés (repos)</th>
                        <th>Jours de récupération</th>
                        <th>Disponibles</th>
                        <th>Primes payées</th>
                        <th>Primes en attente</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var summary in EmployeeSummaries)
                    {
                        <tr>
                            <td><strong>@summary.FullName</strong></td>
                            <td>@summary.TotalWorkedDays</td>
                            <td>@summary.TotalRecoveryDays</td>
                            <td>
                                <span class="summary-badge badge-available">
                                    @summary.UnusedRecoveryDays
                                </span>
                            </td>
                            <td>
                                <span class="summary-badge badge-paid">
                                    @summary.BonusPaid
                                </span>
                            </td>
                            <td>
                                <span class="summary-badge badge-pending">
                                    @summary.BonusPending
                                </span>
                            </td>
                            <td>
                                <button class="btn btn-success px-4"
                                        @onclick="() => OpenEmployeeRecovery(summary.EmployeeId)">
                                    <i class="fas fa-cogs me-1"></i>
                                    Gérer
                                </button>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>


@code {
    private void OpenEmployeeRecovery(int employeeId)
    {
        var url = $"/recuperation?employeeId={employeeId}";
        NavManager.NavigateTo(url, true); // true = force reload
    }


    private List<EmployeeSummaryViewModel>? EmployeeSummaries;

    protected override async Task OnInitializedAsync()
    {
        var employees = await EmployeeService.GetAllAsync();
        var allWorked = await WorkedService.GetAllAsync(); // new method to fetch all
        var allRecovery = await RecoveryService.GetAllAsync();

        EmployeeSummaries = employees.Select(emp =>
        {
            var worked = allWorked.Where(w => w.EmployeeId == emp.Id).ToList();
            var recovery = allRecovery.Where(r => r.EmployeeId == emp.Id).ToList();

            return new EmployeeSummaryViewModel
                {
                    EmployeeId = emp.Id,
                    FullName = emp.FullName,
                    TotalWorkedDays = worked.Count,
                    TotalRecoveryDays = recovery.Count,
                   
                    BonusPaid = worked.Count(w => w.GrantsBonus && w.BonusPaid),
                    BonusPending = worked.Count(w => w.GrantsBonus && !w.BonusPaid)
                };
        }).OrderBy(e => e.FullName).ToList();
    }

    private class EmployeeSummaryViewModel
    {
        public int EmployeeId { get; set; }
        public string FullName { get; set; } = "";
        public int TotalWorkedDays { get; set; }
        public int TotalRecoveryDays { get; set; }
        public int UnusedRecoveryDays { get; set; }
        public int BonusPaid { get; set; }
        public int BonusPending { get; set; }
    }
}
