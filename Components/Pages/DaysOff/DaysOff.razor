@page "/recovery-days"
@inject RecoveryDayService RecoveryDayService
@inject IEmployeeService EmployeeService
@inject IJSRuntime JS
@using RH.Models
@using RH.Services

<PageTitle>Jours de Récupération</PageTitle>

<div class="container mt-4">
    <h2 class="mb-4">
        <i class="bi bi-calendar-check"></i> Gestion des Jours de Récupération
    </h2>

    <div class="mb-3 d-flex justify-content-between align-items-center">
        <button class="btn btn-primary" @onclick="ShowAddModal">
            <i class="bi bi-plus-lg"></i> Ajouter
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (recoveryDays.Count == 0)
    {
        <div class="alert alert-info">Aucun jour de récupération enregistré.</div>
    }
    else
    {
        <table class="table table-bordered table-hover">
            <thead class="table-light">
                <tr>
                    <th>Employé</th>
                    <th>Date</th>
                    <th>Raison</th>
                    <th>Quantité</th>
                    <th>Utilisé</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var day in recoveryDays)
                {
                    <tr>
                        <td>@day.Employee?.FullName</td>
                        <td>@day.Date.ToShortDateString()</td>
                        <td>@day.Reason</td>
                        <td>@day.Quantity</td>
                        <td>
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar @GetProgressBarClass(day)" role="progressbar"
                                     style="width: @GetUsagePercentage(day)%;">
                                    @day.UsedQuantity / @day.Quantity
                                </div>
                            </div>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Edit(day)">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(day)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- Modal -->
@if (showModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@((editingDay.Id == 0) ? "Ajouter" : "Modifier") Jour de Récupération</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Employé</label>
                        <select class="form-select" @bind="editingDay.EmployeeId">
                            <option disabled value="">-- Sélectionner --</option>
                            @foreach (var emp in employees)
                            {
                                <option value="@emp.Id">@emp.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Date</label>
                        <input class="form-control" type="date" @bind="editingDay.Date" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Raison</label>
                        <input class="form-control" @bind="editingDay.Reason" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Quantité</label>
                        <input type="number" step="0.25" class="form-control" @bind="editingDay.Quantity" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Quantité utilisée</label>
                        <input type="number" step="0.25" class="form-control" @bind="editingDay.UsedQuantity" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Annuler</button>
                    <button class="btn btn-primary" @onclick="Save">Enregistrer</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<RecoveryDay> recoveryDays = new();
    private List<Employee> employees = new();
    private RecoveryDay editingDay = new();
    private bool showModal = false;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        employees = await EmployeeService.GetAllAsync();
        recoveryDays = await RecoveryDayService.GetAllAsync();
        isLoading = false;
    }

    private void ShowAddModal()
    {
        editingDay = new RecoveryDay
            {
                Date = DateTime.Today,
                Quantity = 1,
                UsedQuantity = 0
            };
        showModal = true;
    }

    private void Edit(RecoveryDay day)
    {
        editingDay = new RecoveryDay
            {
                Id = day.Id,
                Date = day.Date,
                Reason = day.Reason,
                Quantity = day.Quantity,
                UsedQuantity = day.UsedQuantity,
                EmployeeId = day.EmployeeId
            };
        showModal = true;
    }

    private async Task Save()
    {
        if (editingDay.Id == 0)
            await RecoveryDayService.AddAsync(editingDay);
        else
            await RecoveryDayService.UpdateAsync(editingDay);

        showModal = false;
        recoveryDays = await RecoveryDayService.GetAllAsync();
    }

    private async Task ConfirmDelete(RecoveryDay day)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Supprimer ce jour de récupération du {day.Date:dd/MM/yyyy} ?");
        if (confirm)
        {
            await RecoveryDayService.DeleteAsync(day.Id);
            recoveryDays = await RecoveryDayService.GetAllAsync();
        }
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private string GetProgressBarClass(RecoveryDay day)
    {
        float usage = GetUsagePercentage(day);
        return usage >= 100 ? "bg-success" : (usage > 0 ? "bg-warning" : "bg-secondary");
    }

    private float GetUsagePercentage(RecoveryDay day)
    {
        return day.Quantity == 0 ? 0 : Math.Clamp((day.UsedQuantity / day.Quantity) * 100f, 0, 100);
    }
}
