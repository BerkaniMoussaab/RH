@page "/attestation-generator"
@inject RH.Services.AttestationGeneratorService AttestationService
@inject IJSRuntime JSRuntime
@using RH.Models
@using RH.Services

<h3>Générateur d'Attestations</h3>

<div class="form-group">
    <label for="employeeId">Employé:</label>
    <select class="form-control" id="employeeId" @bind="employeeId">
        <option value="">-- Sélectionnez un employé --</option>
        @foreach (var emp in employees)
        {
            <option value="@emp.Id">@emp.FullName (@emp.JobTitle?.Title)</option>
        }
    </select>
</div>


<div class="form-group">
    <label for="attestationType">Type d'Attestation:</label>
    <select class="form-control" id="attestationType" @bind="attestationType">
        <option value="@AttestationType.Work">Attestation de Travail</option>
        <option value="@AttestationType.Internship">Attestation de Stage</option>
    </select>
</div>

@if (attestationType == AttestationType.Internship)
{
    <div class="form-group">
        <label for="internshipStartDate">Date de début du stage:</label>
        <input type="date" class="form-control" id="internshipStartDate" @bind="internshipStartDate" />
    </div>
    <div class="form-group">
        <label for="internshipEndDate">Date de fin du stage:</label>
        <input type="date" class="form-control" id="internshipEndDate" @bind="internshipEndDate" />
    </div>
    <div class="form-group">
        <label for="internshipDepartment">Département:</label>
        <input type="text" class="form-control" id="internshipDepartment" @bind="internshipDepartment" />
    </div>
    <div class="form-group">
        <label for="supervisorName">Nom du superviseur:</label>
        <input type="text" class="form-control" id="supervisorName" @bind="supervisorName" />
    </div>
    <div class="form-group">
        <label for="internshipObjectives">Objectifs du stage:</label>
        <textarea class="form-control" id="internshipObjectives" @bind="internshipObjectives"></textarea>
    </div>
}

<button class="btn btn-primary" @onclick="GenerateAttestation">Générer l'Attestation</button>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info mt-3">@message</div>
}

@code {
    private int employeeId;
    private AttestationType attestationType = AttestationType.Work;
    private DateTime internshipStartDate = DateTime.Today;
    private DateTime internshipEndDate = DateTime.Today;
    private string internshipDepartment = string.Empty;
    private string supervisorName = string.Empty;
    private string internshipObjectives = string.Empty;
    private string message = string.Empty;

    [Inject] private EmployeeService EmployeeService { get; set; }

    private List<Employee> employees = new();
    

    protected override async Task OnInitializedAsync()
    {
        employees = await EmployeeService.GetAllAsync(); // Or your method to fetch employees
    }
    private async Task GenerateAttestation()
    {
        message = string.Empty;
        try
        {
            byte[] pdfBytes;
            string fileName;

            if (attestationType == AttestationType.Work)
            {
                pdfBytes = await AttestationService.GenerateWorkAttestationPdfAsync(employeeId);
                fileName = $"Attestation_Travail_{employeeId}_{DateTime.Now:yyyyMMddHHmmss}.pdf";
            }
            else
            {
                if (string.IsNullOrEmpty(internshipDepartment) || string.IsNullOrEmpty(supervisorName) || string.IsNullOrEmpty(internshipObjectives))
                {
                    message = "Veuillez remplir tous les champs pour l'attestation de stage.";
                    return;
                }
                pdfBytes = await AttestationService.GenerateInternshipAttestationPdfAsync(employeeId, internshipStartDate, internshipEndDate, internshipDepartment, supervisorName, internshipObjectives);
                fileName = $"Attestation_Stage_{employeeId}_{DateTime.Now:yyyyMMddHHmmss}.pdf";
            }

            await JSRuntime.InvokeVoidAsync("saveAsFile", fileName, Convert.ToBase64String(pdfBytes));
            message = "Attestation générée avec succès et téléchargée.";
        }
        catch (ArgumentException ex)
        {
            message = $"Erreur: {ex.Message}";
        }
        catch (InvalidOperationException ex)
        {
            message = $"Erreur de configuration: {ex.Message}";
        }
        catch (Exception ex)
        {
            message = $"Une erreur inattendue est survenue: {ex.Message}";
        }
    }
    public enum AttestationType
    {
        Work, // Attestation de travail
        Internship // Attestation de stage
    }
}


<script>
    window.saveAsFile = function (fileName, base64) {
        var link = document.createElement('a');
        link.download = fileName;
        link.href = "data:application/octet-stream;base64," + base64;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    };
</script>
