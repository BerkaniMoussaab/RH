@page "/attestation-generator"
@inject RH.Services.AttestationGeneratorService AttestationService
@inject IJSRuntime JSRuntime
@inject EmployeeService EmployeeService
@using RH.Models
@using RH.Services
@implements IAsyncDisposable

<link href="css/attestation.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="card shadow-sm p-4">
        <h3 class="mb-4 text-primary"><i class="bi bi-file-earmark-text"></i> Générateur d'Attestations</h3>

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Employé</label>
                <select class="form-select" @bind="employeeId">
                    <option value="">-- Sélectionnez un employé --</option>
                    @foreach (var emp in employees)
                    {
                        <option value="@emp.Id">@emp.FullName (@emp.JobTitle?.Title)</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Type d'Attestation</label>
                <select class="form-select" @bind="attestationType">
                    <option value="@AttestationType.Work">Attestation de Travail</option>
                    <option value="@AttestationType.Internship">Attestation de Stage</option>
                </select>
            </div>
        </div>

        @if (attestationType == AttestationType.Internship)
        {
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Date de début</label>
                    <input type="date" class="form-control" @bind="internshipStartDate" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Date de fin</label>
                    <input type="date" class="form-control" @bind="internshipEndDate" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Département</label>
                    <input type="text" class="form-control" @bind="internshipDepartment" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Nom du superviseur</label>
                    <input type="text" class="form-control" @bind="supervisorName" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Objectifs du stage</label>
                <textarea class="form-control" rows="3" @bind="internshipObjectives"></textarea>
            </div>
        }

        <button class="btn btn-primary w-100 mt-2" @onclick="GenerateAttestation">
            <i class="bi bi-gear-fill me-1"></i> Générer l'Attestation
        </button>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert alert-info mt-3">@message</div>
        }

        @if (attestationData != null)
        {
            <div class="card mt-4 shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-secondary"><i class="bi bi-eye"></i> Aperçu de l'Attestation</h5>
                    <div class="btn-group">
                        <button class="btn btn-outline-info btn-sm" @onclick="PreviewAttestation">
                            <i class="bi bi-eye-fill"></i> Aperçu
                        </button>
                        <button class="btn btn-outline-primary btn-sm" @onclick="PrintAttestation">
                            <i class="bi bi-printer"></i> Imprimer
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="SaveAsPdf">
                            <i class="bi bi-download"></i> Sauvegarder PDF
                        </button>
                    </div>
                </div>
                <div class="card-body p-4 printable-content">
                    <AttestationDisplay AttestationData="attestationData" />
                </div>
            </div>
        }
    </div>
</div>

@code {
    private int employeeId;
    private AttestationType attestationType = AttestationType.Work;
    private DateTime internshipStartDate = DateTime.Today;
    private DateTime internshipEndDate = DateTime.Today;
    private string internshipDepartment = string.Empty;
    private string supervisorName = string.Empty;
    private string internshipObjectives = string.Empty;
    private string message = string.Empty;

    private List<Employee> employees = new();
    private AttestationData? attestationData;
    private string? generatedFileName;

    private IJSObjectReference? jsModule;

    protected override async Task OnInitializedAsync()
    {
        employees = await EmployeeService.GetAllAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/js/attestation-utils.js");

            }
            catch (Exception ex)
            {
                message = $"Erreur lors du chargement du module JavaScript : {ex.Message}";
                StateHasChanged();
            }
        }
    }

    private async Task GenerateAttestation()
    {
        message = string.Empty;
        attestationData = null;

        try
        {
            if (attestationType == AttestationType.Work)
            {
                attestationData = await AttestationService.GenerateWorkAttestationAsync(employeeId);
                generatedFileName = await AttestationService.GetAttestationFileNameAsync(employeeId, AttestationType.Work);
            }
            else
            {
                if (string.IsNullOrWhiteSpace(internshipDepartment) || string.IsNullOrWhiteSpace(supervisorName) || string.IsNullOrWhiteSpace(internshipObjectives))
                {
                    message = "Veuillez remplir tous les champs pour l'attestation de stage.";
                    return;
                }

                attestationData = await AttestationService.GenerateInternshipAttestationAsync(
                    employeeId, internshipStartDate, internshipEndDate, internshipDepartment, supervisorName, internshipObjectives);
                generatedFileName = await AttestationService.GetAttestationFileNameAsync(employeeId, AttestationType.Internship);
            }

            message = "Attestation générée avec succès.";
        }
        catch (Exception ex)
        {
            message = $"Erreur : {ex.Message}";
        }
    }

    private async Task PreviewAttestation()
    {
        if (attestationData != null && jsModule != null)
        {
            await jsModule.InvokeVoidAsync("previewAttestation");
        }
    }

    private async Task PrintAttestation()
    {
        if (attestationData != null && jsModule != null)
        {
            await jsModule.InvokeVoidAsync("printAttestationContent");
        }
    }

    private async Task SaveAsPdf()
    {
        if (attestationData != null && !string.IsNullOrEmpty(generatedFileName) && jsModule != null)
        {
            await jsModule.InvokeVoidAsync("saveAttestationAsPdf", generatedFileName);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (jsModule != null)
        {
            await jsModule.DisposeAsync();
        }
    }
}
