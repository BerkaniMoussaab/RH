@using RH.Models
@using RH.Services
@inject IJobTitleService JobTitleService
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<EditForm Model="Employee" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="modal @(IsOpen ? "show d-block" : "fade")" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content shadow rounded-3">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        @((Employee.Id == 0) ? "Créer un employé" : "Modifier l'employé")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <!-- Nom complet -->
                        <div class="col-md-6">
                            <label class="form-label">Nom complet</label>
                            <InputText class="form-control" @bind-Value="Employee.FullName" />
                            <ValidationMessage For="@(() => Employee.FullName)" />
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <InputText class="form-control" @bind-Value="Employee.Email" />
                            <ValidationMessage For="@(() => Employee.Email)" />
                        </div>

                        <!-- Téléphone -->
                        <div class="col-md-6">
                            <label class="form-label">Numéro de téléphone</label>
                            <InputText class="form-control" @bind-Value="Employee.PhoneNumber" />
                        </div>

                        <!-- Date d'embauche -->
                        <div class="col-md-6">
                            <label class="form-label">Date d'embauche</label>
                            <InputDate class="form-control" @bind-Value="Employee.HireDate" />
                        </div>

                        <!-- Date d'inscription -->
                        <div class="col-md-6">
                            <label class="form-label">Date d'inscription dans le système</label>
                            <InputDate class="form-control" @bind-Value="Employee.InscriptionDate" />
                            <small class="form-text text-muted">
                                Tous les congés pris après cette date seront déduits du solde initial.
                            </small>
                        </div>

                        <!-- Solde de congé à l'inscription -->
                        <div class="col-md-6">
                            <label class="form-label">Solde de congé à l'inscription</label>
                            <InputNumber class="form-control" @bind-Value="Employee.InitialRemainingDays" />
                            <ValidationMessage For="@(() => Employee.InitialRemainingDays)" />
                            <small class="form-text text-muted">
                                Le solde de congé au moment de l'ajout dans le système. Utilisé comme base pour les déductions.
                            </small>
                        </div>

                        <!-- Poste -->
                        <div class="col-md-6">
                            <label class="form-label">Poste</label>
                            <div class="d-flex">
                                <InputSelect class="form-select me-2" @bind-Value="Employee.JobTitleId">
                                    <option value="">-- Sélectionnez un poste --</option>
                                    @foreach (var jt in JobTitles)
                                    {
                                        <option value="@jt.Id">@jt.Title</option>
                                    }
                                </InputSelect>
                                <button type="button" class="btn btn-outline-secondary" @onclick="() => ShowAddJobTitle = true">+</button>
                            </div>
                        </div>

                        <!-- Statut -->
                        <div class="col-md-6">
                            <label class="form-label">Statut</label>
                            <InputSelect class="form-select" @bind-Value="Employee.Status">
                                @foreach (var status in Enum.GetValues<EmployeeStatus>())
                                {
                                    <option value="@status">@status</option>
                                }
                            </InputSelect>
                        </div>

                        <!-- Contrat -->
                        <div class="col-md-12">
                            <label class="form-label">Contrat (n'importe quel fichier)</label>
                            <InputFile OnChange="HandleFileUpload" />
                            @if (!string.IsNullOrEmpty(Employee.ContractFileName))
                            {
                                <div class="mt-2 text-success">
                                    Fichier sélectionné : <strong>@Employee.ContractFileName</strong>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-save me-2"></i>Enregistrer
                    </button>
                    <button type="button" class="btn btn-outline-secondary px-4" @onclick="Close">
                        <i class="bi bi-x-circle me-2"></i>Annuler
                    </button>
                </div>
            </div>
        </div>
    </div>
</EditForm>

<!-- Modal d'ajout de poste -->
@if (ShowAddJobTitle)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <EditForm Model="NewJobTitle" OnValidSubmit="AddJobTitle">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">Ajouter un nouveau poste</h5>
                        <button type="button" class="btn-close" @onclick="() => ShowAddJobTitle = false" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Titre</label>
                            <InputText class="form-control" @bind-Value="NewJobTitle.Title" />
                            <ValidationMessage For="@(() => NewJobTitle.Title)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputText class="form-control" @bind-Value="NewJobTitle.Description" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success">Ajouter</button>
                        <button type="button" class="btn btn-secondary" @onclick="() => ShowAddJobTitle = false">Annuler</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Employee Employee { get; set; } = new();
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<Employee> OnSave { get; set; }

    private List<JobTitle> JobTitles = new();
    private JobTitle NewJobTitle = new();
    private bool ShowAddJobTitle = false;

    protected override async Task OnInitializedAsync()
    {
        JobTitles = (await JobTitleService.GetAllAsync()).ToList();
    }

    private async Task HandleValidSubmit()
    {
        if (Employee.InscriptionDate == null)
            Employee.InscriptionDate = DateTime.Today;

        await OnSave.InvokeAsync(Employee);
        await Close();
    }

    private async Task AddJobTitle()
    {
        var added = await JobTitleService.AddAsync(NewJobTitle);
        JobTitles.Add(added);
        Employee.JobTitleId = added.Id;
        NewJobTitle = new JobTitle();
        ShowAddJobTitle = false;
    }

    private async Task Close()
    {
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;

        using var ms = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 20_000_000).CopyToAsync(ms); // 20 MB max

        Employee.ContractFile = ms.ToArray();
        Employee.ContractFileName = file.Name;
        Employee.ContractContentType = file.ContentType;
    }
}
