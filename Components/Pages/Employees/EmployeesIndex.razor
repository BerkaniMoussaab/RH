@page "/employees"
@using RH.Models
@using RH.Services
@inject IEmployeeService EmployeeService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<h1 class="text-2xl font-bold mb-4">Employés</h1>

<div class="flex gap-4 mb-4">
    <button class="btn btn-primary" @onclick="AddEmployee">Ajouter un employé</button>
    <button class="btn btn-success" @onclick="NavigateToUrl">Générateur d'attestation</button>
</div>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div class="alert alert-success">@SuccessMessage</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Téléphone</th>
            <th>Email</th>
            <th>Statut</th>
            <th>Contrat</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Employees?.Any() == true)
        {
            foreach (var emp in Employees)
            {
                <tr>
                    <td>@emp.FullName</td>
                    <td>@emp.PhoneNumber</td>
                    <td>@emp.Email</td>
                    <td>@emp.Status</td>
                    <td>
                        @if (emp.ContractFile != null)
                        {
                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => DownloadContract(emp.Id)"
                                    @onclick:preventDefault="true"
                                    disabled="@IsDownloading">
                                @if (IsDownloading && CurrentDownloadId == emp.Id)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Télécharger
                            </button>
                        }
                        else
                        {
                            <span class="text-muted">Aucun contrat</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(emp.Id)">Modifier</button>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(emp.Id)">Supprimer</button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="7">Aucun employé disponible</td></tr>
        }
    </tbody>
</table>

<EmployeeForm Employee="SelectedEmployee"
              IsOpen="IsModalOpen"
              IsOpenChanged="HandleModalClose"
              OnSave="HandleEmployeeSave" />

@code {
    private List<Employee> Employees = new();
    private Employee SelectedEmployee = new();
    private bool IsModalOpen;
    private bool IsDownloading;
    private int CurrentDownloadId;
    private string ErrorMessage = string.Empty;
    private string SuccessMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployeesAsync();
    }

    private async Task LoadEmployeesAsync()
    {
        try
        {
            Employees = await EmployeeService.GetAllAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erreur lors du chargement des employés : {ex.Message}";
        }
    }

    private void AddEmployee()
    {
        SelectedEmployee = new Employee();
        IsModalOpen = true;
    }

    private async Task Edit(int id)
    {
        try
        {
            SelectedEmployee = await EmployeeService.GetByIdAsync(id);
            IsModalOpen = true;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erreur lors du chargement de l'employé : {ex.Message}";
        }
    }

    private async Task HandleEmployeeSave(Employee employee)
    {
        try
        {
            if (employee.Id == 0)
                await EmployeeService.AddAsync(employee);
            else
                await EmployeeService.UpdateAsync(employee);

            await LoadEmployeesAsync();
            IsModalOpen = false;
            SuccessMessage = "Employé sauvegardé avec succès.";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erreur lors de la sauvegarde : {ex.Message}";
        }
    }

    private void HandleModalClose(bool isOpen)
    {
        IsModalOpen = isOpen;
    }

    private void NavigateToUrl()
    {
        Navigation.NavigateTo("/attestation-generator");
    }

    private async Task DownloadContract(int employeeId)
    {
        if (IsDownloading)
            return;

        IsDownloading = true;
        CurrentDownloadId = employeeId;
        ClearMessages();

        try
        {
            var result = await EmployeeService.GetContractFileAsync(employeeId);

            if (result.FileStream == null)
            {
                ErrorMessage = "Le fichier de contrat n'est pas disponible ou n'existe pas.";
                return;
            }

            var fileName = EnsureFileNameHasExtension(result.FileName ?? $"contrat_employe_{employeeId}", result.ContentType);
            var contentType = result.ContentType ?? "application/pdf";

            var jsAvailable = await JS.InvokeAsync<bool>("eval", "typeof downloadFileFromStream === 'function'");
            if (jsAvailable)
            {
                using var streamRef = new DotNetStreamReference(result.FileStream);
                await JS.InvokeVoidAsync("downloadFileFromStream", fileName, contentType, streamRef);
            }
            else
            {
                using var memoryStream = new MemoryStream();
                await result.FileStream.CopyToAsync(memoryStream);
                var base64 = Convert.ToBase64String(memoryStream.ToArray());
                await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, contentType, base64);
            }

            SuccessMessage = $"Téléchargement du contrat : {fileName}";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erreur lors du téléchargement : {ex.Message}";
        }
        finally
        {
            IsDownloading = false;
            CurrentDownloadId = 0;
        }
    }

    private string EnsureFileNameHasExtension(string fileName, string contentType)
    {
        if (Path.HasExtension(fileName)) return fileName;

        var ext = contentType switch
        {
            "application/pdf" => ".pdf",
            "application/msword" => ".doc",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => ".docx",
            "image/png" => ".png",
            "image/jpeg" => ".jpg",
            "application/zip" => ".zip",
            _ => ".bin"
        };

        return fileName + ext;
    }

    private async Task ConfirmDelete(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Êtes-vous sûr de vouloir supprimer cet employé ?");
        if (confirmed)
        {
            try
            {
                await EmployeeService.DeleteAsync(id);
                await LoadEmployeesAsync();
                SuccessMessage = "Employé supprimé avec succès.";
            }
            catch (Exception ex)
            {
                ErrorMessage = $"Erreur lors de la suppression : {ex.Message}";
            }
        }
    }

    private void ClearMessages()
    {
        ErrorMessage = string.Empty;
        SuccessMessage = string.Empty;
    }
}
