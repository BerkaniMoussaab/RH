@page "/employees/{EmployeeId}/files"
@using RH.Models
@using RH.Services
@inject IEmployeeService EmployeeService
@inject IFileAttachmentService FileAttachmentService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Forms

<style>
    :root {
        --primary: #2563eb;
        --primary-soft: #e0e7ff;
        --danger: #ef4444;
        --success: #16a34a;
        --bg: #f8fafc;
        --border: #e5e7eb;
        --text: #0f172a;
        --muted: #64748b;
        --radius: 14px;
    }

    body {
        background: var(--bg);
    }

    .page-container {
        max-width: 1200px;
        margin: auto;
        padding: 28px 20px 60px;
    }

    .page-title {
        font-size: 2.1rem;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 28px;
        letter-spacing: -0.5px;
    }

    .card {
        background: #fff;
        border-radius: var(--radius);
        box-shadow: 0 10px 30px rgba(0,0,0,.06);
        margin-bottom: 28px;
        overflow: hidden;
        border: 1px solid var(--border);
    }

    .card-header {
        padding: 18px 24px;
        background: linear-gradient(to right, #ffffff, #f8fafc);
        border-bottom: 1px solid var(--border);
    }

        .card-header h3 {
            margin: 0;
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text);
        }

    .card-body {
        padding: 24px;
    }

    .employee-name {
        font-size: 1.45rem;
        font-weight: 600;
        color: var(--text);
    }

    .alert {
        padding: 14px 18px;
        border-radius: 10px;
        margin-bottom: 18px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .alert-error {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    .alert-success {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        display: block;
        font-weight: 600;
        margin-bottom: 6px;
        color: var(--text);
        font-size: 0.9rem;
    }

    input[type="text"],
    input[type="file"] {
        width: 100%;
        padding: 12px 14px;
        border-radius: 10px;
        border: 1px solid var(--border);
        font-size: 0.95rem;
        transition: border .15s ease, box-shadow .15s ease;
    }

    input:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px var(--primary-soft);
    }

    button {
        border: none;
        border-radius: 10px;
        padding: 10px 18px;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: all .2s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        button:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

    .btn-primary {
        background: var(--primary);
        color: #fff;
    }

        .btn-primary:hover {
            background: #1d4ed8;
            transform: translateY(-1px);
        }

    .btn-danger {
        background: var(--danger);
        color: #fff;
    }

        .btn-danger:hover {
            background: #dc2626;
            transform: translateY(-1px);
        }

    .btn-table {
        padding: 6px 12px;
        font-size: 0.85rem;
        border-radius: 8px;
        margin-right: 6px;
    }

    table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 0.95rem;
    }

    thead {
        background: #f1f5f9;
    }

    th {
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: .05em;
        color: var(--muted);
    }

    th, td {
        padding: 14px 18px;
        text-align: left;
        border-bottom: 1px solid var(--border);
        vertical-align: middle;
    }

    tbody tr {
        transition: background .15s ease;
    }

        tbody tr:hover {
            background: #f8fafc;
        }

    .spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255,255,255,.4);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        display: inline-block;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>


<div class="page-container">
    <h1 class="page-title">Fichiers de l'employé</h1>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-error">@ErrorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="alert alert-success">@SuccessMessage</div>
    }

    @if (CurrentEmployee == null)
    {
        <div class="card">
            <div class="card-body" style="text-align:center;color:var(--muted)">
                Chargement des informations...
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header">
                <div class="employee-name">@CurrentEmployee.FullName</div>
                <div style="color:var(--muted)">ID : @CurrentEmployee.Id</div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Ajouter un fichier</h3>
            </div>
            <div class="card-body">

                <div class="form-group">
                    <label>Description</label>
                    <input type="text" @bind="NewFileDescription" />
                </div>

                <div class="form-group">
                    <label>Fichier</label>
                    <InputFile @ref="FileInput" OnChange="OnFileSelected" />
                </div>

                <button class="btn-primary" @onclick="UploadFile" disabled="@IsUploading">
                    @if (IsUploading)
                    {
                        <span class="spinner"></span>
                        <span style="margin-left:6px">Envoi...</span>
                    }
                    else
                    {
                        <span>Envoyer</span>
                    }
                </button>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Fichiers attachés</h3>
            </div>

            @if (FileAttachments.Any())
            {
                <table>
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Type</th>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var file in FileAttachments)
                        {
                            <tr>
                                <td>@file.FileName</td>
                                <td>@file.ContentType</td>
                                <td>@file.UploadDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@file.Description</td>
                                <td>
                                    <button class="btn-primary btn-table"
                                            @onclick="() => DownloadFile(file.Id)"
                                            disabled="@(IsDownloading && CurrentDownloadId == file.Id)">
                                        Télécharger
                                    </button>
                                    <button class="btn-danger btn-table"
                                            @onclick="() => ConfirmDelete(file.Id)">
                                        Supprimer
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="card-body" style="text-align:center;color:var(--muted)">
                    Aucun fichier attaché.
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string? EmployeeId { get; set; }
    private int ParsedEmployeeId => int.TryParse(EmployeeId, out var id) ? id : 0;

    private Employee? CurrentEmployee;
    private List<FileAttachment> FileAttachments = new();

    private bool IsUploading;
    private bool IsDownloading;
    private int CurrentDownloadId;

    private string ErrorMessage = string.Empty;
    private string SuccessMessage = string.Empty;
    private string NewFileDescription = string.Empty;

    private InputFile? FileInput;
    private IBrowserFile? SelectedFile;

    protected override async Task OnInitializedAsync()
    {
        if (!int.TryParse(EmployeeId, out _))
        {
            ErrorMessage = "ID d'employé invalide.";
            return;
        }

        await LoadEmployeeAsync();
    }

    private async Task LoadEmployeeAsync()
    {
        CurrentEmployee = await EmployeeService.GetByIdAsync(ParsedEmployeeId);
        if (CurrentEmployee != null)
            FileAttachments = (await FileAttachmentService.GetFileAttachmentsByEmployeeIdAsync(ParsedEmployeeId)).ToList();
    }

    private Task OnFileSelected(InputFileChangeEventArgs e)
    {
        SelectedFile = e.File;
        SuccessMessage = $"Fichier sélectionné : {SelectedFile.Name}";
        ErrorMessage = string.Empty;
        return Task.CompletedTask;
    }

    private async Task UploadFile()
    {
        if (string.IsNullOrWhiteSpace(NewFileDescription) || SelectedFile == null)
        {
            ErrorMessage = "Description et fichier requis.";
            return;
        }

        IsUploading = true;

        using var ms = new MemoryStream();
        await SelectedFile.OpenReadStream().CopyToAsync(ms);

        await FileAttachmentService.CreateFileAttachmentAsync(new FileAttachment
        {
            EmployeeId = ParsedEmployeeId,
            FileName = SelectedFile.Name,
            ContentType = SelectedFile.ContentType,
            Content = ms.ToArray(),
            Description = NewFileDescription
        });

        FileAttachments = (await FileAttachmentService.GetFileAttachmentsByEmployeeIdAsync(ParsedEmployeeId)).ToList();

        SuccessMessage = "Fichier envoyé avec succès.";
        NewFileDescription = string.Empty;
        SelectedFile = null;
        IsUploading = false;
    }

    private async Task DownloadFile(int id)
    {
        IsDownloading = true;
        CurrentDownloadId = id;

        var file = await FileAttachmentService.GetFileAttachmentAsync(id);
        await JS.InvokeVoidAsync("downloadFileFromBase64",
            file.FileName,
            file.ContentType,
            Convert.ToBase64String(file.Content));

        IsDownloading = false;
        CurrentDownloadId = 0;
    }

    private async Task ConfirmDelete(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Supprimer ce fichier ?"))
            return;

        await FileAttachmentService.DeleteFileAttachmentAsync(id);
        FileAttachments = (await FileAttachmentService.GetFileAttachmentsByEmployeeIdAsync(ParsedEmployeeId)).ToList();
        SuccessMessage = "Fichier supprimé.";
    }
}
