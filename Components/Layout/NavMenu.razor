@implements IDisposable
@inject NavigationManager NavigationManager

<style>
    .sidebar {
        background-color: #111827;
        color: #f3f4f6;
        width: 250px;
    }

    .nav-link {
        color: #d1d5db;
        border-radius: 0.5rem;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .nav-link:hover {
            background-color: rgba(255, 255, 255, 0.1);
            color: #ffffff;
        }

        .nav-link.active {
            background-color: #374151;
            font-weight: bold;
            color: #ffffff;
        }

    .sidebar hr {
        border-color: #374151;
    }

    .sidebar-logo img {
        filter: brightness(2.5);
    }

    #Logout button:hover {
        background-color: rgba(255, 255, 255, 0.15);
        border-radius: 0.5rem;
        color: #ffffff;
    }
</style>

<div class="d-flex flex-column sidebar vh-100">
    <!-- Logo -->
    <div class="nav-item px-3 py-2 text-center border-bottom border-secondary sidebar-logo">
        <a class="navbar-brand d-flex justify-content-center align-items-center" href="/">
            <img src="favicon.png" alt="Ojra Logo" style="height: 48px;" />
        </a>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="nav-item px-3 mt-3">
                <NavLink class="nav-link d-flex align-items-center px-3 py-2" href="/">
                    <i class="bi bi-house me-2 fs-5"></i>
                    <span>Tableau de bord</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center px-3 py-2" href="/employees">
                    <i class="bi bi-people me-2 fs-5"></i>
                    <span>Employés</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center px-3 py-2" href="/leaves">
                    <i class="bi bi-calendar-check me-2 fs-5"></i>
                    <span>Demandes de congé</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center px-3 py-2" href="/payrolls">
                    <i class="bi bi-cash-stack me-2 fs-5"></i>
                    <span>Bulletins de paie</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center px-3 py-2" href="/payroll/employee-applied-rules">
                    <i class="bi bi-list-check me-2 fs-5"></i>
                    <span>Règles appliqués</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center px-3 py-2" href="/advances">
                    <i class="bi bi-currency-exchange me-2 fs-5"></i>

                    <span>Avances</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center px-3 py-2" href="/payrollRules">
                    <i class="bi bi-gear me-2 fs-5"></i>
                    <span>Règles de paie</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center px-3 py-2" href="/recovery-dashboard">
                    <i class="bi bi-arrow-repeat me-2 fs-5"></i>
                    <span>Récupération</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center px-3 py-2" href="/admin/settings" ActiveClass="active">
                    <i class="bi bi-building me-2 fs-5"></i>
                    <span>Paramètres</span>
                </NavLink>
            </div>


           
            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center px-3 py-2" href="/job-titles">
                    <i class="bi bi-briefcase me-2 fs-5"></i>
                    <span>Postes</span>
                </NavLink>
            </div>

            <hr class="mx-3 my-2" />

            <div class="nav-item px-3">
                <NavLink class="nav-link d-flex align-items-center px-3 py-2" href="/Account/register">
                    <i class="bi bi-person-plus me-2 fs-5"></i>
                    <span>Inscription</span>
                </NavLink>
            </div>

            <div class="nav-item px-3 mb-3" id="Logout">
                <form action="/Account/Logout" method="post" class="m-0">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                    <button type="submit"
                            class="nav-link d-flex align-items-center px-3 py-2 bg-transparent border-0 w-100 text-start">
                        <i class="bi bi-box-arrow-right me-2 fs-5"></i>
                        <span>Déconnexion</span>
                    </button>
                </form>
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="nav-item px-3 mb-3 mt-4">
                <NavLink class="nav-link d-flex align-items-center px-3 py-2" href="/Account/Login">
                    <i class="bi bi-box-arrow-in-right me-2 fs-5"></i>
                    <span>Connexion</span>
                </NavLink>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
