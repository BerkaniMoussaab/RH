@implements IDisposable
@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">RH</a>
    </div>
</div>

<input type="checkbox" title="Menu de navigation" class="navbar-toggler" />

@inject NavigationManager NavigationManager

<div class="d-flex flex-column bg-dark vh-100 text-white" style="width: 250px;">

    <!-- Liens de la barre latérale -->
    <div class="mt-3">
        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center px-3 py-2 text-white" href="/">
                <i class="bi bi-house me-2 fs-5"></i>
                <span>Tableau de bord</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center px-3 py-2 text-white" href="/employees">
                <i class="bi bi-people me-2 fs-5"></i>
                <span>Employés</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center px-3 py-2 text-white" href="/leaves">
                <i class="bi bi-calendar-check me-2 fs-5"></i>
                <span>Demandes de congé</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center px-3 py-2 text-white" href="/payrolls">
                <i class="bi bi-cash-stack me-2 fs-5"></i>
                <span>Bulletins de paie</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center px-3 py-2 text-white" href="/payrollRules">
                <i class="bi bi-briefcase me-2 fs-5"></i>
                <span>Règles de paie</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center px-3 py-2 text-white" href="/job-titles">
                <i class="bi bi-briefcase me-2 fs-5"></i>
                <span>Postes</span>
            </NavLink>
        </div>

        <hr class="text-secondary mx-3" />

        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center px-3 py-2 text-white" href="/auth">
                <i class="bi bi-shield-lock me-2 fs-5"></i>
                <span>Authentification requise</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex align-items-center px-3 py-2 text-white" href="/register">
                <i class="bi bi-person-plus me-2 fs-5"></i>
                <span>Inscription</span>
            </NavLink>
        </div>

        <div class="nav-item px-3 mb-3">
            <NavLink class="nav-link d-flex align-items-center px-3 py-2 text-white" href="/login">
                <i class="bi bi-box-arrow-in-right me-2 fs-5"></i>
                <span>Connexion</span>
            </NavLink>
        </div>
    </div>
</div>



@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
